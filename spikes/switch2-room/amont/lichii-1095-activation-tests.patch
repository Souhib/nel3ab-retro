+TEST_CASE("Inline state write releases front ownership before replay", "[video_core][state_write]") {
+    Fixture f;
+    using Control = Maxwell3D::Regs::ShadowRamControl;
+    VideoCommon::GpuSplit split;
+    VideoCommon::GpuSplitTestAccess::Initialize(split, f.system);
+    auto& engine = f.fast;
+    constexpr u32 method = 0x200;
+    REQUIRE_FALSE(engine.execution_mask[method]);
+    engine.FrontCallMethod(f.system, split, ShadowControl, static_cast<u32>(Control::Track), true);
+    engine.FrontCallMethod(f.system, split, method, 0x1234, true);
+    REQUIRE(engine.shadow_state.reg_array[method] != 0x1234);
+    engine.FrontCallMethod(f.system, split, ShadowControl, static_cast<u32>(Control::Replay), true);
+    // This ordinary state write, not an executable method, must first hand ownership back.
+    engine.CallMethod(f.system, method, 0x5678, true);
+    REQUIRE(engine.regs.reg_array[method] == 0x1234);
+    REQUIRE(engine.shadow_state.reg_array[method] == 0x1234);
+    REQUIRE(engine.shadow_state.shadow_ram_control == Control::Replay);
+}
