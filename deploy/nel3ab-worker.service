# One session worker, run as a service rather than from a terminal.
#
# It was run from a shell first, and kept dying after about four minutes: the
# shell that started it went away, and Dolphin's container — a child of that
# process tree — went with it. A worker that outlives nothing is not a worker,
# so this is the right shape rather than a convenience.
#
# `Restart=always` matters for a second reason: the worker exits when
# the emulator stops producing frames, which is what happens if Dolphin crashes
# or is killed. Restarting is the correct answer to that, and it is one line.
#
# A SYSTEM unit rather than a user one, for one concrete reason: user units
# cannot be given supplementary groups, and this needs `render` to reach the GPU
# and `docker` to start the emulator. `User=souhib` picks up both.
#
#   sudo cp deploy/nel3ab-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nel3ab-worker
#   journalctl -u nel3ab-worker -f
#
# This room is enabled at boot. Dolphin uses the last remembered game; the
# NEL3AB_ROM value below is the fallback when no remembered choice is available.
# A game-closed marker keeps the room online without Dolphin until an explicit
# launch from the menu. Restarting this unit preserves that idle choice (D18).

[Unit]
Description=nel3ab session worker (one emulator, two video formats)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=souhib
WorkingDirectory=/home/souhib/nel3ab-retro/core
ExecStart=/home/souhib/nel3ab-retro/core/target/release/nel3ab-worker
Environment=HOME=/home/souhib
Environment=RUST_LOG=info
Restart=always
RestartSec=2
# Only the worker receives SIGTERM first. It wakes and stops Dolphin before
# exiting, including when the room is asleep. Switch closes capture before its
# game (40 s maximum) and virtual pads (5 s). Ninety seconds also covers capture
# cleanup and save copies. The isolated normal close took about 2 s on 2026-09-09.
# The final SIGKILL still covers every remaining child if cleanup is stuck.
KillMode=mixed
TimeoutStopSec=90

# Quoted: the games have spaces in their names, which is what a person
# reading a library expects to see.
Environment="NEL3AB_ROM=/home/souhib/roms/gc/Super Smash Bros Melee.rvz"
# Les bibliothèques, séparées par `:` comme un `PATH`. Une console par dossier,
# parce que c'est ainsi que ces collections se rangent, et parce que le conteneur
# monte le dossier du jeu qu'il lance: un dossier de plus ne coûte rien ailleurs.
Environment="NEL3AB_ROM_DIR=/home/souhib/roms/gc:/home/souhib/roms/wii:/home/souhib/roms/switch"
# Private Switch configuration contains local engine, template and save paths.
# No keys or firmware are stored in this unit or in the repository.
Environment=NEL3AB_SWITCH_CONFIG=/home/souhib/.config/nel3ab/switch.json
# Le répertoire de session de Dolphin: sa configuration, ses sauvegardes, ses
# tubes nommés.
#
# PAS dans /tmp. La machine le vide à chaque démarrage, donc une carte mémoire
# de Mario Kart y survivait jusqu'au prochain redémarrage et pas plus. Corrigé
# le 18 août 2026, et ce fichier ne l'avait jamais appris: la correction vivait
# sur la machine, le dépôt disait toujours /tmp, et la première réinstallation
# de cette unité l'a défaite en silence. Le 30 août 2026, ça m'a coûté une
# demi-heure à comprendre pourquoi la vibration ne passait plus: le worker
# écoutait un tube dans /tmp pendant que le pilote écrivait dans l'ancien.
Environment=NEL3AB_SESSION_DIR=/home/souhib/.local/state/nel3ab/session
# Four ports are available from startup. This avoids excluding friends from a
# one-port room. A game may see an unused GameCube pad; the worker documents
# this tradeoff in players_from_environment. Wii games use their Wiimote slots.
Environment=NEL3AB_PLAYERS=4
# How many times native the emulator renders: 1 is 640×480, 2 is 1280×960, 3 is
# 1920×1440. Two by default — measured at four times the pixels for one extra
# millisecond of encode and three megabits, with the frame rate untouched. Three
# holds on the server and needs a client that can decode 1440p60.
Environment=NEL3AB_INTERNAL_RES=2

[Install]
WantedBy=multi-user.target
