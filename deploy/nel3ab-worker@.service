# Une salle parmi plusieurs, lancée et arrêtée par le plan de contrôle.
#
# `%i` est le numéro de la salle, celui qui suit l'arobase:
# `systemctl start nel3ab-worker@1` lance la salle 1.
#
# LES PORTS SE LISENT, ILS NE SE CALCULENT PAS. systemd ne sait pas faire
# d'arithmétique, donc le numéro est inséré dans le port: `81%i0` donne 8110
# pour la salle 1 et 8120 pour la salle 2, et `81%i1` donne leur port de
# contrôle. Cela tient de la salle 1 à la salle 9, ce qui laisse de la marge
# devant la limite de deux salles décidée le 12 septembre 2026.
#
# Le port 8100 était celui de l'ancienne salle unique, `nel3ab-worker.service`.
# Cette unité a été supprimée du dépôt et de `/etc/systemd/system` le 13
# septembre 2026: elle n'était ni activée ni active, mais elle restait
# DÉMARRABLE, et comme elle ne fixait ni `NEL3AB_BIND` ni `NEL3AB_CONTAINER`,
# la lancer levait un worker sur les défauts compilés 8100/8101, dans
# `~/.local/state/nel3ab/session`, avec le conteneur `nel3ab-dolphin`. Une salle
# que le proxy ne sert à personne, qui consomme le GPU et partage le verrou
# Switch avec les vraies. Le port 8100 ne sert donc plus à rien, et les deux
# séries ne se croisaient de toute façon jamais.
#
# `Restart=always` AVEC une exception, et pas `on-failure`. La distinction est
# subtile et coûte une salle si on la rate.
#
# Le worker SORT à chaque changement de jeu: il retient le choix, se termine, et
# systemd le relance sur le nouveau jeu. C'est le mécanisme normal depuis le
# début. Avec `on-failure`, ces sorties-là ne seraient pas relevées et la salle
# disparaîtrait dès que quelqu'un change de jeu.
#
# Il faut donc distinguer les deux sorties par leur CODE, pas par leur nature:
# 42 veut dire « la salle se ferme, ne me relance pas », et c'est le code que le
# worker rend quand plus personne n'a joué depuis une demi-heure. Tout le reste,
# y compris un changement de jeu et un plantage, est relevé comme avant.
#
#   sudo cp deploy/nel3ab-worker@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   systemctl start nel3ab-worker@1
#
# Pas de `[Install]`: une salle ne démarre pas au boot. Elle est ouverte par
# quelqu'un depuis le salon, et une salle que personne n'a demandée serait
# exactement la dépense que ce chantier supprime.

[Unit]
Description=nel3ab salle %i (un émulateur, deux formats vidéo)
After=network-online.target docker.service
Wants=network-online.target
# Pas de débridage du GPU ici, et c'est une MESURE, pas un oubli. Le
# 16 septembre 2026, quatre phases alternées de trois minutes sur une vraie
# partie: neuf coupures d'image d'environ 1,17 s en `profile_peak`, zéro en
# `auto`, deux fois de suite, pour 100 W contre 24. Voir le carnet,
# « Le débridage du GPU fabriquait les gels ».

[Service]
User=souhib
WorkingDirectory=/home/souhib/nel3ab-retro/core
ExecStart=/home/souhib/nel3ab-retro/core/target/release/nel3ab-worker
Environment=HOME=/home/souhib
Environment=RUST_LOG=info
Restart=always
RestartSec=2
# 42: la salle s'est fermée d'elle-même. Voir le commentaire en tête.
RestartPreventExitStatus=42
# Voir l'unité de la salle unique: le worker reçoit SIGTERM seul et ferme
# l'émulateur avant de sortir, capture et sauvegardes comprises.
KillMode=mixed
TimeoutStopSec=90

Environment=NEL3AB_BIND=127.0.0.1:81%i0
Environment=NEL3AB_CONTROL_BIND=127.0.0.1:81%i1
# Un dossier de session PAR SALLE. Deux salles qui partageraient celui-ci
# écraseraient leurs sauvegardes l'une l'autre; le worker refuse d'ailleurs de
# démarrer sur un dossier déjà tenu, depuis le 12 septembre 2026.
Environment=NEL3AB_SESSION_DIR=/home/souhib/.local/state/nel3ab/salles/%i
# Un conteneur Dolphin par salle, pour la même raison: le nom par défaut est le
# même pour tout le monde, et la deuxième salle gèlerait la première.
Environment=NEL3AB_CONTAINER=nel3ab-dolphin-%i
Environment="NEL3AB_ROM=/home/souhib/roms/gc/Super Smash Bros Melee.rvz"
Environment="NEL3AB_ROM_DIR=/home/souhib/roms/gc:/home/souhib/roms/wii:/home/souhib/roms/switch"
# LA place de la Switch, partagée par TOUTES les salles de la machine.
#
# Une seule salle à la fois peut faire tourner un jeu Switch: Ryubing coûte bien
# plus cher que Dolphin, et trois émulateurs Switch ne tiendraient pas sur une
# seule carte graphique. Le worker prend ce verrou juste avant de lancer le jeu
# et le tient toute la partie; le noyau le relâche si le worker meurt, donc une
# salle qui plante ne condamne pas la Switch pour les autres.
#
# La salle unique porte le MÊME chemin, et ce n'est pas un détail: si elle ne
# participait pas au verrou, elle pourrait lancer une seconde Switch sans le
# savoir, ce qui est exactement ce que la règle empêche.
Environment=NEL3AB_SWITCH_LOCK=/home/souhib/.local/state/nel3ab/switch.lock
Environment=NEL3AB_SWITCH_CONFIG=/home/souhib/.config/nel3ab/switch.json
Environment=NEL3AB_PLAYERS=4
Environment=NEL3AB_INTERNAL_RES=2
