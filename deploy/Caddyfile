# La porte d'entrée TLS de la salle, pour le domaine nel3ab.app.
#
# Pourquoi elle existe. Tailscale sait servir en HTTPS tout seul, sans entretien,
# mais il n'émet de certificat que pour le nom de la machine dans le tailnet.
# Pour un domaine à nous, il faut terminer le TLS soi-même, et c'est tout ce que
# ce fichier fait: le même routage que `tailscale serve`, sous un autre nom.
#
# Le nom `.ts.net` continue de vivre sur son port 8443, servi par tailscaled.
# Deux portes, deux mécanismes, et celle qui ne demande aucun entretien reste en
# place: si le renouvellement du certificat casse ici, la salle reste joignable.

{
	# Pas de port d'administration: rien à joindre, rien à défendre.
	admin off

	# Pas de redirection HTTP, et donc pas de port 80 du tout.
	#
	# `.app` est un domaine préchargé en HSTS: les navigateurs refusent d'y
	# parler en clair, quoi qu'on réponde. Une redirection depuis le port 80 ne
	# servirait donc jamais, et ouvrir un port pour rien est un port de trop.
	auto_https disable_redirects
}

nel3ab.app {
	# Lié aux SEULES adresses de cette machine sur le tailnet.
	#
	# C'est la ligne la plus importante du fichier. Sans elle, Caddy écoute sur
	# toutes les interfaces, donc aussi sur le réseau local et sur ce que la box
	# expose. La salle n'a aucune authentification: elle est privée parce qu'elle
	# n'est joignable que depuis le tailnet, et rien d'autre ne le tient.
	#
	# Les deux adresses viennent de `tailscale ip -4` et `tailscale ip -6`. Elles
	# sont stables tant que la machine reste la même dans le tailnet; si elle est
	# retirée puis rajoutée, elles changent et Caddy refusera de démarrer. Le
	# message le dira, et c'est ici qu'il faut les corriger.
	bind 100.104.234.37 fd7a:115c:a1e0::8901:eabc

	# Le certificat par challenge DNS, et il ne peut pas en être autrement: la
	# machine n'est joignable que depuis le tailnet, donc Let's Encrypt ne peut
	# pas venir frapper à la porte pour un challenge HTTP.
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}

	# La documentation, sous un préfixe. `handle_path` retire le `/docs` avant de
	# chercher le fichier, ce que le site attend: ses liens sont relatifs.
	handle_path /docs/* {
		root * /home/souhib/nel3ab-retro/site
		file_server
	}

	# Le salon: qui est là, quel jeu, quelle manette.
	#
	# Caddy écrit `X-Forwarded-For` avec l'adresse du pair, et c'est ce qui rend
	# l'identité possible sous ce nom de domaine. Le nom `.ts.net` est servi par
	# tailscaled, qui écrit lui-même les en-têtes d'identité; ici c'est Caddy qui
	# sert, et il ne sait rien du tailnet. Le salon redemande donc à tailscaled
	# qui se cache derrière cette adresse.
	#
	# Le passage à ce nom de domaine avait fait tomber l'identité SANS RIEN
	# CASSER DE VISIBLE: la salle marchait, elle avait juste cessé de savoir qui
	# était là, donc plus personne n'était propriétaire et n'importe qui pouvait
	# changer le jeu de tout le monde.
	#
	# Ce que le client mettrait lui-même dans cet en-tête est APPENDU, pas cru:
	# le serveur derrière ne retient que la dernière valeur, celle que Caddy vient
	# d'écrire depuis la connexion qu'il a acceptée. Et Caddy n'accepte de
	# connexion que sur les adresses du tailnet (voir `bind`), donc cette adresse
	# est toujours une adresse du tailnet.
	# Les en-têtes d'IDENTITÉ sont retirés avant de passer derrière.
	#
	# Le commentaire du dessus décrit la porte `.ts.net`, où tailscaled écrit
	# lui-même `Tailscale-User-Login`. Sur CETTE porte, Caddy ne l'écrit pas et
	# ne l'effaçait pas non plus: il relayait tel quel ce que le client mettait.
	# Or le service essaie ces en-têtes AVANT de demander à tailscaled qui est
	# derrière l'adresse, et les croit dès qu'il y en a exactement un. N'importe
	# quel pair du tailnet pouvait donc envoyer l'adresse de l'administrateur et
	# l'être: propriétaire de la salle, et maître de la référence. Trouvé par
	# l'audit du 2026-09-05; vérifié en forgeant l'en-tête, avant et après.
	#
	# Retirés ici, il ne reste que `X-Forwarded-For`, que Caddy écrit lui-même
	# depuis la connexion qu'il a acceptée, et le service redemande à tailscaled.
	handle /api/* {
		reverse_proxy 127.0.0.1:8200 {
			header_up -Tailscale-User-Login
			header_up -Tailscale-User-Name
		}
	}
	handle /socket.io/* {
		reverse_proxy 127.0.0.1:8200 {
			header_up -Tailscale-User-Login
			header_up -Tailscale-User-Name
		}
	}

	# Et tout le reste au worker: la page, l'image, le son, les manettes, le clip.
	#
	# L'en-tête `Host` d'origine est conservé par défaut, et il faut qu'il le
	# reste: le worker refuse une poignée de main WebSocket dont l'`Origin` ne
	# correspond pas au `Host`, et le réécrire ferait tomber le jeu entier.
	handle {
		reverse_proxy 127.0.0.1:8100
	}
}
