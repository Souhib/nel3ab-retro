+TEST_CASE("Reference acquire waits for a real counter callback beyond split consumption",
+          "[buffer_ports][reference_composition][reference_counter]") {
+    PayloadReadback::AcquireSession session{true};
+    auto& f = session.f;
+    REQUIRE(Access::ReadBackReads(*f.buffers.cache, 0x20000) == 2);
+    session.Release(PayloadReadback::Fixture::Address, 0);
+    session.split.Drain();
+    session.Run([&] { f.fences.Complete(); });
+    const u32 before = f.Word();
+    REQUIRE(before == 0);
+    const u32 target = 70;
+    session.Acquire(PayloadReadback::Fixture::Address, target);
+    REQUIRE(session.puller.HasPendingAcquire());
+    REQUIRE(f.rasterizer.release_calls == 1);
+    session.Run([&] { f.Counter(); });
+    const u64 counter_position = session.split.Position();
+    REQUIRE(VideoCommon::ReferenceAcquireTest::Consumed() >= counter_position);
+    session.Run([&] { f.fences.SignalOrdering(); });
+    REQUIRE(f.Word() == before);
+    REQUIRE(f.runtime.counter.frees == 0);
+    REQUIRE(Access::PendingReportStates(*f.buffers.cache) == std::vector<bool>{false});
+    REQUIRE_FALSE(f.buffers.runtime.IsFree(f.fences.last_tick));
+    REQUIRE_FALSE(session.puller.CanResumeAcquire(session.pusher));
+    REQUIRE(f.Word() == before);
+    REQUIRE(f.rasterizer.finishes == 0);
+    session.Run([&] { f.fences.Complete(); });
+    REQUIRE(f.Word() == 73);
+    REQUIRE(Access::PendingReportStates(*f.buffers.cache).empty());
+    REQUIRE(f.rasterizer.finishes == 1);
+    REQUIRE(session.puller.CanResumeAcquire(session.pusher));
+    REQUIRE(session.puller.ResumeAcquire(session.pusher));
+    REQUIRE_FALSE(session.puller.HasPendingAcquire());
+    session.Run([&] { f.Retire(1, 1); });
+    REQUIRE(VideoCore::g_read_downloads == 0);
+}
