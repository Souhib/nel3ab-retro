+TEST_CASE("Immediate query finishes a pending early copy before reading a mirror's guest word",
+          "[buffer_ports][query_readback][query_readback_finish]") {
+    const auto mirror = GENERATE(false, true);
+    const auto wide = GENERATE(false, true);
+    PayloadReadback::Fixture f;
+    Tegra::Nx2ClearSemaphoreRegions();
+    SCOPE_EXIT { Tegra::Nx2ClearSemaphoreRegions(); };
+    Tegra::Nx2AddSemaphoreRegion(0x200000);
+    using PayloadReadback::QueryPropertiesFlags;
+    using PayloadReadback::QueryType;
+    f.queries.CounterReport(PayloadReadback::Fixture::Address, QueryType::Payload,
+                            QueryPropertiesFlags::IsAFence, 100, 0);
+    REQUIRE(f.Word() == 100);
+    auto& shadow = Tegra::Nx2MirrorShadow::Get();
+    REQUIRE(shadow.Diverts(PayloadReadback::Fixture::Device));
+    f.Draw();
+    f.buffers.cache->NoteWorkRecorded(true);
+    REQUIRE(Access::ReadDownloads(*f.buffers.cache) == 1);
+    REQUIRE(VideoCore::ReadDownloadsMayCover(PayloadReadback::Fixture::Device, wide ? 16 : 4));
+    REQUIRE_FALSE(f.buffers.runtime.IsFree(f.buffers.runtime.submitted_tick));
+    const u32 waits = f.buffers.runtime.host_read_waits;
+    QueryPropertiesFlags flags = QueryPropertiesFlags::IsAFence;
+    if (mirror) flags |= QueryPropertiesFlags::Nx2Mirror;
+    if (wide) flags |= QueryPropertiesFlags::HasTimeout;
+    f.queries.CounterReport(PayloadReadback::Fixture::Address, QueryType::Payload, flags, 5, 0);
+    REQUIRE(f.rasterizer.read_finishes == 1);
+    REQUIRE(f.buffers.runtime.host_read_waits == waits + 1);
+    REQUIRE(Access::ReadDownloads(*f.buffers.cache) == 0);
+    REQUIRE(f.runtime.payload->frees == 2);
+    REQUIRE(f.rasterizer.notes.empty());
+    REQUIRE(f.rasterizer.finishes == 0);
+    if (mirror) {
+        REQUIRE(f.Word() == 0x03030303);
+        REQUIRE(shadow.Read(PayloadReadback::Fixture::Device, f.Word()) == 5);
+    } else {
+        REQUIRE(f.Word() == 5);
+        REQUIRE_FALSE(shadow.Read(PayloadReadback::Fixture::Device, f.Word()).has_value());
+    }
+    u64 timestamp;
+    std::memcpy(&timestamp, f.buffers.bytes + 0x10048, sizeof(timestamp));
+    if (!mirror && wide) {
+        REQUIRE(timestamp != 0x0303030303030303ULL);
+    } else {
+        REQUIRE(timestamp == 0x0303030303030303ULL);
+    }
+    f.Retire(0, 2);
+    REQUIRE(VideoCore::g_read_downloads == 0);
+}
