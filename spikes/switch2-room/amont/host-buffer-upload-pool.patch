 StagingBufferRef BufferCacheRuntime::UploadStagingBuffer(size_t size) {
+    static const bool host_upload = [] {
+        const char* value = std::getenv("EDEN_NX2_HOST_BUFFER_UPLOAD");
+        return value != nullptr && std::string_view{value} == "1";
+    }();
+    if (host_upload) {
+        // 2026-11-09: mapped buffer uploads account for at least 7.35% of the two
+        // sampled GPU-side CPU threads in Kokiri. Reuse the existing host pool:
+        // its tick retirement is unchanged; the direct uniform ring stays local.
+        static bool reported{};
+        if (!std::exchange(reported, true)) {
+            LOG_INFO(HW_GPU, "Host buffer upload path active: existing pool, size={}", size);
+        }
+        return staging_pool.RequestHostUpload(size);
+    }
     return staging_pool.Request(size, MemoryUsage::Upload);
 }
 
