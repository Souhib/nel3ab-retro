+TEST_CASE("Puller reference acquires read the shadow after the actual split drains",
+          "[video_core][reference_acquire]") {
+    using Access = VideoCommon::GpuSplitTestAccess;
+    using Tegra::Engines::Puller;
+    const char* policy = std::getenv("EDEN_NX2_REFERENCE_ACQUIRE");
+    const bool reference = policy && policy[0] == '1' && policy[1] == '\0';
+    INFO("Process policy: " << (reference ? "Reference" : "legacy Fast"));
+    Fixture f;
+    f.system.Initialize();
+    Kernel::KProcess process{f.system.Kernel()};
+    SCOPE_EXIT { f.system.Kernel().UnregisterKernelObject(&process); };
+    auto& table = process.GetPageTable().GetImpl();
+    table.Resize(20, 12);
+    constexpr VAddr cpu_address = 0x4000;
+    constexpr DAddr device_address = 0x10000;
+    constexpr GPUVAddr address = 0x100000;
+    constexpr GPUVAddr alias = 0x200000;
+    auto* backing = f.physical.GetPointerFromRaw<u8>(0x10000);
+    table.entries.GetAndFault(cpu_address >> 12)
+        .Store(false, Common::PageType::Memory, 1,
+               reinterpret_cast<uintptr_t>(backing) - cpu_address);
+    process.GetMemory().SetCurrentPageTable(process);
+    const auto asid = f.device_memory.RegisterProcess(&process.GetMemory());
+    f.device_memory.BindInterface(&f.rasterizer);
+    f.device_memory.Map(device_address, cpu_address, 0x1000, asid);
+    SCOPE_EXIT {
+        f.device_memory.Unmap(device_address, 0x1000);
+        f.device_memory.UnregisterProcess(asid);
+    };
+    f.memory.BindRasterizer(&f.rasterizer);
+    f.memory.Map(address, device_address, 0x1000, Tegra::PTEKind::PITCH, false);
+    f.memory.Map(alias, device_address, 0x1000, Tegra::PTEKind::PITCH, false);
+    std::memset(backing, 0, 0x1000);
+    const bool old_nx2 = Tegra::g_nx2_ampere.exchange(true);
+    const auto old_accuracy = Settings::values.current_gpu_accuracy;
+    const auto old_fences = Settings::values.gpu_fence_behavior.GetValue();
+    Settings::values.current_gpu_accuracy = Settings::GpuAccuracy::Low;
+    Settings::values.gpu_fence_behavior.SetValue(Settings::GpuFenceBehavior::Default);
+    SCOPE_EXIT {
+        Tegra::g_nx2_ampere = old_nx2;
+        Settings::values.current_gpu_accuracy = old_accuracy;
+        Settings::values.gpu_fence_behavior.SetValue(old_fences);
+    };
+    Tegra::Control::ChannelState channel{0};
+    Tegra::DmaPusher pusher{f.system, f.memory, channel};
+    pusher.BindRasterizer(&f.rasterizer);
+    Puller puller;
+    auto& shadow = Tegra::Nx2MirrorShadow::Get();
+    REQUIRE_FALSE(shadow.Read(device_address, 0).has_value());
+    SCOPE_EXIT {
+        Tegra::Nx2SemaphoreWaiters::Get().Remove(&puller);
+        // Remove only this fixture's shadow; no unrelated global state is cleared.
+        shadow.Set(device_address, 0, 0);
+        (void)shadow.Read(device_address, 1);
+    };
+    auto& split = VideoCommon::GpuSplit::Get();
+    REQUIRE_FALSE(split.Active());
+    Access::Start(split, f.system);
+    Access::FrontMacros(split, true);
+    SCOPE_EXIT { split.Stop(); };
+    REQUIRE(split.Active());
+    REQUIRE(split.FrontMacros());
+    REQUIRE(Tegra::g_nx2_ampere.load());
+    REQUIRE_FALSE(Settings::IsGPULevelHigh());
+    REQUIRE(Settings::IsGPUFenceBehaviorDefault());
+    REQUIRE_FALSE(Tegra::Nx2MayBeGpuWritten(device_address, sizeof(u32)));
+    REQUIRE(f.memory.GpuToCpuAddress(address) == device_address);
+    REQUIRE(f.memory.GpuToCpuAddress(alias) == device_address);
+    const auto word = [&](u32 value) { std::memcpy(backing, &value, sizeof(value)); };
+    const auto acquire = [&](GPUVAddr where, u32 target, u32 operation = 4) {
+        puller.CallPullerMethod(pusher, Puller::MethodCall{4, static_cast<u32>(where >> 32)});
+        puller.CallPullerMethod(pusher, Puller::MethodCall{5, static_cast<u32>(where)});
+        puller.CallPullerMethod(pusher, Puller::MethodCall{6, target});
+        puller.CallPullerMethod(pusher, Puller::MethodCall{7, operation});
+    };
+    SECTION("initial acquire cannot pass raw100 over shadow5") {
+        word(100);
+        shadow.Set(device_address, 5, 100);
+        REQUIRE(shadow.Read(device_address, 100) == 5);
+        acquire(address, 10);
+        REQUIRE(puller.HasPendingAcquire() == reference);
+    }
+    SECTION("resume cannot pass raw100 until the shadow reaches20") {
+        word(0);
+        acquire(address, 10);
+        REQUIRE(puller.HasPendingAcquire());
+        word(100);
+        shadow.Set(device_address, 5, 100);
+        REQUIRE(puller.CanResumeAcquire(pusher) == !reference);
+        shadow.Set(device_address, 20, 100);
+        REQUIRE(puller.ResumeAcquire(pusher));
+        REQUIRE_FALSE(puller.HasPendingAcquire());
+    }
+    SECTION("a GPU virtual alias sees the same shadow") {
+        word(100);
+        shadow.Set(device_address, 5, 100);
+        acquire(alias, 10);
+        REQUIRE(puller.HasPendingAcquire() == reference);
+    }
+    SECTION("an unmirrored satisfied word passes") {
+        word(20);
+        acquire(address, 10);
+        REQUIRE_FALSE(puller.HasPendingAcquire());
+    }
+    SECTION("equality and mask keep their reference semantics") {
+        word(100);
+        shadow.Set(device_address, 5, 100);
+        acquire(address, 10, 1);
+        REQUIRE(puller.HasPendingAcquire());
+        shadow.Set(device_address, 10, 100);
+        REQUIRE(puller.ResumeAcquire(pusher));
+        shadow.Set(device_address, 0, 100);
+        acquire(alias, 4, 8);
+        REQUIRE(puller.HasPendingAcquire());
+        shadow.Set(device_address, 4, 100);
+        REQUIRE(puller.ResumeAcquire(pusher));
+    }
+    SECTION("unknown queued release executes on BackLoop before reference read") {
+        word(0);
+        std::atomic<bool> executed{}, on_back{};
+        split.Defer([&] {
+            on_back.store(VideoCommon::GpuSplit::OwnsScheduler());
+            shadow.Set(device_address, 20, 0);
+            executed.store(true, std::memory_order_release);
+        });
+        split.NoteSemaphoreWrite(device_address, 0, false);
+        REQUIRE(split.QueuedSemaphoreWriteAt(device_address).has_value());
+        acquire(alias, 10);
+        REQUIRE(executed.load(std::memory_order_acquire));
+        REQUIRE(on_back.load());
+        REQUIRE_FALSE(puller.HasPendingAcquire());
+    }
+    split.Drain();
+    split.Stop();
+    REQUIRE_FALSE(split.Active());
+}
