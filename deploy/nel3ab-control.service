# The control plane: who is here, which game, which pad. Never a frame (ADR D12).
#
#   sudo cp deploy/nel3ab-control.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start nel3ab-control     # `enable` too, to survive a reboot
#   journalctl -u nel3ab-control -f
#
# It must be reachable at the SAME origin as the worker, because the worker
# refuses a WebSocket whose `Origin` is not its own `Host`, and because the page
# talks to both. One hostname, two backends, split on the path:
#
#   tailscale serve --bg --https 8443 --set-path /api      http://127.0.0.1:8200/api
#   tailscale serve --bg --https 8443 --set-path /socket.io http://127.0.0.1:8200/socket.io
#   tailscale serve --bg --https 8443 /                     http://127.0.0.1:8100
#
# Restarting this does not interrupt a game: the page keeps its picture, its
# sound and its pad, and loses only the names beside the seats until it comes
# back. That is the whole point of keeping it out of the media path.

[Unit]
Description=nel3ab control plane (rooms, names, seats)
After=network-online.target
Wants=network-online.target

[Service]
User=souhib
WorkingDirectory=/home/souhib/nel3ab-retro/control
# `--forwarded-allow-ips` dit à uvicorn de QUI il a le droit de croire
# `X-Forwarded-For`, et c'est la seule chose qui sépare « le proxy dit qui tu
# es » de « tu dis qui tu es ». C'est la valeur par défaut d'uvicorn, écrite ici
# parce qu'une règle d'identité qui repose sur un défaut implicite est une règle
# qui change le jour d'une mise à jour, sans que personne ne le lise.
ExecStart=/home/souhib/.local/bin/uv run uvicorn nel3ab_control.app:app --host 127.0.0.1 --port 8200 --forwarded-allow-ips 127.0.0.1
Environment=HOME=/home/souhib
# Un arrêt demandé n'est pas une panne.
#
# `SIGTERM` est ce que systemd envoie pour arrêter, et le programme sort alors
# en 143. Sans cette ligne, chaque `systemctl restart` laisse
# « Failed with result 'exit-code' » dans le journal: rien n'est cassé, mais une
# vraie panne y ressemble trait pour trait, et c'est le genre de bruit qui fait
# rater celle qui compte. Repéré le 29 août 2026 en cherchant pourquoi le salon
# avait « planté » le 26; il avait simplement redémarré.
SuccessExitStatus=143 SIGTERM
Restart=always
RestartSec=2

# L'identité vient du proxy, qui écrit `Tailscale-User-Login` sur chaque requête
# ET sur chaque montée en grade de WebSocket. Ça n'est une PREUVE que parce que
# ce service n'écoute que sur la boucle locale: un service joignable autrement
# accepterait l'en-tête de n'importe qui. Ne pas changer `--host` sans lire ça.
#
# Where the worker is, and what to call the room.
Environment=NEL3AB_WORKER_URL=http://127.0.0.1:8100
Environment=NEL3AB_ROOM_NAME=lgf
# La seule adresse qui peut publier la configuration de référence de la salle.
#
# Ici et pas dans la salle, délibérément. La salle a déjà un propriétaire, et il
# ne convient pas: il change quand quelqu'un part, et depuis le 31 août 2026 il
# se donne tout seul quand celui qui le tient s'absente trois minutes. Une
# référence à laquelle on veut pouvoir revenir QUOI QU'IL ARRIVE ne peut pas
# dépendre d'un titre qui tourne.
#
# Vide veut dire personne, et c'est le défaut: une salle déployée ailleurs n'a
# pas de référence et se comporte comme avant.
Environment=NEL3AB_ADMIN=souhib.t@hotmail.fr
# Nothing about pads here on purpose: the worker reports how many the room has,
# in `/roms`, because it is what tells Dolphin which ports hold a controller.
# This file used to carry a second copy of that number, which had to agree with
# the worker and had nothing making it.

[Install]
WantedBy=multi-user.target
