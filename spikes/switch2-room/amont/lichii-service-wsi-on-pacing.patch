+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <optional>
+
+namespace VideoCommon {
+constexpr bool WsiPresentStatsSwitch(const char* value) {
+    return value && value[0] == '1' && value[1] == '\0';
+}
+inline const bool g_wsi_present_stats =
+    WsiPresentStatsSwitch(std::getenv("EDEN_NX2_WSI_PRESENT_STATS"));
+
+class WsiPresentStats {
+public:
+    enum class Result { AcceptedSuccess, Suboptimal, Rejected };
+    using Clock = std::chrono::steady_clock;
+    // Match the VI2 interval window. The sample array alone occupies 4800 bytes.
+    static constexpr std::size_t Capacity = 600;
+    struct Window {
+        std::uint64_t count{}, sum_ns{}, begin_ns{}, end_ns{};
+        std::uint64_t p50_ns{}, p95_ns{}, p99_ns{}, max_ns{}, over30{}, over100{};
+        std::uint64_t generation{}, segment{}, success{}, suboptimal{}, rejected{};
+    };
+    void Recreated() {
+        ++generation;
+        BreakSegment();
+    }
+    void AbandonWindow() {
+        BreakSegment();
+    }
+    bool Record(Result result, Clock::time_point returned) {
+        if (result == Result::Rejected) {
+            ++rejected;
+            BreakSegment();
+            return false;
+        }
+        if (result == Result::AcceptedSuccess) {
+            ++success;
+        } else {
+            ++suboptimal;
+        }
+        const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                            returned.time_since_epoch()).count();
+        if (last && ns < *last) {
+            BreakSegment();
+        }
+        if (!last) {
+            last = ns;
+            begin = ns;
+            return false;
+        }
+        if (count == Capacity) {
+            return true;
+        }
+        const auto interval = static_cast<std::uint64_t>(ns - *last);
+        last = ns;
+        samples[count++] = interval;
+        sum += interval;
+        maximum = std::max(maximum, interval);
+        // For integer nanoseconds, > floor(1e9/30) exactly means > 1 second / 30.
+        over30 += interval > 33'333'333;
+        over100 += interval > 100'000'000;
+        return count == Capacity;
+    }
+    std::optional<Window> TakeWindow() {
+        if (count != Capacity || !last) {
+            return std::nullopt;
+        }
+        auto sorted = samples;
+        std::sort(sorted.begin(), sorted.end());
+        const auto rank = [&](std::size_t percent) {
+            return sorted[(percent * count + 99) / 100 - 1];
+        };
+        Window w{count, sum, static_cast<std::uint64_t>(begin),
+                 static_cast<std::uint64_t>(*last), rank(50), rank(95), rank(99),
+                 maximum, over30, over100, generation, segment, success, suboptimal, rejected};
+        ClearWindow();
+        begin = *last;
+        return w;
+    }
+    std::uint64_t generation{}, segment{}, success{}, suboptimal{}, rejected{};
+    bool announced{};
+private:
+    void ClearWindow() {
+        count = 0;
+        sum = maximum = over30 = over100 = 0;
+    }
+    void BreakSegment() {
+        ++segment;
+        ClearWindow();
+        last.reset();
+    }
+    // 4800 bytes allocated once per traced swapchain, never per return. Sorting copies
+    // the array only once per 600 intervals, outside the queue submission mutex.
+    std::array<std::uint64_t, Capacity> samples{};
+    std::optional<std::int64_t> last;
+    std::int64_t begin{};
+    std::size_t count{};
+    std::uint64_t sum{}, maximum{}, over30{}, over100{};
+};
+} // namespace VideoCommon
