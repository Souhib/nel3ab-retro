+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include "video_core/vulkan_common/memory_usage.h"
+#include "video_core/vulkan_common/vma.h"
+
+namespace Vulkan {
+
+enum class UploadMemoryOutcome { Unchanged, CachedCoherent, Incompatible };
+
+struct UploadMemorySelection {
+    VmaAllocationCreateInfo allocation;
+    UploadMemoryOutcome outcome{UploadMemoryOutcome::Unchanged};
+    VkResult result{VK_SUCCESS};
+};
+
+// The query must use the actual buffer create info and these allocation restrictions.
+// VMA's sequential-write preference penalizes HOST_CACHED even with AUTO_PREFER_HOST;
+// requiring both flags prevents preference scoring from choosing uncached memory.
+// Only absence of a compatible type permits fallback. Other query errors remain errors.
+template <typename FindMemoryType>
+UploadMemorySelection SelectUploadMemory(VkDriverId driver, MemoryUsage usage,
+                                        const VmaAllocationCreateInfo& legacy,
+                                        FindMemoryType&& find_memory_type) {
+    UploadMemorySelection selection{legacy};
+    if (driver != VK_DRIVER_ID_MESA_RADV ||
+        (usage != MemoryUsage::Stream && usage != MemoryUsage::Upload)) {
+        return selection;
+    }
+    auto proposed = legacy;
+    proposed.usage = VMA_MEMORY_USAGE_AUTO_PREFER_HOST;
+    proposed.requiredFlags |= VK_MEMORY_PROPERTY_HOST_CACHED_BIT |
+                              VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+    const VkResult result = find_memory_type(proposed);
+    if (result == VK_SUCCESS) {
+        selection.allocation = proposed;
+        selection.outcome = UploadMemoryOutcome::CachedCoherent;
+    } else if (result == VK_ERROR_FEATURE_NOT_PRESENT) {
+        selection.outcome = UploadMemoryOutcome::Incompatible;
+    } else {
+        selection.result = result;
+    }
+    return selection;
+}
+
+} // namespace Vulkan
