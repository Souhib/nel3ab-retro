+/// Uniform keeps: binds the slot's last allocation again when the same range in this command
+/// buffer still contains its uploaded bytes. Already CPU-dirty pages can change without another
+/// cache notification, so the delta's write history alone cannot establish this. Returns false
+/// (nothing bound) otherwise, leaving the normal stream path to read and upload the current bytes.
+template <class Runtime, class DeviceMemory>
+[[nodiscard]] bool RebindKeptUniform(Runtime& runtime, DeviceMemory& device_memory, size_t stage,
+                                     u32 index, u64 device_addr, u32 size) {
     using Reuse = UniformStreamReuse<typename Runtime::StreamUniformRef>;
     if (size == 0 || size > Reuse::MaxBytes || stage >= Reuse::NumStages ||
         index >= Reuse::NumSlots) {
         return false;
     }
-    const typename Reuse::Slot& slot =
-        UniformStreamReuseState<typename Runtime::StreamUniformRef>().slots[stage][index];
+    Reuse& reuse = UniformStreamReuseState<typename Runtime::StreamUniformRef>();
+    const typename Reuse::Slot& slot = reuse.slots[stage][index];
     if (slot.size != size || slot.device_addr != device_addr ||
         slot.tick != runtime.CurrentTick()) {
         return false;
     }
+    device_memory.ReadBlockUnsafe(device_addr, reuse.scratch.data(), size);
+    if (std::memcmp(slot.bytes.data(), reuse.scratch.data(), size) != 0) {
+        return false;
+    }
     runtime.RebindStreamUniform(slot.ref, size);
     return true;
 }
