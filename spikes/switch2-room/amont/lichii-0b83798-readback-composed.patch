+TEST_CASE("Readback tracking ends when a delayed query is invalidated or unsynchronized",
+          "[buffer_ports][query_readback][query_readback_scope]") {
+    const auto invalidated = GENERATE(false, true);
+    PayloadReadback::Fixture f;
+    const u32 before = f.Word();
+    f.Counter();
+    REQUIRE(Access::PendingReportStates(*f.buffers.cache) == std::vector<bool>{false});
+    if (invalidated) {
+        f.queries.InvalidateRegion(PayloadReadback::Fixture::Device, 4);
+        REQUIRE(True(f.runtime.counter.queries.front().flags &
+                     VideoCommon::QueryFlagBits::IsInvalidated));
+    } else {
+        f.runtime.counter.queries.front().flags &= ~VideoCommon::QueryFlagBits::IsFinalValueSynced;
+        REQUIRE_FALSE(True(f.runtime.counter.queries.front().flags &
+                           VideoCommon::QueryFlagBits::IsFinalValueSynced));
+    }
+    f.fences.Complete();
+    REQUIRE(f.Word() == before);
+    REQUIRE(Access::PendingReportStates(*f.buffers.cache).empty());
+    REQUIRE(f.rasterizer.finishes == 1);
+    f.Retire(1, 0);
+}
