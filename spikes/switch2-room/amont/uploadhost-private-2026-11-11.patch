+UploadMemorySelection MemoryAllocator::SelectBufferMemory(
+    const VkBufferCreateInfo& ci, MemoryUsage usage,
+    const VmaAllocationCreateInfo& legacy) const {
+    auto selection = SelectUploadMemory(device.GetDriverID(), usage, legacy,
+                                        [&](const VmaAllocationCreateInfo& proposed) {
+        u32 memory_type{};
+        return vmaFindMemoryTypeIndexForBufferInfo(allocator, &ci, &proposed, &memory_type);
+    });
+    vk::Check(selection.result);
+    return selection;
+}
+
+void MemoryAllocator::NoteUploadMemory(MemoryUsage usage,
+                                       const UploadMemorySelection& selection,
+                                       const VmaAllocationInfo& info,
+                                       VkMemoryPropertyFlags flags) const {
+    if (selection.outcome == UploadMemoryOutcome::Unchanged) {
+        return;
+    }
+    const bool applied = selection.outcome == UploadMemoryOutcome::CachedCoherent;
+    const size_t index = usage == MemoryUsage::Stream ? 0 : 1;
+    const u64 bit = u64{1} << (info.memoryType + (applied ? 0 : 32));
+    if ((upload_memory_observed[index].fetch_or(bit, std::memory_order_relaxed) & bit) != 0) {
+        return;
+    }
+    // A successful allocation, not an environment flag, proves normal activation.
+    // At most one line per usage/type/outcome per allocator, never per copy or frame.
+    LOG_INFO(Render_Vulkan, "Nx2UploadHost usage={} policy={}",
+             usage == MemoryUsage::Stream ? "Stream" : "Upload",
+             applied ? "cached-coherent" : "legacy-no-compatible-type");
+    if (upload_memory_trace) {
+        LOG_INFO(Render_Vulkan,
+                 "Nx2UploadHostMemory usage={} policy={} type={} flags={:#x} "
+                 "memory={:#x} offset={} allocation_bytes={} mapped={}",
+                 usage == MemoryUsage::Stream ? "Stream" : "Upload",
+                 applied ? "cached-coherent" : "legacy-no-compatible-type",
+                 info.memoryType, flags, reinterpret_cast<uintptr_t>(info.deviceMemory),
+                 info.offset, info.size, info.pMappedData != nullptr);
+    }
+}
