+TEST_CASE("Inline state writes preserve shadow and both dirty tables", "[video_core][state_write]") {
+    Fixture f;
+    using Control = Maxwell3D::Regs::ShadowRamControl;
+    constexpr u32 method = 0x200;
+    REQUIRE_FALSE(f.fast.execution_mask[method]);
+    REQUIRE(f.fast.fast_maxwell3d);
+    f.fast.dirty.tables[0][method] = f.slow.dirty.tables[0][method] = 10;
+    f.fast.dirty.tables[1][method] = f.slow.dirty.tables[1][method] = 11;
+    for (auto control : {Control::Track, Control::TrackWithFilter, Control::Passthrough,
+                         Control::Replay}) {
+        CAPTURE(static_cast<u32>(control));
+        f.Call(ShadowControl, static_cast<u32>(control), true);
+        for (auto* engine : {&f.fast, &f.slow}) {
+            engine->regs.reg_array[method] = 3;
+            engine->shadow_state.reg_array[method] = 7;
+            engine->dirty.flags.reset();
+        }
+        f.Call(method, 5, true);
+        f.Compare();
+        REQUIRE(f.fast.regs.reg_array[method] == (control == Control::Replay ? 7 : 5));
+        REQUIRE(f.fast.shadow_state.reg_array[method] ==
+                (control == Control::Track || control == Control::TrackWithFilter ? 5 : 7));
+        REQUIRE(f.fast.dirty.flags[10]);
+        REQUIRE(f.fast.dirty.flags[11]);
+        f.fast.dirty.flags.reset();
+        f.slow.dirty.flags.reset();
+        f.Call(method, 5, true);
+        f.Compare();
+        const char* skip = std::getenv("EDEN_NX2_SKIP_SAME");
+        const bool skipped = skip == nullptr || skip[0] != '0';
+        REQUIRE(f.fast.dirty.flags[10] == !skipped);
+        REQUIRE(f.fast.dirty.flags[11] == !skipped);
+    }
+}
