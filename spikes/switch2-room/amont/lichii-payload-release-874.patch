+TEST_CASE("Payload retirement covers successful invalidated and unsynchronized reports",
+          "[query_payload][query_retirement]") {
+    const int exit = GENERATE(0, 1, 2);
+    const auto high = GENERATE(false, true);
+    Fixture f;
+    Settings::values.current_gpu_accuracy = high ? GpuAccuracy::High : GpuAccuracy::Low;
+    if (exit == 1) f.runtime.payload.initial_flags = QueryFlagBits::IsInvalidated;
+    if (exit == 2) f.runtime.payload.final_value = false;
+    f.Report();
+    REQUIRE(f.Read<u32>() == (!high && exit == 0 ? 5 : 100));
+    REQUIRE(f.runtime.payload.FreeCount() == (high ? 0 : 1));
+    f.Drain();
+    REQUIRE(f.Read<u32>() == (exit == 0 ? 5 : 100));
+    REQUIRE(f.runtime.payload.FreeCount() == 1);
+    // The next report and cleanup must not accidentally retire the previous immediate query.
+    f.runtime.payload.initial_flags = {};
+    f.runtime.payload.final_value = true;
+    f.Report(QueryType::Payload, QueryPropertiesFlags::IsAFence, 9);
+    f.Drain();
+    REQUIRE(f.Read<u32>() == 9);
+    REQUIRE(f.runtime.payload.FreeCount() == 2);
+}
