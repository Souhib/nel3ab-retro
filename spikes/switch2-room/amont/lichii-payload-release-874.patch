+// Only the host query producer is doubled. QueryCache owns the real report operation and
+// lifetime decisions; the fixture observes mapped memory and rejects every duplicate Free.
+class Streamer final : public VideoCommon::StreamerInterface {
+public:
+    explicit Streamer(QueryType type) : StreamerInterface{static_cast<size_t>(type)} {}
+    VideoCommon::QueryBase* GetQuery(size_t index) override { return &queries.at(index); }
+    size_t WriteCounter(VAddr address, bool timestamp, u32 value,
+                        std::optional<u32> = std::nullopt) override {
+        const size_t index = queries.size();
+        queries.emplace_back(timestamp, address,
+                             GetId() == static_cast<size_t>(QueryType::Payload) ? value : 73);
+        queries.back().flags |= initial_flags;
+        if (!final_value) {
+            queries.back().flags &= ~QueryFlagBits::IsFinalValueSynced;
+        }
+        frees.push_back(0);
+        return index;
+    }
+    void Free(size_t index) override {
+        REQUIRE(index < frees.size());
+        REQUIRE(frees[index] == 0);
+        ++frees[index];
+    }
+    u32 FreeCount() const {
+        u32 sum{};
+        for (auto count : frees) sum += count;
+        return sum;
+    }
+    std::deque<VideoCommon::GuestQuery> queries;
+    std::vector<u32> frees;
+    QueryFlagBits initial_flags{};
+    bool final_value{true};
+};
+
+struct QueryRuntime {
+    Streamer payload{QueryType::Payload};
+    Streamer counter{QueryType::ZPassPixelCount64};
+    VideoCommon::StreamerInterface* GetStreamerInterface(QueryType type) {
+        switch (type) {
+        case QueryType::Payload: return &payload;
+        case QueryType::ZPassPixelCount64: return &counter;
+        default: return nullptr;
+        }
+    }
+    void Bind3DEngine(Tegra::Engines::Maxwell3D*) {}
+    void Barriers(bool) {}
+};
+struct QueryTraits { using RuntimeType = QueryRuntime; };
+class QueryCache final : public VideoCommon::QueryCacheBase<QueryTraits> {
+public:
+    using QueryCacheBase::QueryCacheBase;
+    void SetMemory(Tegra::MemoryManager& memory) { gpu_memory = &memory; }
+};
+
+// A pending backend operation is not completed by SubmitDeferredWork. This keeps delayed
+// reports pending deterministically, without a GPU or a background thread.
+struct FlushCache {
+    std::mutex mutex;
+    bool flush{};
+    bool HasUncommittedFlushes() const { return flush; }
+    bool HasAsyncFlushWork() const { return flush; }
+    bool ShouldWaitAsyncFlushes() const { return true; }
+    void AccumulateFlushes() {}
+    void CommitAsyncFlushes() {}
+    void PopAsyncFlushes() {}
+};
+struct Fence : VideoCommon::FenceBase {
+    Fence(bool stubbed, u64 tick_) : FenceBase{stubbed}, tick{tick_} {}
+    u64 tick;
+};
+struct FenceTraits {
+    using FenceType = std::shared_ptr<Fence>;
+    using TextureCacheType = FlushCache;
+    using BufferCacheType = FlushCache;
+    using QueryCacheType = QueryCache;
+    static constexpr bool HAS_ASYNC_CHECK = false;
+};
+class FenceManager final : public VideoCommon::FenceManager<FenceTraits> {
+public:
+    FenceManager(QueryRasterizer& rasterizer, Tegra::GPU& gpu, FlushCache& texture,
+                 FlushCache& buffer, QueryCache& query)
+        : VideoCommon::FenceManager<FenceTraits>{rasterizer, gpu, texture, buffer, query} {}
+    ~FenceManager() override = default;
+    u64 queued{}, completed{};
+    u32 submissions{};
+    void Complete() {
+        completed = queued;
+        WaitPendingFences(false);
+    }
+protected:
+    std::shared_ptr<Fence> CreateFence(bool stubbed) override {
+        return std::make_shared<Fence>(stubbed, queued + 1);
+    }
+    void QueueFence(std::shared_ptr<Fence>& fence) override { queued = fence->tick; }
+    bool IsFenceSignaled(std::shared_ptr<Fence>& fence) const override {
+        return completed >= fence->tick;
+    }
+    void WaitFence(std::shared_ptr<Fence>& fence) override { REQUIRE(completed >= fence->tick); }
+    void SubmitDeferredWork() override { ++submissions; }
+};
