+TEST_CASE("Uniform span uses direct comparisons and gathers noncontiguous pages",
+          "[video_core][uniform_span]") {
+    Memory memory;
+    Runtime runtime;
+    VideoCommon::ResetUniformStreamReuse<Runtime>();
+    auto bind = [&](u64 address, u32 size) {
+        REQUIRE(VideoCommon::BindSmallUniformReusing(runtime, memory, 0, 0, 0, address, size));
+        CheckBound(runtime, memory, address, size);
+    };
+    bind(32, 64);
+    REQUIRE(memory.in_place == 1);
+    REQUIRE(memory.gathered == 0);
+    bind(32, 64);
+    REQUIRE(memory.in_place == 2);
+    REQUIRE(runtime.allocations.size() == 1);
+    memory.bytes[35] = 9;
+    bind(32, 64);
+    REQUIRE(runtime.allocations.size() == 2);
+    REQUIRE(memory.gathered == 0);
+    const auto direct = memory.in_place;
+    bind(4090, 32);
+    REQUIRE(memory.in_place == direct);
+    REQUIRE(memory.gathered == 1);
+    memory.bytes[4100] = 7;
+    bind(4090, 32);
+    REQUIRE(memory.gathered == 2);
+    REQUIRE(runtime.allocations.size() == 4);
+}
