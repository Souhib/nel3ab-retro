+#include "VideoBackends/Vulkan/VKFrameExport.h"
+
+// <cerrno> for the EAGAIN checks on the non-blocking socket, and CommonTypes for
+// the u32/u64 spellings Dolphin uses everywhere.
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
