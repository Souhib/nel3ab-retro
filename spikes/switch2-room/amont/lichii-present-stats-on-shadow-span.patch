+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <limits>
+#include <optional>
+
+namespace Service {
+
+[[nodiscard]] constexpr bool Nx2PresentStatsSwitch(const char* value) {
+    return value != nullptr && value[0] == '1' && value[1] == '\0';
+}
+
+// Startup-only: never refresh this flag while a presentation session is running.
+inline const bool g_nx2_present_stats = Nx2PresentStatsSwitch(std::getenv("EDEN_NX2_PRESENT_STATS"));
+
+class Nx2PresentIntervals {
+public:
+    static constexpr std::size_t Capacity = 600;
+    struct Distribution {
+        std::uint64_t p50_ns{}, p95_ns{}, p99_ns{};
+    };
+
+    // No clocks or guest operations here. A window contains at most 600 intervals.
+    bool Add(std::chrono::nanoseconds interval, bool capture) {
+        if (interval.count() < 0 || count == Capacity) {
+            return false;
+        }
+        const auto ns = static_cast<std::uint64_t>(interval.count());
+        if (ns > std::numeric_limits<std::uint64_t>::max() - sum_ns) {
+            return false;
+        }
+        ++count;
+        sum_ns += ns;
+        sum_us += ns / 1000;
+        max_ns = std::max(max_ns, ns);
+        // An integer ns duration exceeds exactly 1/30 s iff it exceeds floor(1e9/30).
+        over30 += ns > 33'333'333;
+        over100 += ns > 100'000'000;
+        if (capture) {
+            samples[sample_count++] = ns;
+        }
+        return true;
+    }
+
+    [[nodiscard]] std::optional<std::uint64_t> MeanUs() const {
+        if (count == 0) {
+            return std::nullopt;
+        }
+        return sum_us / count;
+    }
+
+    [[nodiscard]] std::optional<Distribution> Quantiles() const {
+        if (count == 0 || sample_count != count) {
+            return std::nullopt;
+        }
+        auto sorted = samples;
+        std::sort(sorted.begin(), sorted.begin() + sample_count);
+        // Nearest rank: ceil(percent * n / 100), using one-based ranks.
+        const auto at = [&](std::size_t percent) { return sorted[(percent * count + 99) / 100 - 1]; };
+        return Distribution{at(50), at(95), at(99)};
+    }
+
+    void Reset() {
+        count = sample_count = 0;
+        sum_ns = sum_us = max_ns = over30 = over100 = 0;
+    }
+
+    std::size_t count{};
+    std::uint64_t sum_ns{}, sum_us{}, max_ns{}, over30{}, over100{};
+
+private:
+    // 4800 bytes per session, allocated once; Reset does not clear or allocate this storage.
+    // Quantiles copies 4800 bytes on the stack only when the optional window log is emitted.
+    std::array<std::uint64_t, Capacity> samples{};
+    std::size_t sample_count{};
+};
+
+} // namespace Service
