+namespace {
+using namespace Vulkan;
+
+void Check(bool value, const char* reason) {
+    if (!value) {
+        throw std::runtime_error(reason);
+    }
+}
+
+bool SameAllocation(const VmaAllocationCreateInfo& a, const VmaAllocationCreateInfo& b) {
+    return a.flags == b.flags && a.usage == b.usage && a.requiredFlags == b.requiredFlags &&
+           a.preferredFlags == b.preferredFlags && a.memoryTypeBits == b.memoryTypeBits &&
+           a.pool == b.pool && a.pUserData == b.pUserData && a.priority == b.priority;
+}
+
+void RunUploadMemoryPolicyChecks() {
+    int user_data{};
+    const std::array usages{MemoryUsage::Stream, MemoryUsage::Upload,
+                            MemoryUsage::Download, MemoryUsage::DeviceLocal};
+    const std::array drivers{VK_DRIVER_ID_MESA_RADV, VK_DRIVER_ID_AMD_PROPRIETARY,
+                            VK_DRIVER_ID_INTEL_OPEN_SOURCE_MESA, VK_DRIVER_ID_NVIDIA_PROPRIETARY};
+    for (const auto usage : usages) {
+        for (const auto driver : drivers) {
+            const bool applies = driver == VK_DRIVER_ID_MESA_RADV &&
+                                 (usage == MemoryUsage::Stream || usage == MemoryUsage::Upload);
+            for (const auto prior_required : {0u, static_cast<unsigned>(VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)}) {
+            for (const auto bits : {0u, 0x24u}) {
+                VmaAllocationCreateInfo legacy{};
+                legacy.flags = VMA_ALLOCATION_CREATE_WITHIN_BUDGET_BIT |
+                               VMA_ALLOCATION_CREATE_MAPPED_BIT |
+                               VMA_ALLOCATION_CREATE_HOST_ACCESS_SEQUENTIAL_WRITE_BIT;
+                legacy.usage = usage == MemoryUsage::Stream ? VMA_MEMORY_USAGE_AUTO_PREFER_DEVICE :
+                                                             VMA_MEMORY_USAGE_AUTO_PREFER_HOST;
+                // Nonzero sentinel fields prove preservation, including additional requirements.
+                legacy.requiredFlags = prior_required;
+                legacy.preferredFlags = VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+                legacy.memoryTypeBits = bits;
+                legacy.pUserData = &user_data;
+                legacy.priority = 0.25f;
+                for (const VkResult query_result : {VK_SUCCESS, VK_ERROR_FEATURE_NOT_PRESENT,
+                                                    VK_ERROR_OUT_OF_HOST_MEMORY,
+                                                    VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                                                    VK_ERROR_DEVICE_LOST}) {
+                    int queries{};
+                    auto query = [&](const VmaAllocationCreateInfo& proposed) {
+                        ++queries;
+                        Check(applies, "foreign-driver-or-usage-query");
+                        Check(proposed.usage == VMA_MEMORY_USAGE_AUTO_PREFER_HOST,
+                              "host-preference-required");
+                        Check((proposed.requiredFlags & VK_MEMORY_PROPERTY_HOST_CACHED_BIT) != 0,
+                              "cached-required");
+                        Check((proposed.requiredFlags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) != 0,
+                              "coherent-required");
+                        auto expected = legacy;
+                        expected.usage = VMA_MEMORY_USAGE_AUTO_PREFER_HOST;
+                        expected.requiredFlags |= VK_MEMORY_PROPERTY_HOST_CACHED_BIT |
+                                                  VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+                        Check(SameAllocation(proposed, expected), "legacy-fields-preserved-in-query");
+                        // Explicit double of VMA's type lookup, not a Vulkan compatibility proof.
+                        return query_result;
+                    };
+                    const auto selected = SelectUploadMemory(driver, usage, legacy, query);
+                    Check(queries == (applies ? 1 : 0), "eligible-query-count");
+                    if (!applies) {
+                        Check(SameAllocation(selected.allocation, legacy), "other-path-unchanged");
+                        Check(selected.outcome == UploadMemoryOutcome::Unchanged &&
+                              selected.result == VK_SUCCESS, "other-path-status");
+                    } else if (query_result == VK_SUCCESS) {
+                        auto expected = legacy;
+                        expected.usage = VMA_MEMORY_USAGE_AUTO_PREFER_HOST;
+                        expected.requiredFlags |= VK_MEMORY_PROPERTY_HOST_CACHED_BIT |
+                                                  VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+                        Check(SameAllocation(selected.allocation, expected), "selected-policy");
+                        Check(selected.outcome == UploadMemoryOutcome::CachedCoherent &&
+                              selected.result == VK_SUCCESS, "selected-status");
+                    } else if (query_result == VK_ERROR_FEATURE_NOT_PRESENT) {
+                        Check(SameAllocation(selected.allocation, legacy), "incompatible-legacy-exact");
+                        Check(selected.outcome == UploadMemoryOutcome::Incompatible &&
+                              selected.result == VK_SUCCESS, "incompatible-explicit-fallback");
+                    } else {
+                        Check(SameAllocation(selected.allocation, legacy), "error-legacy-exact");
+                        Check(selected.result == query_result, "query-error-not-hidden");
+                        Check(selected.outcome == UploadMemoryOutcome::Unchanged, "error-not-applied");
+                    }
+                }
+            }
+            }
+        }
+    }
+}
+} // namespace
+
+#ifdef UPLOAD_MEMORY_POLICY_STANDALONE
+int main() {
+    try {
+        RunUploadMemoryPolicyChecks();
+        std::cout << "PASS actual SelectUploadMemory: 320 selection cases\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
+#else
+TEST_CASE("RADV upload memory requires cache and coherence only when compatible",
+          "[upload_memory_policy]") {
+    REQUIRE_NOTHROW(RunUploadMemoryPolicyChecks());
+}
+#endif
