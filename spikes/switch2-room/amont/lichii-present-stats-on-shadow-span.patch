@@ -0,0 +1,102 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <catch2/catch_test_macros.hpp>
+#include "core/hle/service/nx2_present_stats.h"
+
+namespace {
+using Service::Nx2PresentIntervals;
+using namespace std::chrono_literals;
+}
+
+TEST_CASE("NX2 present diagnostics accept only exact startup one", "[core][nx2_present_stats]") {
+    REQUIRE(Service::Nx2PresentStatsSwitch("1"));
+    REQUIRE_FALSE(Service::Nx2PresentStatsSwitch(nullptr));
+    REQUIRE_FALSE(Service::Nx2PresentStatsSwitch(""));
+    REQUIRE_FALSE(Service::Nx2PresentStatsSwitch("0"));
+    REQUIRE_FALSE(Service::Nx2PresentStatsSwitch("10"));
+    REQUIRE_FALSE(Service::Nx2PresentStatsSwitch("1x"));
+}
+
+TEST_CASE("NX2 present interval windows count actual samples", "[core][nx2_present_stats]") {
+    Nx2PresentIntervals stats;
+    REQUIRE_FALSE(stats.MeanUs());
+    REQUIRE_FALSE(stats.Quantiles());
+    REQUIRE_FALSE(stats.Add(-1ns, true));
+    REQUIRE(stats.count == 0);
+    REQUIRE(stats.Add(33ms, true));
+    REQUIRE(stats.count == 1);
+    REQUIRE(stats.MeanUs() == 33000);
+    REQUIRE(stats.Quantiles()->p99_ns == 33'000'000);
+    for (int i = 1; i < 599; ++i) {
+        REQUIRE(stats.Add(33ms, true));
+    }
+    REQUIRE(stats.count == 599);
+    REQUIRE(stats.MeanUs() == 33000);
+    REQUIRE(stats.sum_ns == 599ULL * 33'000'000);
+    stats.Reset();
+    REQUIRE_FALSE(stats.MeanUs());
+    REQUIRE_FALSE(stats.Quantiles());
+    for (int i = 0; i < 600; ++i) {
+        REQUIRE(stats.Add(33ms, true));
+    }
+    REQUIRE(stats.count == 600);
+    REQUIRE(stats.MeanUs() == 33000);
+    REQUIRE(stats.sum_ns == 600ULL * 33'000'000);
+    REQUIRE_FALSE(stats.Add(999ms, true));
+    REQUIRE(stats.count == 600);
+    REQUIRE(stats.max_ns == 33'000'000);
+}
+
+TEST_CASE("NX2 present quantiles use nearest rank and retain outliers", "[core][nx2_present_stats]") {
+    Nx2PresentIntervals stats;
+    for (int i = 600; i >= 1; --i) {
+        REQUIRE(stats.Add(std::chrono::nanoseconds{i * 1000}, true));
+    }
+    const auto q = stats.Quantiles();
+    REQUIRE(q.has_value());
+    REQUIRE(q->p50_ns == 300'000);
+    REQUIRE(q->p95_ns == 570'000);
+    REQUIRE(q->p99_ns == 594'000);
+    REQUIRE(stats.max_ns == 600'000);
+    stats.Reset();
+    for (int i = 0; i < 599; ++i) {
+        REQUIRE(stats.Add(30ms, true));
+    }
+    REQUIRE(stats.Add(101ms, true));
+    REQUIRE(stats.max_ns == 101'000'000);
+    REQUIRE(stats.over30 == 1);
+    REQUIRE(stats.over100 == 1);
+    REQUIRE(stats.Quantiles()->p99_ns == 30'000'000);
+}
+
+TEST_CASE("NX2 present budget edges and disabled capture are explicit", "[core][nx2_present_stats]") {
+    Nx2PresentIntervals stats;
+    REQUIRE(stats.Add(33'333'333ns, true));
+    REQUIRE(stats.over30 == 0);
+    REQUIRE(stats.Add(33'333'334ns, true));
+    REQUIRE(stats.over30 == 1);
+    REQUIRE(stats.Add(100ms, true));
+    REQUIRE(stats.over100 == 0);
+    REQUIRE(stats.Add(100'000'001ns, true));
+    REQUIRE(stats.over100 == 1);
+    stats.Reset();
+    REQUIRE(stats.over30 == 0);
+    REQUIRE(stats.over100 == 0);
+    REQUIRE(stats.Add(0ns, false));
+    REQUIRE(stats.MeanUs() == 0);
+    REQUIRE_FALSE(stats.Quantiles());
+    REQUIRE(stats.Add(10ms, false));
+    REQUIRE(stats.MeanUs() == 5000);
+    REQUIRE_FALSE(stats.Quantiles());
+}
+
+TEST_CASE("NX2 present sum overflow is rejected without partial mutation", "[core][nx2_present_stats]") {
+    Nx2PresentIntervals stats;
+    const auto longest = std::chrono::nanoseconds::max();
+    REQUIRE(stats.Add(longest, true));
+    REQUIRE(stats.Add(longest, true));
+    REQUIRE_FALSE(stats.Add(longest, true));
+    REQUIRE(stats.count == 2);
+    REQUIRE(stats.sum_ns == 2ULL * static_cast<std::uint64_t>(longest.count()));
+}
