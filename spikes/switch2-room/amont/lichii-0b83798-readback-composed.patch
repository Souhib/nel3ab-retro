+        // Tests drain explicitly before reaching here. On assertion failure, discard callbacks
+        // before destroying their QueryCache owner rather than executing them in a destructor.
+        fences.reset();
+        query.reset();
+        memory.reset();
+        device.Unmap(Device, 0x10000);
+        device.UnregisterProcess(asid);
+        system.Kernel().UnregisterKernelObject(process.get());
+        Tegra::Nx2ClearSemaphoreRegions();
+        Settings::values.gpu_fence_behavior.SetValue(old_behavior);
+        Settings::values.current_gpu_accuracy = old_accuracy;
+        VideoCore::g_signaling_query_report_fence = old_report_flag;
+    }
+    template <class T> T Read(size_t offset = 0) const {
+        T value;
+        std::memcpy(&value, bytes + offset, sizeof(value));
+        return value;
+    }
+    template <class T> void Write(T value, size_t offset = 0) {
+        std::memcpy(bytes + offset, &value, sizeof(value));
+    }
+    void Report(QueryType type = QueryType::Payload,
+                QueryPropertiesFlags flags = QueryPropertiesFlags::IsAFence, u32 value = 5) {
+        query->CounterReport(Guest, type, flags, value, 0);
+        REQUIRE_FALSE(VideoCore::g_signaling_query_report_fence);
+    }
+    void Drain() {
+        fences->Complete();
+        // UnregisterPending is queued before the report callback on its fence. A following
+        // fence retires the completed query, then one more proves no duplicate retirement.
+        const bool was_flushing = buffer.flush;
+        buffer.flush = true; // Make a cleanup fence instead of relying on the 64-skip cap.
+        for (int i = 0; i < 2; ++i) {
+            fences->SignalFence([] {});
+            fences->Complete();
+        }
+        buffer.flush = was_flushing;
+    }
+};
+
+TEST_CASE("Payload query release at Low Default does not wait for a host fence",
+          "[query_payload][query_payload_red]") {
+    Fixture f;
+    REQUIRE(f.runtime.GetStreamerInterface(QueryType::Payload) == &f.runtime.payload);
+    REQUIRE(f.fences->completed == 0);
+    f.Report();
+    REQUIRE(f.Read<u32>() == 5);
+    REQUIRE(f.runtime.payload.FreeCount() == 1);
+    REQUIRE(f.report_flags == std::vector<bool>{false});
+    f.Drain();
+    REQUIRE(f.runtime.payload.FreeCount() == 1);
+}
+
+struct ModeCase {
+    GpuFenceBehavior behavior;
+    GpuAccuracy accuracy;
+    bool immediate;
+};
+TEST_CASE("Payload query release obeys fence and accuracy guards", "[query_payload]") {
+    const auto mode = GENERATE(
+        ModeCase{GpuFenceBehavior::Default, GpuAccuracy::Low, true},
+        ModeCase{GpuFenceBehavior::Default, GpuAccuracy::High, false},
+        ModeCase{GpuFenceBehavior::Immediate, GpuAccuracy::Low, true},
+        ModeCase{GpuFenceBehavior::Immediate, GpuAccuracy::High, true},
+        ModeCase{GpuFenceBehavior::Balanced, GpuAccuracy::Low, false},
+        ModeCase{GpuFenceBehavior::Balanced, GpuAccuracy::High, false},
+        ModeCase{GpuFenceBehavior::Accurate, GpuAccuracy::Low, false},
+        ModeCase{GpuFenceBehavior::Accurate, GpuAccuracy::High, false});
+    CAPTURE(mode.behavior, mode.accuracy);
+    Fixture f;
+    Settings::values.gpu_fence_behavior.SetValue(mode.behavior);
+    Settings::values.current_gpu_accuracy = mode.accuracy;
+    f.Report();
+    REQUIRE(f.Read<u32>() == (mode.immediate ? 5 : 100));
+    REQUIRE(f.runtime.payload.FreeCount() == (mode.immediate ? 1 : 0));
+    REQUIRE(f.report_flags == std::vector<bool>{!mode.immediate});
+    f.Drain();
+    REQUIRE(f.Read<u32>() == 5);
+    REQUIRE(f.runtime.payload.FreeCount() == 1);
+}
+
+TEST_CASE("Actual counter queries keep their host fence even at Immediate accuracy",
+          "[query_payload][query_counter_guard]") {
+    const auto behavior = GENERATE(GpuFenceBehavior::Default, GpuFenceBehavior::Immediate,
+                                  GpuFenceBehavior::Balanced, GpuFenceBehavior::Accurate);
+    const auto accuracy = GENERATE(GpuAccuracy::Low, GpuAccuracy::High);
+    Fixture f;
+    Settings::values.gpu_fence_behavior.SetValue(behavior);
+    Settings::values.current_gpu_accuracy = accuracy;
+    REQUIRE(f.runtime.GetStreamerInterface(QueryType::ZPassPixelCount64) == &f.runtime.counter);
+    f.Report(QueryType::ZPassPixelCount64);
+    REQUIRE(f.Read<u32>() == 100);
+    REQUIRE(f.runtime.counter.FreeCount() == 0);
+    REQUIRE(f.report_flags == std::vector<bool>{true});
+    f.Drain();
+    REQUIRE(f.Read<u32>() == 73);
+    REQUIRE(f.runtime.counter.FreeCount() == 1);
+}
+
+TEST_CASE("Missing counter streamers retain the effective Payload fallback", "[query_payload]") {
+    Fixture f;
+    REQUIRE(f.runtime.GetStreamerInterface(QueryType::ZPassPixelCount) == nullptr);
+    f.Report(QueryType::ZPassPixelCount);
+    REQUIRE(f.Read<u32>() == 1);
+    REQUIRE(f.runtime.payload.FreeCount() == 1);
+    REQUIRE(f.runtime.counter.FreeCount() == 0);
+    f.Drain();
+    REQUIRE(f.runtime.payload.FreeCount() == 1);
+}
+
+TEST_CASE("Payload releases without IsAFence keep their previous path", "[query_payload]") {
+    const auto high = GENERATE(false, true);
+    Fixture f;
+    Settings::values.current_gpu_accuracy = high ? GpuAccuracy::High : GpuAccuracy::Low;
+    f.Report(QueryType::Payload, QueryPropertiesFlags{});
+    REQUIRE(f.report_flags.empty());
+    REQUIRE(f.Read<u32>() == (high ? 100 : 5));
+    REQUIRE(f.runtime.payload.FreeCount() == (high ? 0 : 1));
+    f.fences->SignalFence([] {});
+    f.Drain();
+    REQUIRE(f.Read<u32>() == 5);
+    REQUIRE(f.runtime.payload.FreeCount() == 1);
+}
+
+TEST_CASE("Payload retirement covers successful invalidated and unsynchronized reports",
+          "[query_payload][query_retirement]") {
+    const int exit = GENERATE(0, 1, 2);
+    const auto high = GENERATE(false, true);
+    Fixture f;
+    Settings::values.current_gpu_accuracy = high ? GpuAccuracy::High : GpuAccuracy::Low;
+    if (exit == 1) f.runtime.payload.initial_flags = QueryFlagBits::IsInvalidated;
+    if (exit == 2) f.runtime.payload.final_value = false;
+    f.Report();
+    REQUIRE(f.Read<u32>() == (!high && exit == 0 ? 5 : 100));
+    REQUIRE(f.runtime.payload.FreeCount() == (high ? 0 : 1));
+    f.Drain();
+    REQUIRE(f.Read<u32>() == (exit == 0 ? 5 : 100));
+    REQUIRE(f.runtime.payload.FreeCount() == 1);
+    // The next report and cleanup must not accidentally retire the previous immediate query.
+    f.runtime.payload.initial_flags = {};
+    f.runtime.payload.final_value = true;
+    f.Report(QueryType::Payload, QueryPropertiesFlags::IsAFence, 9);
+    f.Drain();
+    REQUIRE(f.Read<u32>() == 9);
+    REQUIRE(f.runtime.payload.FreeCount() == 2);
+}
+
+TEST_CASE("Invalidating a registered delayed payload suppresses its write", "[query_payload]") {
+    Fixture f;
+    Settings::values.current_gpu_accuracy = GpuAccuracy::High;
+    f.Report();
+    REQUIRE(f.runtime.payload.FreeCount() == 0);
+    REQUIRE_FALSE(True(f.runtime.payload.queries.front().flags & QueryFlagBits::IsInvalidated));
+    f.query->InvalidateRegion(Fixture::Device, sizeof(u32));
+    REQUIRE(True(f.runtime.payload.queries.front().flags & QueryFlagBits::IsInvalidated));
+    f.Drain();
+    REQUIRE(f.Read<u32>() == 100);
+    REQUIRE(f.runtime.payload.FreeCount() == 1);
+}
+
+TEST_CASE("A nonempty flush does not delay an eligible payload callback", "[query_payload]") {
+    Fixture f;
+    f.buffer.flush = true;
+    f.Report();
+    REQUIRE(f.fences->queued > 0);
+    REQUIRE(f.fences->completed == 0);
+    REQUIRE(f.Read<u32>() == 5);
+    REQUIRE(f.runtime.payload.FreeCount() == 1);
+    f.buffer.flush = false;
+    f.Drain();
+    REQUIRE(f.runtime.payload.FreeCount() == 1);
+}
+
+TEST_CASE("Payload release preserves mirror shadows and timestamp flags",
+          "[query_payload][query_mirror]") {
+    const auto high = GENERATE(false, true);
+    const auto mirrored = GENERATE(false, true);
+    const auto divert = GENERATE(false, true);
+    const auto wide = GENERATE(false, true);
+    Fixture f;
+    Settings::values.current_gpu_accuracy = high ? GpuAccuracy::High : GpuAccuracy::Low;
+    auto& shadow = Tegra::Nx2MirrorShadow::Get();
+    Tegra::Nx2AddSemaphoreRegion(Fixture::Guest);
+    REQUIRE(Tegra::Nx2InSemaphoreFirstPage(Fixture::Guest));
+    if (divert) {
+        // A real direct release registers this word; no artificial shadow eligibility.
+        f.Report(QueryType::Payload, QueryPropertiesFlags::IsAFence, 100);
+        f.Drain();
+        REQUIRE(shadow.Diverts(Fixture::Device));
+    } else {
+        REQUIRE_FALSE(shadow.Diverts(Fixture::Device));
+    }
+    constexpr u64 Sentinel = 0x1234567812345678;
+    f.Write<u64>(Sentinel, 8);
+    QueryPropertiesFlags flags = QueryPropertiesFlags::IsAFence;
+    if (mirrored) flags |= QueryPropertiesFlags::Nx2Mirror;
+    if (wide) flags |= QueryPropertiesFlags::HasTimeout;
+    const u32 before_frees = f.runtime.payload.FreeCount();
+    f.Report(QueryType::Payload, flags);
+    REQUIRE(f.runtime.payload.FreeCount() == before_frees + (high ? 0 : 1));
+    if (high) {
+        REQUIRE(f.Read<u32>() == 100);
+        REQUIRE_FALSE(shadow.Read(Fixture::Device, 100).has_value());
+    }
+    f.Drain();
+    REQUIRE(f.runtime.payload.FreeCount() == before_frees + 1);
+    if (mirrored && divert) {
+        REQUIRE(f.Read<u32>() == 100);
+        REQUIRE(shadow.Read(Fixture::Device, 100) == 5);
+        REQUIRE(f.Read<u64>(8) == Sentinel);
+        // A subsequent real direct release must clear the shadow again.
+        f.Report(QueryType::Payload, QueryPropertiesFlags::IsAFence, 9);
+        f.Drain();
+        REQUIRE(f.Read<u32>() == 9);
+        REQUIRE_FALSE(shadow.Read(Fixture::Device, 9).has_value());
+    } else {
+        REQUIRE(f.Read<u32>() == 5);
+        REQUIRE_FALSE(shadow.Read(Fixture::Device, 5).has_value());
+        if (wide) {
+            REQUIRE(f.Read<u64>() == 5);
+            REQUIRE(f.Read<u64>(8) != Sentinel);
+        } else {
+            REQUIRE(f.Read<u64>(8) == Sentinel);
+        }
+    }
+}
+
+} // namespace
