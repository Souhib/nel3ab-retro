+    DeltaFixture f;
+    f.memory.BindRasterizer(&f.rasterizer);
+    constexpr GPUVAddr target = 0x100000, alias = 0x300000, other = 0x500000;
+    f.memory.Map(target, 0x200000, 0x1000, Tegra::PTEKind::PITCH, false);
+    f.memory.Map(alias, 0x200000, 0x1000, Tegra::PTEKind::PITCH, false);
+    f.memory.Map(other, 0x400000, 0x1000, Tegra::PTEKind::PITCH, false);
+    const auto report = [&](GPUVAddr address) {
+        FastDraw::g_delta = {};
+        f.Write(MAXWELL3D_REG_INDEX(report_semaphore.address_high), 0);
+        f.Write(MAXWELL3D_REG_INDEX(report_semaphore.address_low), static_cast<u32>(address));
+        f.Write(MAXWELL3D_REG_INDEX(report_semaphore.query), 2U | (1U << 28));
+    };
+    FastDraw::DeviceSpans spans;
+    spans.Update(f.memory, target, 0x100);
+    report(alias + 0xfc);
+    CHECK(FastDraw::g_delta.Reaches(target, 0x100, spans));
+    report(alias + 0x100);
+    CHECK_FALSE(FastDraw::g_delta.Reaches(target, 0x100, spans));
+    report(other + 0xfc);
+    CHECK_FALSE(FastDraw::g_delta.Reaches(target, 0x100, spans));
+    f.Write(MAXWELL3D_REG_INDEX(tex_header.address_low), static_cast<u32>(target));
+    f.Write(MAXWELL3D_REG_INDEX(tex_header.limit), 7);
+    u64 serial = FastDraw::Serial();
+    report(alias + 0xfc);
+    CHECK(FastDraw::Serial() != serial);
+    serial = FastDraw::Serial();
+    report(alias + 0x100);
+    CHECK(FastDraw::Serial() == serial);
+}
