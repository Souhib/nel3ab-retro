+TEST_CASE("A nonempty flush does not delay an eligible payload callback", "[query_payload]") {
+    Fixture f;
+    f.buffer.flush = true;
+    f.Report();
+    REQUIRE(f.fences->queued > 0);
+    REQUIRE(f.fences->completed == 0);
+    REQUIRE(f.Read<u32>() == 5);
+    REQUIRE(f.runtime.payload.FreeCount() == 1);
+    f.buffer.flush = false;
+    f.Drain();
+    REQUIRE(f.runtime.payload.FreeCount() == 1);
+}
+
+TEST_CASE("Payload release preserves mirror shadows and timestamp flags",
+          "[query_payload][query_mirror]") {
+    const auto high = GENERATE(false, true);
+    const auto mirrored = GENERATE(false, true);
+    const auto divert = GENERATE(false, true);
+    const auto wide = GENERATE(false, true);
+    Fixture f;
+    Settings::values.current_gpu_accuracy = high ? GpuAccuracy::High : GpuAccuracy::Low;
+    auto& shadow = Tegra::Nx2MirrorShadow::Get();
+    Tegra::Nx2AddSemaphoreRegion(Fixture::Guest);
+    REQUIRE(Tegra::Nx2InSemaphoreFirstPage(Fixture::Guest));
+    if (divert) {
+        // A real direct release registers this word; no artificial shadow eligibility.
+        f.Report(QueryType::Payload, QueryPropertiesFlags::IsAFence, 100);
+        f.Drain();
+        REQUIRE(shadow.Diverts(Fixture::Device));
+    } else {
+        REQUIRE_FALSE(shadow.Diverts(Fixture::Device));
+    }
+    constexpr u64 Sentinel = 0x1234567812345678;
+    f.Write<u64>(Sentinel, 8);
+    QueryPropertiesFlags flags = QueryPropertiesFlags::IsAFence;
+    if (mirrored) flags |= QueryPropertiesFlags::Nx2Mirror;
+    if (wide) flags |= QueryPropertiesFlags::HasTimeout;
+    const u32 before_frees = f.runtime.payload.FreeCount();
+    f.Report(QueryType::Payload, flags);
+    REQUIRE(f.runtime.payload.FreeCount() == before_frees + (high ? 0 : 1));
+    if (high) {
+        REQUIRE(f.Read<u32>() == 100);
+        REQUIRE_FALSE(shadow.Read(Fixture::Device, 100).has_value());
+    }
+    f.Drain();
+    REQUIRE(f.runtime.payload.FreeCount() == before_frees + 1);
+    if (mirrored && divert) {
+        REQUIRE(f.Read<u32>() == 100);
+        REQUIRE(shadow.Read(Fixture::Device, 100) == 5);
+        REQUIRE(f.Read<u64>(8) == Sentinel);
+        // A subsequent real direct release must clear the shadow again.
+        f.Report(QueryType::Payload, QueryPropertiesFlags::IsAFence, 9);
+        f.Drain();
+        REQUIRE(f.Read<u32>() == 9);
+        REQUIRE_FALSE(shadow.Read(Fixture::Device, 9).has_value());
+    } else {
+        REQUIRE(f.Read<u32>() == 5);
+        REQUIRE_FALSE(shadow.Read(Fixture::Device, 5).has_value());
+        if (wide) {
+            REQUIRE(f.Read<u64>() == 5);
+            REQUIRE(f.Read<u64>(8) != Sentinel);
+        } else {
+            REQUIRE(f.Read<u64>(8) == Sentinel);
+        }
+    }
+}
