+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <vector>
+#include <catch2/catch_test_macros.hpp>
+#include "video_core/buffer_cache/upload_payload_diagnostic.h"
+
+TEST_CASE("Upload payload diagnostic compares every byte and keeps address identities", "[upload_payload]") {
+    using D = VideoCommon::UploadPayloadDiagnostic;
+    D diagnostic;
+    std::vector<std::uint8_t> payload(D::MinBytes,0);
+    diagnostic.Observe(1,payload.size(),payload);
+    REQUIRE(diagnostic.Counts().compared_uploads==0);
+    diagnostic.Observe(1,payload.size(),payload);
+    REQUIRE(diagnostic.Counts().identical_uploads==1);
+    payload.back()=1;
+    diagnostic.Observe(1,payload.size(),payload);
+    REQUIRE(diagnostic.Counts().compared_uploads==2);
+    REQUIRE(diagnostic.Counts().identical_uploads==1);
+    diagnostic.Observe(2,payload.size(),payload);
+    REQUIRE(diagnostic.Counts().compared_uploads==2);
+    REQUIRE(diagnostic.TrackedKeys()==2);
+    diagnostic.Observe(1,payload.size());
+    REQUIRE(diagnostic.Counts().eligible_uploads==5);
+    REQUIRE(diagnostic.Counts().observed_uploads==4);
+    REQUIRE(diagnostic.Counts().identical_bytes==payload.size());
+    REQUIRE(D::Eligible(D::MinBytes));
+    REQUIRE(D::Eligible(D::MaxBytes));
+    REQUIRE_FALSE(D::Eligible(D::MinBytes-1));
+    REQUIRE_FALSE(D::Eligible(D::MaxBytes+1));
+}
+
+TEST_CASE("Upload payload diagnostic bounds memory and forgets evicted sources", "[upload_payload]") {
+    using D = VideoCommon::UploadPayloadDiagnostic;
+    D diagnostic;
+    std::vector<std::uint8_t> payload(D::MinBytes,0);
+    for (std::size_t address=1; address<=D::MaxKeys; ++address) {
+        diagnostic.Observe(address,payload.size(),payload);
+    }
+    REQUIRE(diagnostic.TrackedKeys()==D::MaxKeys);
+    diagnostic.Observe(D::MaxKeys+1,payload.size(),payload);
+    REQUIRE(diagnostic.TrackedKeys()==1);
+    REQUIRE(diagnostic.Counts().resets==1);
+    diagnostic.Observe(1,payload.size(),payload);
+    REQUIRE(diagnostic.Counts().compared_uploads==0);
+    diagnostic.Observe(1,payload.size(),payload);
+    REQUIRE(diagnostic.Counts().identical_uploads==1);
+}
diff --git a/src/video_core/buffer_cache/native_bank_contents.h b/src/video_core/buffer_cache/native_bank_contents.h
new file mode 100644
index 000000000..c3c6eae40
--- /dev/null
+++ b/src/video_core/buffer_cache/native_bank_contents.h
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <span>
+#include <tuple>
+#include <limits>
+#include <utility>
+#include <vector>
+
+namespace VideoCommon {
+// 2026-11-09: 46,410 observed 64..128 KiB uploads repeated the same source bytes.
+// This only decides whether to force the once-per-frame bank refresh. Genuine dirty
+// tracking and synchronization still run. At most 512 snapshots retain 64 MiB.
+class NativeBankContents {
+public:
+    static constexpr std::uint64_t PageSize = 4096;
+    static constexpr std::size_t MaxBytes = 128 * 1024;
+    static constexpr std::size_t MaxKeys = 512;
+    enum class Decision { Refresh, Unchanged };
+    enum class GpuHistory { Unwritten, Written };
+    enum class ResetReason { Other, Create, Delete, Clear, Discard, Repack };
+    struct Statistics {
+        std::uint64_t calls{}, unchanged{}, gpu_written{}, compared{};
+        std::uint64_t resets{}, nonempty{}, create{}, remove{}, clear{}, discard{}, repack{};
+        std::uint64_t range_calls{}, range_removed{}, range_preserved{}, capacity{};
+    };
+    Decision Check(std::uint64_t bank_address, std::size_t marked_bytes,
+                   std::span<const std::uint8_t> covered_pages) {
+        if (covered_pages.empty() || covered_pages.size() > MaxBytes ||
+            marked_bytes > covered_pages.size() ||
+            bank_address % PageSize > covered_pages.size() - marked_bytes) {
+            return Decision::Refresh;
+        }
+        const auto key = std::tuple{bank_address, marked_bytes, covered_pages.size()};
+        auto found = previous.find(key);
+        if (found != previous.end()) {
+            if (std::equal(covered_pages.begin(), covered_pages.end(), found->second.begin())) {
+                return Decision::Unchanged;
+            }
+            found->second.assign(covered_pages.begin(), covered_pages.end());
+            return Decision::Refresh;
+        }
+        if (previous.size() == MaxKeys) { previous.clear(); ++statistics.capacity; }
+        previous.emplace(key,std::vector<std::uint8_t>{covered_pages.begin(),covered_pages.end()});
+        return Decision::Refresh;
+    }
+    template <typename Invalidate>
+    bool RefreshIfChanged(std::uint64_t address, std::size_t marked,
+                          std::span<const std::uint8_t> pages, GpuHistory history,
+                          Invalidate&& invalidate) {
+        ++statistics.calls;
+        if (history == GpuHistory::Written) { ++statistics.gpu_written; }
+        else { ++statistics.compared; }
+        if (history == GpuHistory::Unwritten &&
+            Check(address,marked,pages)==Decision::Unchanged) {
+            ++statistics.unchanged;
+            return false;
+        }
+        std::forward<Invalidate>(invalidate)();
+        return true;
+    }
+    void Reset(ResetReason reason=ResetReason::Other) {
+        ++statistics.resets;
+        statistics.nonempty += !previous.empty();
+        switch (reason) {
+        case ResetReason::Create: ++statistics.create; break;
+        case ResetReason::Delete: ++statistics.remove; break;
+        case ResetReason::Clear: ++statistics.clear; break;
+        case ResetReason::Discard: ++statistics.discard; break;
+        case ResetReason::Repack: ++statistics.repack; break;
+        case ResetReason::Other: break;
+        }
+        previous.clear();
+    }
+    const Statistics& Stats() const { return statistics; }
+    void InvalidateRange(std::uint64_t address, std::size_t size,
+                         ResetReason reason=ResetReason::Other) {
+        if (size > std::numeric_limits<std::uint64_t>::max() - address) {
+            Reset(reason);
+            return;
+        }
+        ++statistics.range_calls;
+        switch(reason) {
+        case ResetReason::Create: ++statistics.create; break;
+        case ResetReason::Delete: ++statistics.remove; break;
+        case ResetReason::Clear: ++statistics.clear; break;
+        case ResetReason::Discard: ++statistics.discard; break;
+        case ResetReason::Repack: ++statistics.repack; break;
+        case ResetReason::Other: break;
+        }
+        if (size==0) { return; }
+        const auto before=previous.size();
+        const auto end=address+size;
+        std::erase_if(previous,[&](const auto& entry) {
+            const auto start=std::get<0>(entry.first) & ~(PageSize-1);
+            if (entry.second.size()>std::numeric_limits<std::uint64_t>::max()-start) { return true; }
+            return start<end && address<start+entry.second.size();
+        });
+        statistics.range_removed += before-previous.size();
+        statistics.range_preserved += !previous.empty();
+    }
+    std::size_t TrackedKeys() const { return previous.size(); }
+private:
+    Statistics statistics;
+    std::map<std::tuple<std::uint64_t,std::size_t,std::size_t>,std::vector<std::uint8_t>> previous;
+};
+}
diff --git a/src/video_core/buffer_cache/upload_payload_diagnostic.h b/src/video_core/buffer_cache/upload_payload_diagnostic.h
new file mode 100644
index 000000000..c6a47dc0b
--- /dev/null
+++ b/src/video_core/buffer_cache/upload_payload_diagnostic.h
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <span>
+#include <utility>
+#include <vector>
+
+namespace VideoCommon {
+struct UploadPayloadCounts {
+    std::uint64_t uploads{}, bytes{}, eligible_uploads{}, eligible_bytes{};
+    std::uint64_t observed_uploads{}, observed_bytes{}, compared_uploads{}, compared_bytes{};
+    std::uint64_t identical_uploads{}, identical_bytes{}, resets{};
+};
+
+// 2026-11-09: the timed copy loop mostly handles 68 KiB payloads. Sample 64..128 KiB
+// sources with at most 512 retained payloads (64 MiB); never change an upload decision.
+class UploadPayloadDiagnostic {
+public:
+    static constexpr std::size_t MinBytes = 64 * 1024;
+    static constexpr std::size_t MaxBytes = 128 * 1024;
+    static constexpr std::size_t MaxKeys = 512;
+    static bool Eligible(std::size_t size) { return size >= MinBytes && size <= MaxBytes; }
+
+    void Observe(std::uint64_t address, std::size_t requested_size,
+                 std::span<const std::uint8_t> source = {}) {
+        ++counts.uploads;
+        counts.bytes += requested_size;
+        if (!Eligible(requested_size)) { return; }
+        ++counts.eligible_uploads;
+        counts.eligible_bytes += requested_size;
+        if (source.size() != requested_size) { return; }
+        ++counts.observed_uploads;
+        counts.observed_bytes += requested_size;
+        const auto key = std::pair{address, requested_size};
+        auto found = previous.find(key);
+        if (found != previous.end()) {
+            ++counts.compared_uploads;
+            counts.compared_bytes += requested_size;
+            if (std::equal(source.begin(), source.end(), found->second.begin())) {
+                ++counts.identical_uploads;
+                counts.identical_bytes += requested_size;
+            }
+            found->second.assign(source.begin(), source.end());
+            return;
+        }
+        if (previous.size() == MaxKeys) {
+            previous.clear();
+            ++counts.resets;
+        }
+        previous.emplace(key, std::vector<std::uint8_t>{source.begin(), source.end()});
+    }
+    const UploadPayloadCounts& Counts() const { return counts; }
+    std::size_t TrackedKeys() const { return previous.size(); }
+private:
+    UploadPayloadCounts counts;
+    std::map<std::pair<std::uint64_t, std::size_t>, std::vector<std::uint8_t>> previous;
+};
+}
diff --git a/src/video_core/renderer_vulkan/stream_ring_cursor.h b/src/video_core/renderer_vulkan/stream_ring_cursor.h
new file mode 100644
index 000000000..1e7b88416
--- /dev/null
+++ b/src/video_core/renderer_vulkan/stream_ring_cursor.h
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <stdexcept>
+
+namespace Vulkan {
+// Allocation bookkeeping only. The caller owns the buffer and supplies completed GPU ticks.
+template <std::size_t Regions>
+class StreamRingCursor {
+public:
+    static_assert(Regions > 1, "A stream ring needs a current and a following region");
+    explicit StreamRingCursor(std::size_t capacity_) : capacity{capacity_}, region_size{capacity / Regions} {
+        if (capacity == 0 || capacity % Regions != 0) {
+            throw std::invalid_argument("Stream ring capacity must contain complete regions");
+        }
+    }
+
+    std::optional<std::size_t> Reserve(std::size_t size, std::size_t alignment,
+                                       std::uint64_t tick, std::uint64_t completed) {
+        if (alignment == 0 || alignment > region_size || size > region_size) {
+            return std::nullopt;
+        }
+        const auto region = [this](std::size_t offset) { return offset / region_size; };
+        const auto active = [&](std::size_t begin, std::size_t end) {
+            return std::any_of(ticks.begin() + begin, ticks.begin() + end,
+                               [completed](std::uint64_t used_tick) { return completed < used_tick; });
+        };
+        if (active(region(free_position) + 1, std::min(region(position + size) + 1, Regions))) {
+            return std::nullopt;
+        }
+        // Check before changing any cursor: a rejected wrap must remain rejected on retry.
+        if (position + size >= capacity && active(0, region(size) + 1)) {
+            return std::nullopt;
+        }
+        std::fill(ticks.begin() + region(used_position), ticks.begin() + region(position), tick);
+        used_position = position;
+        free_position = std::max(free_position, position + size);
+        if (position + size >= capacity) {
+            std::fill(ticks.begin() + region(used_position), ticks.end(), tick);
+            used_position = 0;
+            position = 0;
+            free_position = size;
+            ++wraps;
+        }
+        const std::size_t offset = position;
+        position = ((position + size + alignment - 1) / alignment) * alignment;
+        return offset;
+    }
+    unsigned Wraps() const { return wraps; }
+private:
+    std::size_t capacity;
+    std::size_t region_size;
+    std::size_t position{}, used_position{}, free_position{};
+    std::array<std::uint64_t, Regions> ticks{};
+    unsigned wraps{};
+};
+}
