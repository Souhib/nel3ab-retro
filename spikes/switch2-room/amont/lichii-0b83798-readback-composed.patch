+    SettingsScope settings;
+    Nx2TitleScope title;
+    ::Fixture buffers;
+    const VideoCommon::BufferId id = Access::Add(*buffers.cache, 0x20000, 0x10000);
+    Rasterizer rasterizer{*buffers.cache, buffers.runtime};
+    QueryRuntime runtime{*buffers.cache, buffers.runtime, id};
+    Queries queries{buffers.gpu, rasterizer, buffers.device, runtime};
+    TextureCache texture;
+    Fences fences{rasterizer, buffers.gpu, texture, *buffers.cache, queries, buffers.runtime};
+    static constexpr GPUVAddr Address = 0x200040;
+    static constexpr DAddr Device = 0x20040;
+    Fixture() {
+        buffers.memory->EnableNativeTiling();
+        buffers.memory->Map(0x200000, 0x20000, 0x10000, Tegra::PTEKind::PITCH, true);
+        Access::SetNativeMemory(*buffers.cache, *buffers.memory);
+        REQUIRE(buffers.cache->FlushesOnCpuRead());
+        queries.SetMemory(*buffers.memory);
+        rasterizer.signal = [this](std::function<void()>&& operation) {
+            fences.SignalFence(std::move(operation));
+        };
+        rasterizer.sync = [this](std::function<void()>&& operation) {
+            fences.SyncOperation(std::move(operation));
+        };
+        REQUIRE(buffers.memory->GpuToCpuAddress(Address) == Device);
+        REQUIRE(VideoCore::g_read_downloads == 0);
+        for (u8 frame = 1; frame <= 2; ++frame) {
+            WriteByDispatch(buffers, id, 0x20000, 0x100, frame);
+            REQUIRE_FALSE(ReadWord(buffers, 0x20010).preemtive);
+        }
+        REQUIRE(Access::ReadBackReads(*buffers.cache, 0x20000) == 2);
+        REQUIRE_FALSE(buffers.cache->HasUncommittedFlushes());
+        REQUIRE(Access::ReadDownloads(*buffers.cache) == 0);
+    }
+    void Counter() {
+        REQUIRE(runtime.GetStreamerInterface(QueryType::ZPassPixelCount64) == &runtime.counter);
+        queries.CounterReport(Address, QueryType::ZPassPixelCount64,
+                              QueryPropertiesFlags::IsAFence, 0, 0);
+        REQUIRE(rasterizer.notes.back());
+        REQUIRE(runtime.counter.frees == 0);
+        REQUIRE_FALSE(buffers.runtime.IsFree(fences.last_tick));
+    }
+    void Draw() {
+        auto* buffer = &Access::Get(*buffers.cache, id);
+        buffers.runtime.pending.push_back([buffer] {
+            std::fill_n(buffer->bytes.begin(), 0x100, u8{3});
+        });
+        Access::MarkWritten(*buffers.cache, id, 0x20000, 0x100);
+        buffers.cache->NoteWorkRecorded(false);
+        REQUIRE(Access::ReadDownloads(*buffers.cache) == 0);
+        REQUIRE(Access::EarlyPages(*buffers.cache) == 1);
+        REQUIRE(Tegra::Nx2MayBeGpuWritten(Device, 4));
+        REQUIRE_FALSE(buffers.cache->HasUncommittedFlushes());
+    }
+    void Payload() {
+        queries.CounterReport(Address, QueryType::Payload, QueryPropertiesFlags::IsAFence, 5, 0);
+        REQUIRE(runtime.payload->frees == 1);
+        REQUIRE(runtime.counter.frees == 0);
+        REQUIRE(runtime.copies == 1); // Production GuestStreamer reached SyncValues.
+        REQUIRE(Word() == 5);
+    }
+    u32 Word() const {
+        u32 word;
+        std::memcpy(&word, buffers.bytes + 0x10040, sizeof(word));
+        return word;
+    }
+    void Retire(u32 expected_counter = 1, u32 expected_payload = 1) {
+        fences.Complete();
+        texture.flush = true;
+        for (int i = 0; i < 2; ++i) {
+            fences.SignalFence([] {});
+            fences.Complete();
+        }
+        texture.flush = false;
+        REQUIRE(runtime.counter.frees == expected_counter);
+        REQUIRE(runtime.payload->frees == expected_payload);
+        REQUIRE_FALSE(queries.HoldsQueries(Device, 4));
+    }
+};
