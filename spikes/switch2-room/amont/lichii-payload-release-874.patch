+TEST_CASE("Payload query release at Low Default does not wait for a host fence",
+          "[query_payload][query_payload_red]") {
+    Fixture f;
+    REQUIRE(f.runtime.GetStreamerInterface(QueryType::Payload) == &f.runtime.payload);
+    REQUIRE(f.fences->completed == 0);
+    f.Report();
+    REQUIRE(f.Read<u32>() == 5);
+    REQUIRE(f.runtime.payload.FreeCount() == 1);
+    REQUIRE(f.report_flags == std::vector<bool>{false});
+    f.Drain();
+    REQUIRE(f.runtime.payload.FreeCount() == 1);
+}
