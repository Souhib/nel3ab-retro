@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <cmath>
+#include <optional>
+#include "common/common_types.h"
+
+namespace VideoCommon {
+inline std::optional<double> GpuTimestampNanoseconds(u64 begin, u64 end, bool begin_available,
+                                                    bool end_available, u32 valid_bits,
+                                                    double period_ns) {
+    if (!begin_available || !end_available || valid_bits == 0 || valid_bits > 64 ||
+        !std::isfinite(period_ns) || period_ns <= 0) return std::nullopt;
+    const u64 mask = valid_bits == 64 ? ~u64{0} : (u64{1} << valid_bits) - 1;
+    return static_cast<double>((end - begin) & mask) * period_ns;
+}
+} // namespace VideoCommon
