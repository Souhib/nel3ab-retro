+struct Fixture {
+    static constexpr GPUVAddr Guest = 0x100000;
+    static constexpr DAddr Device = 0x10000;
+    ScopedSystemTestContext context;
+    Core::System system;
+    Core::DeviceMemory physical;
+    Tegra::MaxwellDeviceMemoryManager device{physical};
+    Tegra::GPU gpu{system, false, false};
+    QueryRasterizer rasterizer{gpu};
+    std::unique_ptr<Kernel::KProcess> process;
+    std::optional<Tegra::MemoryManager> memory;
+    QueryRuntime runtime;
+    std::unique_ptr<QueryCache> query;
+    FlushCache texture, buffer;
+    std::unique_ptr<FenceManager> fences;
+    Core::Asid asid{};
+    u8* bytes{};
+    const GpuFenceBehavior old_behavior = Settings::values.gpu_fence_behavior.GetValue();
+    const GpuAccuracy old_accuracy = Settings::values.current_gpu_accuracy;
+    const bool old_report_flag = VideoCore::g_signaling_query_report_fence;
+    std::vector<bool> report_flags;
+
+    Fixture() {
+        Settings::values.gpu_fence_behavior.SetValue(GpuFenceBehavior::Default);
+        Settings::values.current_gpu_accuracy = GpuAccuracy::Low;
+        VideoCore::g_signaling_query_report_fence = false;
+        Tegra::Nx2ClearSemaphoreRegions();
+        system.Initialize();
+        process = std::make_unique<Kernel::KProcess>(system.Kernel());
+        auto& table = process->GetPageTable().GetImpl();
+        table.Resize(24, 12);
+        bytes = physical.GetPointerFromRaw<u8>(Device);
+        std::memset(bytes, 0, 0x10000);
+        for (u64 page = 0; page < 16; ++page) {
+            table.entries.GetAndFault(0x10 + page)
+                .Store(false, Common::PageType::Memory, 1,
+                       reinterpret_cast<uintptr_t>(bytes) - Device);
+        }
+        process->GetMemory().SetCurrentPageTable(*process);
+        asid = device.RegisterProcess(&process->GetMemory());
+        device.BindInterface(&rasterizer);
+        device.Map(Device, Device, 0x10000, asid);
+        memory.emplace(system, device, 32, 1ULL << 31, 16);
+        memory->BindRasterizer(&rasterizer);
+        memory->Map(Guest, Device, 0x10000, Tegra::PTEKind::PITCH, true);
+        query = std::make_unique<QueryCache>(gpu, rasterizer, device, runtime);
+        query->SetMemory(*memory);
+        fences = std::make_unique<FenceManager>(rasterizer, gpu, texture, buffer, *query);
+        rasterizer.signal = [this](std::function<void()>&& callback) {
+            report_flags.push_back(VideoCore::g_signaling_query_report_fence);
+            fences->SignalFence(std::move(callback));
+        };
+        rasterizer.sync = [this](std::function<void()>&& callback) {
+            fences->SyncOperation(std::move(callback));
+        };
+        REQUIRE(memory->GpuToCpuAddress(Guest) == Device);
+        REQUIRE(texture.ShouldWaitAsyncFlushes());
+        Write<u32>(100);
+    }
+    ~Fixture() {
+        // Tests drain explicitly before reaching here. On assertion failure, discard callbacks
+        // before destroying their QueryCache owner rather than executing them in a destructor.
+        fences.reset();
+        query.reset();
+        memory.reset();
+        device.Unmap(Device, 0x10000);
+        device.UnregisterProcess(asid);
+        system.Kernel().UnregisterKernelObject(process.get());
+        Tegra::Nx2ClearSemaphoreRegions();
+        Settings::values.gpu_fence_behavior.SetValue(old_behavior);
+        Settings::values.current_gpu_accuracy = old_accuracy;
+        VideoCore::g_signaling_query_report_fence = old_report_flag;
+    }
+    template <class T> T Read(size_t offset = 0) const {
+        T value;
+        std::memcpy(&value, bytes + offset, sizeof(value));
+        return value;
+    }
+    template <class T> void Write(T value, size_t offset = 0) {
+        std::memcpy(bytes + offset, &value, sizeof(value));
+    }
+    void Report(QueryType type = QueryType::Payload,
+                QueryPropertiesFlags flags = QueryPropertiesFlags::IsAFence, u32 value = 5) {
+        query->CounterReport(Guest, type, flags, value, 0);
+        REQUIRE_FALSE(VideoCore::g_signaling_query_report_fence);
+    }
+    void Drain() {
+        fences->Complete();
+        // UnregisterPending is queued before the report callback on its fence. A following
+        // fence retires the completed query, then one more proves no duplicate retirement.
+        const bool was_flushing = buffer.flush;
+        buffer.flush = true; // Make a cleanup fence instead of relying on the 64-skip cap.
+        for (int i = 0; i < 2; ++i) {
+            fences->SignalFence([] {});
+            fences->Complete();
+        }
+        buffer.flush = was_flushing;
+    }
+};
