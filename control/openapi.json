{
  "openapi": "3.1.0",
  "info": {
    "title": "nel3ab control",
    "summary": "Who is here, which game, which pad.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Read Me",
        "description": "L'identité que le proxy garantit, et le pseudo qui va avec.\n\nRend `login: null` quand aucun proxy n'est devant, ce qui est le cas en\ndéveloppement. Ce n'est pas une erreur: la page retombe alors sur un prénom\ngardé dans le navigateur, comme avant.",
        "operationId": "read_me",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "me"
        ],
        "summary": "Rename Me",
        "description": "Change son propre pseudo, et rien d'autre.\n\nLe pseudo est écrit sous l'adresse que le PROXY donne, jamais sous une\nadresse envoyée par le client: c'est la différence entre choisir son nom et\nchoisir celui de quelqu'un d'autre.",
        "operationId": "rename_me",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Identity"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/room": {
      "get": {
        "tags": [
          "room"
        ],
        "summary": "Read Room",
        "description": "What is loaded, what else could be, who claims which pad, and who is here.",
        "operationId": "read_room",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Room"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Game": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index",
            "description": "Its position in the worker's library, which is how it is asked for."
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "What to call it on screen."
          }
        },
        "type": "object",
        "required": [
          "index",
          "name"
        ],
        "title": "Game",
        "description": "One game the room can run."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Identity": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 24,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Identity",
        "description": "A person, as this service knows them.\n\nThere is no account and no password: rooms are private and shared with people\nalready on the network. The name exists so a seat can say \"Souhib\" rather than\n\"player 2\" (ADR D12)."
      },
      "Me": {
        "properties": {
          "login": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Login",
            "description": "L'adresse que Tailscale garantit, ou rien."
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Le pseudo, choisi et modifiable."
          },
          "display": {
            "type": "string",
            "title": "Display",
            "description": "Le nom que le fournisseur d'identité affiche, pour information.",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Me",
        "description": "Qui le service croit avoir en face.\n\n`login` vient du proxy et n'est pas modifiable; `name` est choisi et l'est.\nUn `login` nul veut dire « aucun proxy devant », donc aucune identité: la\npage retombe alors sur un prénom gardé dans le navigateur."
      },
      "Person": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "login": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Login"
          },
          "seat": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seat",
            "description": "La manette qu'il tient, s'il en tient une."
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Person",
        "description": "Quelqu'un dans la salle, qu'il tienne une manette ou non."
      },
      "Room": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "game": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Game"
              },
              {
                "type": "null"
              }
            ],
            "description": "What is loaded right now."
          },
          "library": {
            "items": {
              "$ref": "#/components/schemas/Game"
            },
            "type": "array",
            "title": "Library"
          },
          "seats": {
            "items": {
              "$ref": "#/components/schemas/Seat"
            },
            "type": "array",
            "title": "Seats"
          },
          "owner": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Person"
              },
              {
                "type": "null"
              }
            ],
            "description": "Qui décide du jeu: le premier arrivé encore présent. Nul quand personne n'a d'identité, et la salle retombe alors sur sa règle d'avant, où tenir une manette suffit."
          },
          "people": {
            "items": {
              "$ref": "#/components/schemas/Person"
            },
            "type": "array",
            "title": "People",
            "description": "Tout le monde dans la salle, spectateurs compris. Les places ne disent que ceux qui jouent, et une salle où quelqu'un regarde sans manette avait l'air vide."
          },
          "ask_lasts": {
            "type": "number",
            "title": "Ask Lasts",
            "description": "Combien de secondes une demande de manette attend une réponse. Publié pour que le compte à rebours de la page soit le vrai, et non un nombre recopié qui finirait par ne plus correspondre.",
            "default": 10.0
          },
          "media_url": {
            "type": "string",
            "title": "Media Url",
            "description": "Where the browser opens its own video, sound and pad sockets. Empty means the page's own origin."
          }
        },
        "type": "object",
        "required": [
          "name",
          "library",
          "seats",
          "media_url"
        ],
        "title": "Room",
        "description": "The room, as a page needs to render it."
      },
      "Seat": {
        "properties": {
          "port": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Port"
          },
          "player": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Player",
            "description": "The name of whoever claims it, if anybody."
          }
        },
        "type": "object",
        "required": [
          "port"
        ],
        "title": "Seat",
        "description": "One of the room's pads, and who claims it."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
