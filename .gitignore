target/
*.rvz
*.iso
*.gcm
.env
.DS_Store

# The built documentation site. Generated by `just docs` from docs/, so keeping
# it would be a second copy of every document that can disagree with the first.
#
# Zensical's build cache needs no rule here: it writes `.cache/.gitignore`
# holding `*`, so it excludes itself.
site/

# Python leftovers from the control plane: byte code and coverage state, both
# rebuilt by every run. They were committed once, which is how this rule got
# written.
__pycache__/
*.pyc
.coverage
.venv/
.pytest_cache/
.ruff_cache/

# La sortie d'un pilote de navigateur, gardée le temps de la lire et pas plus.
spikes/m3-browser-drive/*.log

# Le cache de vitest s'était retrouvé suivi: il change à chaque essai lancé,
# donc il salissait tous les diffs et a failli entrer dans un commit qui ne
# parlait pas de lui.
node_modules/
