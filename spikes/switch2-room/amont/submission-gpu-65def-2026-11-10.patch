diff --git a/src/video_core/renderer_vulkan/vk_submission_gpu.cpp b/src/video_core/renderer_vulkan/vk_submission_gpu.cpp
new file mode 100644
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_submission_gpu.cpp
@@ -0,0 +1,181 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "video_core/renderer_vulkan/vk_submission_gpu.h"
+
+#include <array>
+#include <chrono>
+#include <charconv>
+#include <cmath>
+#include <cstring>
+#include <cstdlib>
+#include <fstream>
+#include <iomanip>
+#include <string_view>
+#include <utility>
+#include "common/logging.h"
+#include "video_core/gpu_timestamp_sample.h"
+#include "video_core/renderer_vulkan/vk_master_semaphore.h"
+#include "video_core/renderer_vulkan/vk_scheduler.h"
+#include "video_core/vulkan_common/vulkan_device.h"
+
+namespace Vulkan {
+namespace {
+double WallTime() {
+    return std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count();
+}
+u64 MonotonicNs() {
+    return static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+}
+
+SubmissionGpuTrace::SubmissionGpuTrace(const Device& device_, Scheduler& scheduler_,
+                                     std::filesystem::path output_directory)
+    : device{device_}, scheduler{scheduler_}, directory{"/tmp/nel3ab-submission-gpu"} {
+    if (!output_directory.empty()) {
+        directory = std::move(output_directory);
+    } else if (const char* home = std::getenv("HOME")) {
+        directory = std::filesystem::path{home} / "submission-gpu";
+    }
+    if (const char* value = std::getenv("EDEN_NX2_SUBMISSION_GPU_PERIOD")) {
+        u32 parsed{};
+        const auto [end, error] = std::from_chars(value, value + std::strlen(value), parsed);
+        // 2026-11-08: one-in60 sampling had measurable cost. The allowed1-6000
+        // range permits a separate sparse/cost diagnostic, never a transparency claim.
+        if (error != std::errc{} || end != value + std::strlen(value) || parsed == 0 || parsed > 6000) {
+            LOG_ERROR(HW_GPU, "Submission GPU timing unavailable: invalid period");
+            return;
+        }
+        period_frames = parsed;
+    }
+    if (const char* value = std::getenv("EDEN_NX2_SUBMISSION_GPU_MANUAL")) {
+        armed = std::string_view{value} != "1";
+    }
+    period_ns = device.GetPhysical().GetProperties().limits.timestampPeriod;
+    valid_bits = device.GetPhysical().GetQueueFamilyProperties().at(device.GetGraphicsFamily()).timestampValidBits;
+    if (!std::isfinite(period_ns) || period_ns <= 0 || valid_bits == 0 || valid_bits > 64 ||
+        !device.IsHostQueryResetSupported()) {
+        LOG_ERROR(HW_GPU, "Submission GPU timing unavailable: period={} bits={} reset={}",
+                  period_ns, valid_bits, device.IsHostQueryResetSupported());
+        return;
+    }
+    pool = device.GetLogical().CreateQueryPool({
+        .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO, .pNext = nullptr, .flags = 0,
+        .queryType = VK_QUERY_TYPE_TIMESTAMP, .queryCount = MaxIntervals * 2,
+        .pipelineStatistics = 0,
+    });
+    events.reserve(MaxIntervals);
+    std::filesystem::create_directories(directory);
+    supported = true;
+    LOG_INFO(HW_GPU, "Submission GPU timing ready: version=2 period_ns={} valid_bits={} interval={} max_intervals={}",
+             period_ns, valid_bits, period_frames, MaxIntervals);
+}
+
+u32 SubmissionGpuTrace::Begin(vk::CommandBuffer command, const char* category) {
+    const auto id = budget.Begin();
+    if (!id) return InvalidId;
+    events.push_back({category});
+    command.WriteTimestamp(VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, *pool, *id * 2);
+    return *id;
+}
+void SubmissionGpuTrace::End(vk::CommandBuffer command, u32 id) {
+    if (id != InvalidId && budget.End(id)) {
+        command.WriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, *pool, id * 2 + 1);
+    }
+}
+void SubmissionGpuTrace::BeginSubmit(vk::CommandBuffer execution, vk::CommandBuffer upload) {
+    if (!worker_active) return;
+    execution_id = Begin(execution, "execution");
+    upload_id = Begin(upload, "upload");
+}
+void SubmissionGpuTrace::EndSubmit(vk::CommandBuffer execution, vk::CommandBuffer upload) {
+    if (!worker_active) return;
+    End(execution, execution_id);
+    End(upload, upload_id);
+    execution_id = upload_id = InvalidId;
+}
+
+void SubmissionGpuTrace::WriteResults() {
+    using Sample = std::array<u64, 2>;
+    static_assert(sizeof(Sample) == 2 * sizeof(u64));
+    const u32 count = static_cast<u32>(events.size()) * 2;
+    std::vector<Sample> samples(count);
+    VkResult result = VK_SUCCESS;
+    if (count) {
+        result = device.GetLogical().GetQueryResults(*pool, 0, count,
+            samples.size() * sizeof(Sample), samples.data(), sizeof(Sample),
+            VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+    }
+    const u64 ready_ns = MonotonicNs();
+    bool complete = budget.Complete() && result == VK_SUCCESS;
+    const auto file = directory / ("capture-" + std::to_string(sequence++) + ".csv");
+    std::ofstream out(file);
+    out << std::setprecision(17);
+    out << "category,begin,end,begin_available,end_available,period_ns,valid_bits\n";
+    for (u32 i = 0; i < events.size(); ++i) {
+        const auto& a = samples[i * 2];
+        const auto& b = samples[i * 2 + 1];
+        complete &= VideoCommon::GpuTimestampNanoseconds(a[0], b[0], a[1] != 0,
+            b[1] != 0, valid_bits, period_ns).has_value();
+        out << events[i].category << ',' << a[0] << ',' << b[0] << ',' << a[1] << ',' << b[1]
+            << ',' << period_ns << ',' << valid_bits << '\n';
+    }
+    out.close();
+    complete &= out.good();
+    std::ofstream meta(file.string() + ".meta");
+    meta << std::setprecision(17);
+    meta << "format_version=2\ncomplete=" << complete << "\noverflow=" << budget.Overflow()
+         << "\nevents=" << events.size() << "\nframe=" << capture_frame
+         << "\nend_tick=" << end_tick << "\nstart_unix=" << start_unix
+         << "\nend_unix=" << end_unix << "\nbegin_monotonic_ns=" << begin_ns
+         << "\nrecording_closed_monotonic_ns=" << closed_ns
+         << "\nresults_ready_monotonic_ns=" << ready_ns << '\n';
+    LOG_INFO(HW_GPU, "Submission GPU capture: frame={} events={} queries={} complete={}",
+             capture_frame, events.size(), count, complete);
+}
+
+void SubmissionGpuTrace::Tick() {
+    if (!supported) return;
+    ++frame;
+    if (recording) {
+        closed_ns = MonotonicNs();
+        end_unix = WallTime();
+        scheduler.RecordWithUploadBuffer([this](vk::CommandBuffer execution, vk::CommandBuffer upload) {
+            EndSubmit(execution, upload);
+            worker_active = false;
+            recording_done.store(true, std::memory_order_release);
+        });
+        end_tick = scheduler.CurrentTick();
+        recording = false;
+        pending = true;
+    }
+    if (pending) {
+        if (!recording_done.load(std::memory_order_acquire)) return;
+        scheduler.GetMasterSemaphore().Refresh();
+        if (!scheduler.IsFree(end_tick)) return;
+        WriteResults();
+        pending = false;
+    }
+    if (!armed) {
+        const auto request = directory / "arm";
+        if (!std::filesystem::exists(request)) return;
+        std::filesystem::remove(request);
+        armed = true;
+        frame = 0;
+    }
+    // 2026-11-08: one-in60 was not transparent. At most128 captures bounds a
+    // private run; previous pending work skips sampling instead of waiting for it.
+    if (frame % period_frames != 0 || sequence >= 128) return;
+    budget = {};
+    events.clear();
+    capture_frame = frame;
+    begin_ns = MonotonicNs();
+    start_unix = WallTime();
+    device.GetLogical().ResetQueryPool(*pool, 0, MaxIntervals * 2);
+    recording_done.store(false, std::memory_order_relaxed);
+    scheduler.RecordWithUploadBuffer([this](vk::CommandBuffer execution, vk::CommandBuffer upload) {
+        worker_active = true;
+        BeginSubmit(execution, upload);
+    });
+    recording = true;
+}
+} // namespace Vulkan
