+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <limits>
+#include <span>
+#include "common/common_types.h"
+
+namespace VideoCommon {
+
+enum class Nx2MmeSource { Unknown, Copied, Synced };
+
+struct Nx2MmeSnapshotResult {
+    bool complete{};
+    u32 copied{};
+    u32 synced{};
+    u32 host_only{};
+};
+
+// Only reads copies after all preceding entries, including draws, have executed. This does
+// not grant scheduler ownership. Unknown/partial copies require the caller's original fallback.
+template <typename Translate, typename Mark, typename Wait, typename Written, typename Copy,
+          typename Guest>
+Nx2MmeSnapshotResult Nx2ReadMmeSnapshot(u64 address, std::span<u8> out,
+                                       Translate&& translate, Mark&& mark, Wait&& wait,
+                                       Written&& written, Copy&& copy, Guest&& guest) {
+    Nx2MmeSnapshotResult result;
+    if (out.empty()) {
+        result.complete = true;
+        return result;
+    }
+    if (address > std::numeric_limits<u64>::max() - out.size()) {
+        return result;
+    }
+    if ((address & 3) != 0 || (out.size() & 3) != 0) {
+        return result;
+    }
+    const u64 end = address + out.size();
+    const auto next = [end](u64 chunk) {
+        return chunk + std::min<u64>(0x1000 - (chunk & 0xfff), end - chunk);
+    };
+    // Mark before waiting: even a first GPU writer still in the queue must be tracked.
+    for (u64 chunk = address; chunk < end; chunk = next(chunk)) {
+        const auto device = translate(chunk);
+        if (!device) return result;
+        mark(*device);
+    }
+    wait();
+    for (u64 chunk = address; chunk < end; chunk = next(chunk)) {
+        const auto device = translate(chunk);
+        if (!device) return result;
+        auto part = out.subspan(static_cast<size_t>(chunk - address),
+                               static_cast<size_t>(next(chunk) - chunk));
+        // This test follows the barrier. A queued first write may have set the bit.
+        if (!written(*device)) {
+            guest(chunk, part);
+            ++result.host_only;
+            continue;
+        }
+        switch (copy(*device, part)) {
+        case Nx2MmeSource::Copied:
+            ++result.copied;
+            break;
+        case Nx2MmeSource::Synced:
+            guest(chunk, part);
+            ++result.synced;
+            break;
+        default:
+            return result;
+        }
+    }
+    result.complete = true;
+    return result;
+}
+
+} // namespace VideoCommon
