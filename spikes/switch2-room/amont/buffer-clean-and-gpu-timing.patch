diff --git a/src/tests/video_core/cpu_upload_summary.cpp b/src/tests/video_core/cpu_upload_summary.cpp
new file mode 100644
index 000000000..77faa8e0f
--- /dev/null
+++ b/src/tests/video_core/cpu_upload_summary.cpp
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <limits>
+#include <random>
+#include <catch2/catch_test_macros.hpp>
+#include "video_core/buffer_cache/word_manager.h"
+#include "video_core/gpu_timestamp_sample.h"
+
+namespace {
+struct Tracker {
+    void UpdatePagesCachedBatch(std::span<const std::pair<VAddr, size_t>> ranges, int) {
+        updates += ranges.size();
+    }
+    void UpdatePagesCachedCount(VAddr, size_t, int) { ++updates; }
+    size_t updates{};
+};
+constexpr u64 Page = VideoCommon::BYTES_PER_PAGE;
+constexpr u64 Word = VideoCommon::BYTES_PER_WORD;
+constexpr u64 Size = 128 * Word; // Exercises summary bits on both sides of word 64.
+using Manager = VideoCommon::WordManager<Tracker, 128, Size>;
+using Type = VideoCommon::Type;
+void Clear(Manager& manager, u64 address, u64 size) {
+    manager.ForEachModifiedRange(Type::CPU, true, address, size, [](u64, u64) {});
+}
+}
+
+TEST_CASE("Clean upload summary retains CPU writes and tracking changes", "[buffer_clean]") {
+    Tracker tracker;
+    Manager manager(0, tracker);
+    REQUIRE(manager.CpuUploadMayBeNeeded(0, Size));
+    Clear(manager, 0, Size);
+    REQUIRE_FALSE(manager.CpuUploadMayBeNeeded(0, Size));
+    manager.ChangeRegionState(Type::CPU, true, 63 * Word + Page, 1);
+    REQUIRE(manager.CpuUploadMayBeNeeded(63 * Word + Page, 1));
+    REQUIRE(manager.CpuUploadMayBeNeeded(63 * Word, 2 * Word));
+    REQUIRE_FALSE(manager.CpuUploadMayBeNeeded(64 * Word, Word));
+    Clear(manager, 63 * Word, Word);
+    REQUIRE_FALSE(manager.CpuUploadMayBeNeeded(0, Size));
+    manager.ChangeRegionState(Type::CPU, true, 64 * Word + Page, 1);
+    REQUIRE(manager.CpuUploadMayBeNeeded(63 * Word, 2 * Word));
+    REQUIRE(manager.CpuUploadMayBeNeeded(64 * Word + Page, Page));
+    Clear(manager, 64 * Word, Word);
+
+    manager.ChangeRegionState(Type::CachedCPU, true, Page, 1);
+    REQUIRE_FALSE(manager.IsRegionModified(Type::CPU, Page, 1));
+    REQUIRE(manager.IsRegionModified(Type::Untracked, Page, 1));
+    REQUIRE(manager.CpuUploadMayBeNeeded(Page, 1));
+    const auto updates_before = tracker.updates;
+    size_t uploads{};
+    manager.ForEachModifiedRange(Type::CPU, true, Page, Page,
+                                 [&](u64, u64) { ++uploads; });
+    REQUIRE(uploads == 0);
+    REQUIRE(tracker.updates > updates_before);
+    REQUIRE_FALSE(manager.CpuUploadMayBeNeeded(Page, Page));
+    // The delayed write is still pending even after tracking was rearmed without an upload.
+    manager.FlushCachedWrites();
+    REQUIRE(manager.IsRegionModified(Type::CPU, Page, 1));
+    REQUIRE(manager.CpuUploadMayBeNeeded(Page, 1));
+    Clear(manager, 0, Size);
+    REQUIRE_FALSE(manager.CpuUploadMayBeNeeded(0, Size));
+    manager.ChangeRegionState(Type::GPU, true, Page, Page);
+    REQUIRE_FALSE(manager.CpuUploadMayBeNeeded(Page, Page));
+    manager.ChangeRegionState(Type::CPU, true, Page, 1);
+    REQUIRE(manager.CpuUploadMayBeNeeded(Page, 1));
+    REQUIRE_FALSE(manager.CpuUploadMayBeNeeded(0, 0));
+    REQUIRE_FALSE(manager.CpuUploadMayBeNeeded(Size, 4));
+    REQUIRE(manager.CpuUploadMayBeNeeded(0, -1)); // Unknown ranges keep the original walk.
+}
+
+TEST_CASE("Clean upload summary never hides a dirty or untracked page", "[buffer_clean]") {
+    Tracker tracker;
+    Manager manager(0, tracker);
+    std::minstd_rand random{20261108};
+    for (size_t i = 0; i < 10000; ++i) {
+        const u64 offset = (random() % (Size / Page)) * Page;
+        const u64 size = std::min<u64>((1 + random() % 256) * Page, Size - offset);
+        switch (random() % 7) {
+        case 0: manager.ChangeRegionState(Type::CPU, true, offset, size); break;
+        case 1: manager.ChangeRegionState(Type::CPU, false, offset, size); break;
+        case 2: manager.ChangeRegionState(Type::CachedCPU, true, offset, size); break;
+        case 3: manager.FlushCachedWrites(); break;
+        case 4: Clear(manager, offset, size); break;
+        case 5: manager.ChangeRegionState(Type::GPU, true, offset, size); break;
+        case 6: manager.ChangeRegionState(Type::GPU, false, offset, size); break;
+        }
+        const bool dirty = manager.IsRegionModified(Type::CPU, offset, size) ||
+                           manager.IsRegionModified(Type::Untracked, offset, size);
+        REQUIRE((manager.CpuUploadMayBeNeeded(offset, size) || !dirty));
+    }
+    Clear(manager, 0, Size);
+    REQUIRE_FALSE(manager.CpuUploadMayBeNeeded(0, Size));
+}
+
+TEST_CASE("GPU timestamp conversion refuses unavailable or invalid samples", "[gpu_time]") {
+    using VideoCommon::GpuTimestampNanoseconds;
+    REQUIRE(GpuTimestampNanoseconds(10, 30, true, true, 64, 2.5) == 50.0);
+    REQUIRE(GpuTimestampNanoseconds(10, 10, true, true, 64, 1) == 0.0);
+    REQUIRE(GpuTimestampNanoseconds(0xfffffff0, 0x10, true, true, 32, 1) == 32.0);
+    REQUIRE(GpuTimestampNanoseconds(~u64{0} - 7, 8, true, true, 64, 1) == 16.0);
+    REQUIRE_FALSE(GpuTimestampNanoseconds(10, 30, false, true, 64, 1));
+    REQUIRE_FALSE(GpuTimestampNanoseconds(10, 30, true, false, 64, 1));
+    REQUIRE_FALSE(GpuTimestampNanoseconds(10, 30, true, true, 0, 1));
+    REQUIRE_FALSE(GpuTimestampNanoseconds(10, 30, true, true, 65, 1));
+    REQUIRE_FALSE(GpuTimestampNanoseconds(10, 30, true, true, 64, 0));
+    REQUIRE_FALSE(GpuTimestampNanoseconds(10, 30, true, true, 64, -1));
+    REQUIRE_FALSE(GpuTimestampNanoseconds(10, 30, true, true, 64,
+                                        std::numeric_limits<double>::quiet_NaN()));
+    REQUIRE_FALSE(GpuTimestampNanoseconds(10, 30, true, true, 64,
+                                        std::numeric_limits<double>::infinity()));
+}
diff --git a/src/video_core/buffer_cache/nx2_buffer_stats.h b/src/video_core/buffer_cache/nx2_buffer_stats.h
new file mode 100644
index 000000000..7aaab6a58
--- /dev/null
+++ b/src/video_core/buffer_cache/nx2_buffer_stats.h
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <span>
+#include <unordered_map>
+#include <vector>
+#include "common/common_types.h"
+#include "common/logging.h"
+
+namespace VideoCommon {
+
+enum class BufferUse : size_t { Other, Uniform, Storage, Vertex, Index, Indirect,
+                               ComputeUniform, ComputeStorage, Count };
+inline thread_local BufferUse buffer_stats_use{BufferUse::Other};
+inline bool BufferFastCleanEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_NX2_BUFFER_FAST_CLEAN");
+        return value != nullptr && value[0] == '1';
+    }();
+    return enabled;
+}
+
+struct Nx2BufferStats {
+    enum Counter : size_t { SyncCalls, EmptySyncs, RequestedBytes, DirtyPageBytes,
+        UploadCalls, UploadBytes, UploadRanges, ReportedCpuWrites, ReportedCpuBytes,
+        ForcedBankBytes, CachedWriteBytes, FlushCachedCalls, Samples, ComparableBytes,
+        DifferentBytes, EqualSamples, HistoryMisses, HistoryFull, SummaryChecks, SummarySkips, Count };
+    static bool Enabled() {
+        static const bool enabled = [] {
+            const char* value = std::getenv("EDEN_NX2_BUFFER_STATS");
+            return value != nullptr && value[0] == '1';
+        }();
+        return enabled;
+    }
+    static Nx2BufferStats& Get() { static Nx2BufferStats stats; return stats; }
+    static void Add(Counter counter, u64 value = 1) {
+        if (Enabled()) Get().counts[static_cast<size_t>(buffer_stats_use)][counter]
+            .fetch_add(value, std::memory_order_relaxed);
+    }
+    // GPU owner only. Diagnostic sampling compares CPU upload bytes, never validates a cache.
+    void Sample(u64 address, std::span<const u8> bytes) {
+        if ((++upload_serial & 15) != 0 || bytes.empty()) return;
+        // 2026-11-08: at most 4096 samples of 4096 bytes (16 MiB of byte payload).
+        // The deterministic 1/16 sample is partial evidence; misses/full history are reported.
+        bytes = bytes.first(std::min<size_t>(bytes.size(), 4096));
+        Add(Samples);
+        auto it = history.find(address);
+        if (it == history.end() || it->second.size() != bytes.size()) {
+            Add(HistoryMisses);
+            if (it == history.end() && history.size() >= 4096) { Add(HistoryFull); return; }
+            history[address] = std::vector<u8>(bytes.begin(), bytes.end());
+            return;
+        }
+        u64 different{};
+        for (size_t i = 0; i < bytes.size(); ++i) different += bytes[i] != it->second[i];
+        Add(ComparableBytes, bytes.size());
+        Add(DifferentBytes, different);
+        Add(EqualSamples, different == 0);
+        std::memcpy(it->second.data(), bytes.data(), bytes.size());
+    }
+    void Report() {
+        if (!Enabled()) return;
+        const u64 now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+        if (window_start == 0) { window_start = now; return; }
+        if (now - window_start < 10'000'000'000ULL) return;
+        static constexpr std::array names{"other","uniform","storage","vertex","index",
+                                          "indirect","compute_uniform","compute_storage"};
+        for (size_t use = 0; use < names.size(); ++use) {
+            std::array<u64, Count> values{};
+            for (size_t i = 0; i < Count; ++i)
+                values[i] = counts[use][i].exchange(0, std::memory_order_relaxed);
+            if (std::all_of(values.begin(), values.end(), [](u64 value) { return value == 0; }))
+                continue;
+            LOG_INFO(HW_GPU, "buffer stats: seconds={} use={} calls={} empty={} requested={} "
+                "dirty_page={} upload_calls={} uploaded={} ranges={} cpu_calls={} cpu_bytes={} "
+                "forced_bank={} cached_bytes={} flush_cached={} samples={} comparable={} "
+                "different={} equal_samples={} history_misses={} history_full={} summary_checks={} summary_skips={}",
+                double(now-window_start)/1e9, names[use], values[SyncCalls], values[EmptySyncs],
+                values[RequestedBytes], values[DirtyPageBytes], values[UploadCalls],
+                values[UploadBytes], values[UploadRanges], values[ReportedCpuWrites],
+                values[ReportedCpuBytes], values[ForcedBankBytes], values[CachedWriteBytes],
+                values[FlushCachedCalls], values[Samples], values[ComparableBytes],
+                values[DifferentBytes], values[EqualSamples], values[HistoryMisses],
+                values[HistoryFull], values[SummaryChecks], values[SummarySkips]);
+        }
+        window_start = now;
+    }
+    std::array<std::array<std::atomic<u64>, Count>, static_cast<size_t>(BufferUse::Count)> counts{};
+    std::unordered_map<u64,std::vector<u8>> history;
+    u64 upload_serial{}, window_start{};
+};
+
+struct BufferStatsUse {
+    explicit BufferStatsUse(BufferUse use) : previous{buffer_stats_use} {
+        if (Nx2BufferStats::Enabled()) buffer_stats_use = use;
+    }
+    ~BufferStatsUse() { if (Nx2BufferStats::Enabled()) buffer_stats_use = previous; }
+    BufferUse previous;
+};
+} // namespace VideoCommon
diff --git a/src/video_core/gpu_timestamp_sample.h b/src/video_core/gpu_timestamp_sample.h
new file mode 100644
index 000000000..d4d0b0fa1
--- /dev/null
+++ b/src/video_core/gpu_timestamp_sample.h
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <cmath>
+#include <optional>
+#include "common/common_types.h"
+
+namespace VideoCommon {
+inline std::optional<double> GpuTimestampNanoseconds(u64 begin, u64 end, bool begin_available,
+                                                    bool end_available, u32 valid_bits,
+                                                    double period_ns) {
+    if (!begin_available || !end_available || valid_bits == 0 || valid_bits > 64 ||
+        !std::isfinite(period_ns) || period_ns <= 0) return std::nullopt;
+    const u64 mask = valid_bits == 64 ? ~u64{0} : (u64{1} << valid_bits) - 1;
+    return static_cast<double>((end - begin) & mask) * period_ns;
+}
+} // namespace VideoCommon
diff --git a/src/video_core/renderer_vulkan/vk_gpu_timing.cpp b/src/video_core/renderer_vulkan/vk_gpu_timing.cpp
new file mode 100644
index 000000000..ba36a4c45
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_gpu_timing.cpp
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "video_core/renderer_vulkan/vk_gpu_timing.h"
+
+#include <array>
+#include <cstdlib>
+#include <iomanip>
+#include <fstream>
+#include "common/logging.h"
+#include "video_core/gpu_timestamp_sample.h"
+#include "video_core/renderer_vulkan/vk_scheduler.h"
+#include "video_core/vulkan_common/vulkan_device.h"
+
+namespace Vulkan {
+GpuTimingTrace::GpuTimingTrace(const Device& device_, Scheduler& scheduler_)
+    : device{device_}, scheduler{scheduler_}, hook{this, Begin, End},
+      directory{"/tmp/nel3ab-gpu-timing"} {
+    if (const char* home = std::getenv("HOME")) directory = std::filesystem::path{home} / "gpu-timing";
+    if (const char* path = std::getenv("EDEN_NX2_GPU_TIMING_DIR")) directory = path;
+    period_ns = device.GetPhysical().GetProperties().limits.timestampPeriod;
+    const auto queues = device.GetPhysical().GetQueueFamilyProperties();
+    valid_bits = queues.at(device.GetGraphicsFamily()).timestampValidBits;
+    if (period_ns <= 0 || valid_bits == 0 || valid_bits > 64 ||
+        !device.IsHostQueryResetSupported()) {
+        LOG_ERROR(HW_GPU, "GPU timing unavailable: period={} bits={} host_reset={}",
+                  period_ns, valid_bits, device.IsHostQueryResetSupported());
+        return;
+    }
+    pool = device.GetLogical().CreateQueryPool({
+        .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+        .pNext = nullptr, .flags = 0, .queryType = VK_QUERY_TYPE_TIMESTAMP,
+        .queryCount = MaxEvents * 2, .pipelineStatistics = 0});
+    events.reserve(MaxEvents);
+    std::filesystem::create_directories(directory);
+    supported = true;
+    LOG_INFO(HW_GPU, "GPU timing lab ready: period_ns={} valid_bits={} max_events={}",
+             period_ns, valid_bits, MaxEvents);
+}
+
+u32 GpuTimingTrace::Begin(void* context, VkCommandBuffer command,
+                           const vk::DeviceDispatch& dispatch, const char* category) noexcept {
+    auto& self = *static_cast<GpuTimingTrace*>(context);
+    if (self.events.size() >= MaxEvents) { ++self.dropped; return ~u32{0}; }
+    const u32 id = static_cast<u32>(self.events.size());
+    self.events.push_back({category, false});
+    dispatch.vkCmdWriteTimestamp(command, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, *self.pool, id * 2);
+    return id;
+}
+
+void GpuTimingTrace::End(void* context, VkCommandBuffer command,
+                         const vk::DeviceDispatch& dispatch, u32 id) noexcept {
+    auto& self = *static_cast<GpuTimingTrace*>(context);
+    dispatch.vkCmdWriteTimestamp(command, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                                 *self.pool, id * 2 + 1);
+    self.events[id].ended = true;
+}
+
+void GpuTimingTrace::WriteResults() {
+    using Sample = std::array<u64, 2>; // timestamp, availability, stride 16 bytes
+    static_assert(sizeof(Sample) == 2 * sizeof(u64));
+    const u32 count = static_cast<u32>(events.size()) * 2;
+    std::vector<Sample> samples(count);
+    VkResult result = VK_SUCCESS;
+    if (count != 0) result = device.GetLogical().GetQueryResults(*pool, 0, count,
+        samples.size() * sizeof(Sample), samples.data(), sizeof(Sample),
+        VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+    const auto filename = directory / ("capture-" + std::to_string(sequence++) + ".csv");
+    std::ofstream out(filename);
+    out << std::setprecision(17);
+    out << "category,begin,end,begin_available,end_available,period_ns,valid_bits\n";
+    bool complete = count != 0 && result == VK_SUCCESS && dropped == 0;
+    for (u32 i = 0; i < events.size(); ++i) {
+        const auto& a = samples[i * 2]; const auto& b = samples[i * 2 + 1];
+        complete &= events[i].ended && VideoCommon::GpuTimestampNanoseconds(
+            a[0], b[0], a[1] != 0, b[1] != 0, valid_bits, period_ns).has_value();
+        out << events[i].category << ',' << a[0] << ',' << b[0] << ',' << a[1] << ',' << b[1]
+            << ',' << period_ns << ',' << valid_bits << '\n';
+    }
+    out.close();
+    complete &= out.good();
+    std::ofstream meta(filename.string() + ".meta");
+    meta << "complete=" << complete << "\ndropped=" << dropped << "\nevents=" << events.size()
+         << "\nframe=" << capture_frame << "\nend_tick=" << end_tick << "\n";
+    LOG_INFO(HW_GPU, "GPU timing capture: frame={} events={} dropped={} complete={} file={}",
+             capture_frame, events.size(), dropped, complete, filename.string());
+}
+
+void GpuTimingTrace::Tick() {
+    if (!supported) return;
+    ++frame;
+    if (recording) {
+        scheduler.Record([this](vk::CommandBuffer) {
+            vk::gpu_timing_hook = nullptr;
+            recording_done.store(true, std::memory_order_release);
+        });
+        end_tick = scheduler.CurrentTick();
+        recording = false;
+        pending = true;
+    }
+    if (pending) {
+        // The worker publishes the metadata, and the whole submit must be complete before
+        // results are read or the pool reused. No GPU wait or new submit is introduced here.
+        if (!recording_done.load(std::memory_order_acquire) || !scheduler.IsFree(end_tick)) return;
+        WriteResults();
+        pending = false;
+    }
+    const auto request = directory / "request";
+    if (!std::filesystem::exists(request)) return;
+    std::filesystem::remove(request);
+    events.clear(); dropped = 0; capture_frame = frame;
+    device.GetLogical().ResetQueryPool(*pool, 0, MaxEvents * 2);
+    recording_done.store(false, std::memory_order_relaxed);
+    scheduler.Record([this](vk::CommandBuffer) { vk::gpu_timing_hook = &hook; });
+    recording = true;
+}
+} // namespace Vulkan
diff --git a/src/video_core/renderer_vulkan/vk_gpu_timing.h b/src/video_core/renderer_vulkan/vk_gpu_timing.h
new file mode 100644
index 000000000..9bb9b8867
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_gpu_timing.h
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <atomic>
+#include <filesystem>
+#include <vector>
+#include "common/common_types.h"
+#include "video_core/vulkan_common/vulkan_wrapper.h"
+
+namespace Vulkan {
+class Device;
+class Scheduler;
+
+class GpuTimingTrace {
+public:
+    GpuTimingTrace(const Device& device, Scheduler& scheduler);
+    void Tick();
+
+private:
+    struct Event { const char* category; bool ended{}; };
+    // 2026-11-08: 16384 command intervals, twice the existing 8192 draw-probe budget.
