 void FrameWriter::finish_frame(AVCodecContext *enc_ctx, AVPacket& pkt)
 {
+    // Private cloud-gaming ingress: preserve complete packet boundaries and
+    // the compositor clock. Raw Annex B requires the reader to await another
+    // frame to discover this one's end and loses its presentation timestamp.
+    // This branch is only for the video-only prototype. Ordinary recordings
+    // retain their muxer and timestamp origin when the environment is unset.
+    if (const char *pipe = getenv("NEL3AB_PACKET_PIPE"))
+    {
+        if (enc_ctx != videoCodecCtx || pkt.pts == AV_NOPTS_VALUE || pkt.size <= 0)
+        {
+            params.write_aborted_flag = true;
+            av_packet_unref(&pkt);
+            return;
+        }
+        static std::ofstream output(pipe, std::ios::binary);
+        uint64_t captured = av_rescale_q(pkt.pts, enc_ctx->time_base, US_RATIONAL);
+        uint32_t size = pkt.size;
+        unsigned char header[12];
+        for (int i = 0; i < 8; i++) header[i] = captured >> (i * 8);
+        for (int i = 0; i < 4; i++) header[8 + i] = size >> (i * 8);
+        output.write(reinterpret_cast<const char *>(header), sizeof(header));
+        output.write(reinterpret_cast<const char *>(pkt.data), pkt.size);
+        output.flush();
+        if (!output) params.write_aborted_flag = true;
+        av_packet_unref(&pkt);
+        return;
+    }
     static std::mutex fmt_mutex, pending_mutex;
 
     if (enc_ctx == videoCodecCtx)
@@ -917,6 +961,7 @@ void FrameWriter::finish_frame(AVCodecContext *enc_ctx, AVPacket& pkt)
 
