{
  "openapi": "3.1.0",
  "info": {
    "title": "nel3ab control",
    "summary": "Who is here, which game, which pad.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/me/connection": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Read My Connection",
        "description": "Seulement le pair établi par le proxy de confiance, aucun paramètre IP.",
        "operationId": "read_my_connection",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connection"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Read Me",
        "description": "L'identité que le proxy garantit, et le pseudo qui va avec.\n\nRend `login: null` quand aucun proxy n'est devant, ce qui est le cas en\ndéveloppement. Ce n'est pas une erreur: la page retombe alors sur un prénom\ngardé dans le navigateur, comme avant.",
        "operationId": "read_me",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "me"
        ],
        "summary": "Rename Me",
        "description": "Change son propre pseudo, et rien d'autre.\n\nLe pseudo est écrit sous l'adresse que le PROXY donne, jamais sous une\nadresse envoyée par le client: c'est la différence entre choisir son nom et\nchoisir celui de quelqu'un d'autre.",
        "operationId": "rename_me",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Identity"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/bindings": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Read Bindings",
        "description": "Les réglages de manette de celui qui demande.\n\nVides quand aucun proxy n'est devant: sans identité il n'y a pas de dossier à\nouvrir, et la page garde alors ses réglages dans le navigateur, comme avant.\nCe n'est pas une erreur, c'est la salle sans son proxy.",
        "operationId": "read_bindings",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bindings"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "me"
        ],
        "summary": "Keep Bindings",
        "description": "Garde ses propres réglages, et ceux de personne d'autre.\n\nSous l'adresse que le PROXY donne, jamais sous une adresse envoyée par le\nclient: c'est la même règle que pour le pseudo, et c'est la différence entre\nrégler sa manette et régler celle de quelqu'un d'autre.",
        "operationId": "keep_bindings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Bindings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bindings"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/room": {
      "get": {
        "tags": [
          "room"
        ],
        "summary": "Read Room",
        "description": "What is loaded, what else could be, who claims which pad, and who is here.",
        "operationId": "read_room",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Room"
                }
              }
            }
          }
        }
      }
    },
    "/api/room/bindings": {
      "get": {
        "tags": [
          "room"
        ],
        "summary": "Read Room Bindings",
        "description": "La configuration de référence de la salle.\n\nSans identité aussi, contrairement au dossier personnel: la référence est ce\nque la salle propose à qui entre, et exiger de savoir qui demande la rendrait\ninvisible exactement à ceux qui n'ont encore rien réglé.\n\nVide quand personne ne l'a publiée. La page se comporte alors comme avant.",
        "operationId": "read_room_bindings",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bindings"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "room"
        ],
        "summary": "Publish Room Bindings",
        "description": "Remplace la référence de la salle. Une seule personne le peut.\n\n# Pourquoi une adresse écrite dans la configuration et pas le propriétaire\n\nLa salle a déjà une notion de propriétaire, et elle ne convient pas ici: elle\nest faite pour décider du jeu en cours, elle change quand quelqu'un part, et\ndepuis peu elle se donne toute seule quand le propriétaire s'absente trois\nminutes. Rendre la référence modifiable par ce propriétaire-là voudrait dire\nque n'importe qui peut l'écraser pendant qu'on mange.\n\nUne référence à laquelle on veut pouvoir revenir QUOI QU'IL ARRIVE ne peut\npas dépendre d'un titre qui tourne. Elle dépend d'une adresse, écrite dans\nl'unité systemd, que rien dans la salle ne peut changer.\n\nVide veut dire personne, et c'est le défaut: une salle fraîchement déployée\nn'a pas de référence et se comporte exactement comme avant.",
        "operationId": "publish_room_bindings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Bindings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bindings"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Bindings": {
        "properties": {
          "switch": {
            "additionalProperties": true,
            "type": "object",
            "title": "Switch",
            "description": "Profils Switch personnels, séparés des commandes Dolphin."
          },
          "setups": {
            "additionalProperties": true,
            "type": "object",
            "title": "Setups",
            "description": "Profils personnels nommés : appareil, manette physique et touches."
          },
          "pads": {
            "additionalProperties": true,
            "type": "object",
            "title": "Pads",
            "description": "Un profil par manette, indexé par l'identifiant que le navigateur donne."
          },
          "keys": {
            "additionalProperties": true,
            "type": "object",
            "title": "Keys",
            "description": "Ce que chaque touche du clavier fait, indexé par sa POSITION physique."
          }
        },
        "type": "object",
        "title": "Bindings",
        "description": "Ce que quelqu'un a réglé sur ses manettes et son clavier.\n\nLe contenu est OPAQUE au service, et c'est délibéré. La forme d'un profil\nappartient à la page: elle sait ce qu'un axe, un repos et un signe veulent\ndire, et elle est la seule à s'en servir. La décrire ici en donnerait une\ndeuxième version à tenir d'accord avec la première, et il faudrait publier le\nservice pour ajouter un champ à une manette.\n\nCe qui est vérifié est ce qui protège le disque: un objet, sous un plafond\n(voir `BindingsController.CEILING`)."
      },
      "Connection": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "direct",
              "relay",
              "unknown"
            ],
            "title": "Kind",
            "default": "unknown"
          }
        },
        "type": "object",
        "title": "Connection",
        "description": "Une observation de trajet, jamais une mesure de qualité."
      },
      "Game": {
        "properties": {
          "guide": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GameGuide"
              },
              {
                "type": "null"
              }
            ]
          },
          "index": {
            "type": "integer",
            "title": "Index",
            "description": "Its position in the worker's library, which is how it is asked for."
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "What to call it on screen."
          },
          "maker": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maker",
            "description": "Qui l'a fait, tel que le disque le dit lui-même. Nul quand le disque n'a pas donné sa jaquette."
          },
          "about": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "About",
            "description": "La phrase que l'éditeur a écrite sur le disque. Peut contenir un retour à la ligne: ces textes ont été mis en page sur deux lignes."
          },
          "console": {
            "type": "string",
            "title": "Console",
            "description": "Quelle console ce disque demande, lue sur le disque: « gc », « wii », ou « ? » quand le disque n'a pas répondu. La page s'en sert pour ne pas proposer un choix qui ne déciderait rien: un jeu Wii n'a pas de carte mémoire, donc pas deux emplacements de sauvegarde. « ? » n'est pas « gc »: proposer un choix qui ne fait rien est pire que ne pas le proposer.",
            "default": "?"
          },
          "art": {
            "type": "boolean",
            "title": "Art",
            "description": "Vrai quand le worker sert une image pour ce jeu, à /art/{index}.png. Un booléen plutôt qu'une adresse: le chemin appartient au worker, et le recopier ici en ferait une deuxième vérité à tenir à jour.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "index",
          "name"
        ],
        "title": "Game",
        "description": "One game the room can run."
      },
      "GameGuide": {
        "properties": {
          "players": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 8.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Players"
          },
          "multiplayer": {
            "type": "string",
            "title": "Multiplayer",
            "default": ""
          },
          "devices": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Devices"
          },
          "checked": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checked"
          },
          "allowed": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Allowed"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "note": {
            "type": "string",
            "title": "Note"
          },
          "actions": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "object",
            "title": "Actions"
          }
        },
        "type": "object",
        "required": [
          "allowed",
          "source",
          "note",
          "actions"
        ],
        "title": "GameGuide"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Identity": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 24,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Identity",
        "description": "A person, as this service knows them.\n\nThere is no account and no password: rooms are private and shared with people\nalready on the network. The name exists so a seat can say \"Souhib\" rather than\n\"player 2\" (ADR D12)."
      },
      "Me": {
        "properties": {
          "login": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Login",
            "description": "L'adresse que Tailscale garantit, ou rien."
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Le pseudo, choisi et modifiable."
          },
          "display": {
            "type": "string",
            "title": "Display",
            "description": "Le nom que le fournisseur d'identité affiche, pour information.",
            "default": ""
          },
          "publishes": {
            "type": "boolean",
            "title": "Publishes",
            "description": "Cette personne peut-elle publier la configuration de référence de la salle ? Un booléen et non l'adresse de qui le peut: la page a besoin de savoir ce qu'ELLE peut faire, pas de connaître l'adresse de quelqu'un d'autre.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Me",
        "description": "Qui le service croit avoir en face.\n\n`login` vient du proxy et n'est pas modifiable; `name` est choisi et l'est.\nUn `login` nul veut dire « aucun proxy devant », donc aucune identité: la\npage retombe alors sur un prénom gardé dans le navigateur."
      },
      "Participant": {
        "properties": {
          "port": {
            "type": "integer",
            "title": "Port"
          },
          "claim": {
            "type": "string",
            "title": "Claim"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "pad": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pad"
          },
          "ready": {
            "type": "boolean",
            "title": "Ready",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "port",
          "claim"
        ],
        "title": "Participant"
      },
      "Person": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "login": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Login"
          },
          "seat": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seat",
            "description": "La manette qu'il tient, s'il en tient une."
          },
          "seat_pending": {
            "type": "boolean",
            "title": "Seat Pending",
            "description": "L'attribution reste à confirmer ; cette personne n'est pas un spectateur.",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Person",
        "description": "Quelqu'un dans la salle, qu'il tienne une manette ou non."
      },
      "Preparation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "game": {
            "type": "integer",
            "title": "Game"
          },
          "save": {
            "type": "integer",
            "title": "Save"
          },
          "starter": {
            "type": "string",
            "title": "Starter"
          },
          "allowed": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Allowed"
          },
          "players": {
            "items": {
              "$ref": "#/components/schemas/Participant"
            },
            "type": "array",
            "title": "Players"
          }
        },
        "type": "object",
        "required": [
          "game",
          "save",
          "starter",
          "allowed",
          "players"
        ],
        "title": "Preparation"
      },
      "Room": {
        "properties": {
          "preparation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Preparation"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "game": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Game"
              },
              {
                "type": "null"
              }
            ],
            "description": "What is loaded right now."
          },
          "library": {
            "items": {
              "$ref": "#/components/schemas/Game"
            },
            "type": "array",
            "title": "Library"
          },
          "seats": {
            "items": {
              "$ref": "#/components/schemas/Seat"
            },
            "type": "array",
            "title": "Seats"
          },
          "owner": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Person"
              },
              {
                "type": "null"
              }
            ],
            "description": "Le chef choisi après une reprise, sinon le premier arrivé encore connecté. Nul quand personne n'a d'identité, et la salle retombe alors sur sa règle d'avant, où tenir une manette suffit."
          },
          "people": {
            "items": {
              "$ref": "#/components/schemas/Person"
            },
            "type": "array",
            "title": "People",
            "description": "Tout le monde dans la salle, spectateurs compris. Les places ne disent que ceux qui jouent, et une salle où quelqu'un regarde sans manette avait l'air vide."
          },
          "ask_lasts": {
            "type": "number",
            "title": "Ask Lasts",
            "description": "Combien de secondes une demande de manette attend une réponse. Publié pour que le compte à rebours de la page soit le vrai, et non un nombre recopié qui finirait par ne plus correspondre.",
            "default": 10.0
          },
          "media_url": {
            "type": "string",
            "title": "Media Url",
            "description": "Where the browser opens its own video, sound and pad sockets. Empty means the page's own origin."
          }
        },
        "type": "object",
        "required": [
          "name",
          "library",
          "seats",
          "media_url"
        ],
        "title": "Room",
        "description": "The room, as a page needs to render it."
      },
      "Seat": {
        "properties": {
          "port": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Port"
          },
          "player": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Player",
            "description": "The name of whoever claims it, if anybody."
          },
          "held": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Held",
            "description": "Occupation lue chez le worker, ou inconnue sur un ancien worker."
          },
          "claim": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Claim",
            "description": "Repère de l'attribution actuelle. Ce n'est ni un nom ni un secret."
          }
        },
        "type": "object",
        "required": [
          "port"
        ],
        "title": "Seat",
        "description": "One of the room's pads, and who claims it."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
