+TEST_CASE("GPU sync shutdown drops real closures and releases later fences",
+          "[video_core][readtick_shutdown]") {
+    Fixture f;
+    std::vector<u32> order;
+    const auto first = f.gpu.RunOnGpuThread([&] { order.push_back(1); });
+    const auto second = f.gpu.RunOnGpuThread([&] { order.push_back(2); });
+    REQUIRE(second == first + 1);
+    REQUIRE(f.gpu.CurrentSyncRequestFence() < first);
+    f.gpu.TickWork();
+    f.gpu.WaitForSyncOperation(second);
+    REQUIRE(order == std::vector<u32>{1, 2});
+
+    auto captured = std::make_shared<u32>(3);
+    const std::weak_ptr<u32> lifetime = captured;
+    const auto pending = f.gpu.RunOnGpuThread([&, captured] { order.push_back(*captured); });
+    captured.reset();
+    REQUIRE_FALSE(lifetime.expired());
+    f.gpu.NotifyShutdown();
+    REQUIRE(lifetime.expired());
+    // The unmodified base blocks here: run this test with an external watchdog.
+    f.gpu.WaitForSyncOperation(pending);
+    REQUIRE(order == std::vector<u32>{1, 2});
+    const auto late = f.gpu.RunOnGpuThread([&] { order.push_back(4); });
+    f.gpu.WaitForSyncOperation(late);
+    REQUIRE(order == std::vector<u32>{1, 2});
+    f.gpu.NotifyShutdown();
+}
