diff --git a/src/tests/video_core/nx2_mme_snapshot.cpp b/src/tests/video_core/nx2_mme_snapshot.cpp
new file mode 100644
index 000000000..8d5a4c387
--- /dev/null
+++ b/src/tests/video_core/nx2_mme_snapshot.cpp
@@ -0,0 +1,187 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <array>
+#include <cstring>
+#include <functional>
+#include <iostream>
+#include <limits>
+#include <optional>
+#include <stdexcept>
+#ifndef NX2_MME_STANDALONE
+#include <catch2/catch_test_macros.hpp>
+#endif
+#include "video_core/buffer_cache/nx2_list_snapshot.h"
+#include "video_core/nx2_mme_snapshot.h"
+
+namespace {
+using VideoCommon::Nx2ListSnapshotState;
+using VideoCommon::Nx2MmeSource;
+
+void Check(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+
+void Metadata() {
+    Nx2ListSnapshotState state;
+    Check(!state.Synced(), "a new page is unknown");
+    Check(!state.CopyCurrent(false, 0, 4), "an absent copy is unknown");
+    state.NoteGpuWrite(true);
+    state.copy_writes = state.writes;
+    state.copy_begin = 16;
+    state.copy_end = 32;
+    Check(state.CopyCurrent(true, 16, 16), "a current covered copy is usable");
+    Check(!state.CopyCurrent(true, 15, 1), "uncovered beginning rejected");
+    Check(!state.CopyCurrent(true, 31, 2), "uncovered end rejected");
+    Check(!state.CopyCurrent(true, 33, 0), "offset beyond copy rejected");
+    Check(!state.CopyCurrent(true, 16, std::numeric_limits<size_t>::max()),
+          "overflowing range rejected");
+    state.NoteGpuWrite(true);
+    Check(!state.CopyCurrent(true, 16, 4), "a new GPU write invalidates the copy");
+    state.copy_writes = state.writes;
+    state.NoteHostWrite();
+    Check(!state.CopyCurrent(true, 16, 4), "a CPU write invalidates the copy");
+    Check(!state.Synced(), "a CPU write cannot sync other pending GPU bytes");
+    state.synced_writes = state.writes;
+    Check(state.Synced(), "whole-page download establishes guest memory");
+    state.NoteHostWrite();
+    Check(state.Synced(), "CPU-only writes keep a downloaded page synced");
+    state.NoteGpuWrite(false);
+    Check(!state.Synced(), "draw storage write invalidates guest memory");
+    state.NoteGpuWrite(true);
+    state.copy_writes = state.writes;
+    state.synced_writes = state.writes;
+    Check(!state.CopyCurrent(true, 16, 4), "draw-written pages remain conservative");
+    Check(!state.Synced(), "draw-written pages cannot bypass the fallback");
+    state = {};
+    Check(!state.Synced() && !state.CopyCurrent(false, 0, 4), "session reset forgets validity");
+}
+
+struct Memory {
+    std::array<u8, 8192> host{}, gpu{}, copies{};
+    std::array<Nx2ListSnapshotState, 2> state{};
+    std::array<bool, 2> written{}, marked{}, has_copy{};
+    std::function<void()> pending;
+    bool waited{};
+    int guest_reads{}, copy_reads{};
+    bool mapped{true};
+
+    void GpuWrite(size_t address, u8 value, bool collecting = true) {
+        const size_t page = address / 4096;
+        gpu.at(address) = value;
+        written.at(page) = true;
+        state.at(page).NoteGpuWrite(collecting);
+        if (collecting && marked.at(page)) {
+            copies = gpu;
+            has_copy[page] = true;
+            state[page].copy_writes = state[page].writes;
+            state[page].copy_begin = 0;
+            state[page].copy_end = 4096;
+        }
+    }
+    auto Read(u64 address, std::span<u8> out) {
+        waited = false;
+        return VideoCommon::Nx2ReadMmeSnapshot(address, out,
+            [&](u64 value) -> std::optional<u64> {
+                if (!mapped || value >= host.size()) return std::nullopt;
+                return value;
+            },
+            [&](u64 value) { marked.at(value / 4096) = true; },
+            [&] {
+                waited = true;
+                if (pending) { auto work = std::move(pending); pending = {}; work(); }
+            },
+            [&](u64 value) { return written.at(value / 4096); },
+            [&](u64 value, std::span<u8> part) {
+                ++copy_reads;
+                const size_t page = value / 4096;
+                if (state[page].Synced()) return Nx2MmeSource::Synced;
+                if (!state[page].CopyCurrent(has_copy[page], value % 4096, part.size()))
+                    return Nx2MmeSource::Unknown;
+                std::memcpy(part.data(), copies.data() + value, part.size());
+                return Nx2MmeSource::Copied;
+            },
+            [&](u64 value, std::span<u8> part) {
+                ++guest_reads;
+                std::memcpy(part.data(), host.data() + value, part.size());
+            });
+    }
+};
+
+void Reader() {
+    Memory memory;
+    std::array<u8, 4> out{};
+    memory.host[32] = 3;
+    auto result = memory.Read(32, out);
+    Check(result.complete && result.host_only == 1 && memory.waited && out[0] == 3,
+          "CPU-owned arguments read after queued entries");
+    memory.host[32] = 7;
+    result = memory.Read(32, out);
+    Check(result.complete && out[0] == 7 && memory.copy_reads == 0,
+          "same address must see changed CPU arguments");
+
+    memory.pending = [&] {
+        Check(memory.marked[0], "page must be marked before its queued first GPU write");
+        memory.GpuWrite(32, 19);
+    };
+    result = memory.Read(32, out);
+    Check(result.complete && result.copied == 1 && out[0] == 19,
+          "first queued GPU write must not read stale guest bytes");
+    for (u8 value = 20; value < 120; ++value) {
+        memory.pending = [&, value] { memory.GpuWrite(32, value); };
+        result = memory.Read(32, out);
+        Check(result.complete && out[0] == value, "every immediate GPU rewrite is visible");
+    }
+    memory.state[0].NoteHostWrite();
+    memory.host[33] = 99;
+    result = memory.Read(32, out);
+    Check(!result.complete, "partial CPU write invalidates old copy; fallback required");
+    memory.host = memory.gpu;
+    memory.state[0].synced_writes = memory.state[0].writes;
+    result = memory.Read(32, out);
+    Check(result.complete && result.synced == 1 && out[0] == 119,
+          "fully downloaded page can read guest memory");
+    memory.host[33] = 41;
+    memory.state[0].NoteHostWrite();
+    result = memory.Read(32, out);
+    Check(result.complete && out[1] == 41, "CPU rewrite of synced page is visible");
+
+    memory.pending = [&] { memory.GpuWrite(32, 121, false); };
+    result = memory.Read(32, out);
+    Check(!result.complete, "queued draw storage write requires conservative fallback");
+
+    Memory crossing;
+    std::array<u8, 8> cross_out{};
+    crossing.host[4092] = 8;
+    crossing.pending = [&] { crossing.GpuWrite(4096, 9); };
+    result = crossing.Read(4092, cross_out);
+    Check(result.complete && result.host_only == 1 && result.copied == 1 &&
+          cross_out[0] == 8 && cross_out[4] == 9, "cross-page read respects each page's source");
+    crossing.state[1].copy_begin = 2;
+    result = crossing.Read(4092, cross_out);
+    Check(!result.complete, "partial second-page copy rejects whole fast path");
+
+    result = crossing.Read(1, out);
+    Check(!result.complete && !crossing.waited, "unaligned input preserves per-word fallback");
+    result = crossing.Read(0, std::span{out}.first(3));
+    Check(!result.complete && !crossing.waited, "partial word preserves per-word fallback");
+
+    crossing.mapped = false;
+    result = crossing.Read(0, out);
+    Check(!result.complete && !crossing.waited, "unmapped input preserves fallback");
+    result = crossing.Read(std::numeric_limits<u64>::max() - 1, out);
+    Check(!result.complete && !crossing.waited, "overflow rejected before translation");
+    result = crossing.Read(0, std::span<u8>{});
+    Check(result.complete && !crossing.waited, "zero-size read touches no memory");
+}
+} // namespace
+
+#ifdef NX2_MME_STANDALONE
+int main() {
+    Metadata();
+    Reader();
+    std::cout << "MME snapshot tests passed\n";
+}
+#else
+TEST_CASE("NX2 list snapshots preserve invalidation", "[nx2_mme]") { Metadata(); }
+TEST_CASE("NX2 MME snapshots wait before choosing current data", "[nx2_mme]") { Reader(); }
+#endif
diff --git a/src/video_core/buffer_cache/nx2_list_snapshot.h b/src/video_core/buffer_cache/nx2_list_snapshot.h
new file mode 100644
index 000000000..464b79d4d
--- /dev/null
+++ b/src/video_core/buffer_cache/nx2_list_snapshot.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <cstddef>
+#include "common/common_types.h"
+
+namespace VideoCommon {
+
+// Metadata shared by the real buffer-cache copy and its invalidation tests.
+struct Nx2ListSnapshotState {
+    u64 writes{};
+    u64 copy_writes{};
+    u64 copy_tick{};
+    u64 synced_writes{~u64{0}};
+    u32 copy_begin{};
+    u32 copy_end{};
+    bool draw_written{};
+
+    void NoteGpuWrite(bool collecting) {
+        ++writes;
+        if (!collecting) draw_written = true;
+    }
+    void NoteHostWrite() {
+        const bool was_synced = synced_writes == writes;
+        ++writes;
+        if (was_synced) synced_writes = writes;
+    }
+    bool Synced() const {
+        return !draw_written && synced_writes == writes;
+    }
+    bool CopyCurrent(bool has_copy, u64 offset, size_t size) const {
+        return has_copy && !draw_written && copy_writes == writes &&
+               offset >= copy_begin && offset <= copy_end && size <= copy_end - offset;
+    }
+};
+
+} // namespace VideoCommon
