@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <atomic>
+#include <filesystem>
+#include <vector>
+#include "video_core/submission_gpu_budget.h"
+#include "video_core/vulkan_common/vulkan_wrapper.h"
+
+namespace Vulkan {
+class Device;
+class Scheduler;
+
+/// Optional timestamps around existing submissions, with no per-draw queries.
+class SubmissionGpuTrace {
+public:
+    static constexpr u32 InvalidId = ~u32{0};
+    SubmissionGpuTrace(const Device& device, Scheduler& scheduler,
+                       std::filesystem::path output_directory = {});
+    void Tick(); // Recording owner; in split mode this is GPUBack.
+    void BeginSubmit(vk::CommandBuffer execution, vk::CommandBuffer upload);
+    void EndSubmit(vk::CommandBuffer execution, vk::CommandBuffer upload);
+
+private:
+    // 2026-11-08: about150-160 existing submissions per sampled image, two
+    // intervals each. 1024 intervals bounds allocation and rejects excess;
+    // game commands are never dropped when this diagnostic fills its pool.
+    static constexpr u32 MaxIntervals = 1024;
+    struct Event { const char* category; };
+    u32 Begin(vk::CommandBuffer command, const char* category);
+    void End(vk::CommandBuffer command, u32 id);
+    void WriteResults();
+
+    const Device& device;
+    Scheduler& scheduler;
+    vk::QueryPool pool;
+    std::filesystem::path directory;
+    VideoCommon::SubmissionGpuBudget<MaxIntervals> budget;
+    std::vector<Event> events;
+    std::atomic<bool> recording_done{true};
+    double period_ns{}, start_unix{}, end_unix{};
+    u64 begin_ns{}, closed_ns{}, frame{}, capture_frame{}, end_tick{};
+    u32 valid_bits{}, period_frames{60}, sequence{};
+    u32 execution_id{InvalidId}, upload_id{InvalidId};
+    bool supported{}, recording{}, pending{}, worker_active{}, armed{true};
+};
+} // namespace Vulkan
diff --git a/src/video_core/submission_gpu_budget.h b/src/video_core/submission_gpu_budget.h
new file mode 100644
--- /dev/null
+++ b/src/video_core/submission_gpu_budget.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <algorithm>
+#include <array>
+#include <optional>
+#include <span>
+#include "common/common_types.h"
+namespace VideoCommon {
+template <size_t Capacity>
+class SubmissionGpuBudget {
+public:
+    std::optional<u32> Begin() {
+        if (count == Capacity) { overflow = true; return std::nullopt; }
+        ended[count] = false;
+        return static_cast<u32>(count++);
+    }
+    bool End(u32 id) {
+        if (id >= count || ended[id]) { invalid_end = true; return false; }
+        ended[id] = true;
+        return true;
+    }
+    bool Complete() const {
+        return count != 0 && !overflow && !invalid_end &&
+               std::all_of(ended.begin(), ended.begin() + count, [](bool v) { return v; });
+    }
+    size_t Count() const { return count; }
+    bool Overflow() const { return overflow; }
+private:
+    std::array<bool, Capacity> ended{};
+    size_t count{};
+    bool overflow{}, invalid_end{};
+};
+} // namespace VideoCommon
