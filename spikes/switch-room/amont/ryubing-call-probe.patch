new file mode 100644
index 00000000..c50242eb
--- /dev/null
+++ b/src/Ryujinx.Common/Nel3abCallProbe.cs
@@ -0,0 +1,75 @@
+using System;
+using System.Collections.Concurrent;
+using System.Diagnostics;
+using System.Linq;
+using System.Threading;
+
+namespace Ryujinx.Common
+{
+    /// <summary>
+    /// nel3ab: time spent per named call, one line a second on stderr when
+    /// NEL3AB_CALL_PROBE=1, the sixteen costliest calls of that second. Off by default.
+    /// </summary>
+    public static class Nel3abCallProbe
+    {
+        public static readonly bool Enabled = Environment.GetEnvironmentVariable("NEL3AB_CALL_PROBE") == "1";
+
+        private sealed class Slot
+        {
+            public long Count;
+            public long Ticks;
+            public long Max;
+        }
+
+        private static readonly ConcurrentDictionary<string, Slot> _slots = new();
+        private static Timer _timer;
+
+        public static long Start() => Enabled ? Stopwatch.GetTimestamp() : 0;
+
+        public static void Stop(string name, long start)
+        {
+            if (!Enabled)
+            {
+                return;
+            }
+
+            long duration = Stopwatch.GetTimestamp() - start;
+            Slot slot = _slots.GetOrAdd(name, _ => new Slot());
+            Interlocked.Increment(ref slot.Count);
+            Interlocked.Add(ref slot.Ticks, duration);
+
+            long max;
+            while (duration > (max = Volatile.Read(ref slot.Max)) && Interlocked.CompareExchange(ref slot.Max, duration, max) != max)
+            {
+            }
+
+            if (Volatile.Read(ref _timer) == null)
+            {
+                Timer timer = new(Report, null, 1000, 1000);
+                if (Interlocked.CompareExchange(ref _timer, timer, null) != null)
+                {
+                    timer.Dispose();
+                }
+            }
+        }
+
+        private static void Report(object state)
+        {
+            var seen = _slots
+                .Select(kv => (kv.Key, Count: Interlocked.Exchange(ref kv.Value.Count, 0), Ticks: Interlocked.Exchange(ref kv.Value.Ticks, 0), Max: Interlocked.Exchange(ref kv.Value.Max, 0)))
+                .Where(x => x.Count != 0)
+                .OrderByDescending(x => x.Ticks)
+                .Take(16)
+                .ToList();
+
+            if (seen.Count == 0)
+            {
+                return;
+            }
+
+            double ms(long ticks) => ticks * 1000.0 / Stopwatch.Frequency;
+            string line = string.Join(" ", seen.Select(x => $"{x.Key}={x.Count}/{ms(x.Ticks):F1}/{ms(x.Max):F1}"));
+            Console.Error.WriteLine($"NEL3AB_CALLS t_ns={Stopwatch.GetTimestamp()} {line}");
+        }
+    }
+}
