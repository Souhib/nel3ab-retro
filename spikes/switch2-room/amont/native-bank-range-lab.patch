+    REQUIRE(cache.Check(4097,65536,pages)==C::Decision::Refresh);
+    REQUIRE(cache.Check(4097,65536,pages)==C::Decision::Unchanged);
+    // The covered first byte is before the bank: compare the whole pages, not only the bank.
+    pages.front()=1;
+    REQUIRE(cache.Check(4097,65536,pages)==C::Decision::Refresh);
+    REQUIRE(cache.Check(4097,65536,pages)==C::Decision::Unchanged);
+    pages.back()=1;
+    REQUIRE(cache.Check(4097,65536,pages)==C::Decision::Refresh);
+    REQUIRE(cache.Check(4098,65536,pages)==C::Decision::Refresh);
+    REQUIRE(cache.Check(4097,65535,pages)==C::Decision::Refresh);
+    REQUIRE(cache.Check(4097,65536,{})==C::Decision::Refresh);
+}
+
+TEST_CASE("Native bank comparison forgets bounded entries between evictions and sessions", "[native_bank_contents]") {
+    using C=VideoCommon::NativeBankContents;
+    C cache;
+    std::vector<std::uint8_t> pages(65536,0);
+    for(std::size_t address=0;address<C::MaxKeys;++address) {
+        REQUIRE(cache.Check(address*C::PageSize,65536,pages)==C::Decision::Refresh);
+    }
+    REQUIRE(cache.TrackedKeys()==C::MaxKeys);
+    REQUIRE(cache.Check(C::MaxKeys*C::PageSize,65536,pages)==C::Decision::Refresh);
+    REQUIRE(cache.TrackedKeys()==1);
+    REQUIRE(cache.Check(0,65536,pages)==C::Decision::Refresh);
+    REQUIRE(cache.Check(0,65536,pages)==C::Decision::Unchanged);
+    std::vector<std::uint8_t> too_large(C::MaxBytes+1,0);
+    REQUIRE(cache.Check(0,too_large.size(),too_large)==C::Decision::Refresh);
+    C new_session;
+    REQUIRE(new_session.Check(0,65536,pages)==C::Decision::Refresh);
+    unsigned invalidations=0;
+    auto invalidate=[&]{++invalidations;};
+    REQUIRE_FALSE(cache.RefreshIfChanged(0,65536,pages,C::GpuHistory::Unwritten,invalidate));
+    REQUIRE(invalidations==0);
+    pages.back()=1;
+    REQUIRE(cache.RefreshIfChanged(0,65536,pages,C::GpuHistory::Unwritten,invalidate));
+    REQUIRE(invalidations==1);
+    REQUIRE(cache.RefreshIfChanged(0,65536,{},C::GpuHistory::Unwritten,invalidate));
+    REQUIRE(invalidations==2);
+    REQUIRE(cache.RefreshIfChanged(0,65536,pages,C::GpuHistory::Written,invalidate));
+    REQUIRE(invalidations==3);
+    cache.Reset();
+    REQUIRE(cache.RefreshIfChanged(0,65536,pages,C::GpuHistory::Unwritten,invalidate));
+    REQUIRE(invalidations==4);
+}
+
+TEST_CASE("Native bank statistics separate retained writes and effective skips", "[native_bank_contents]") {
+    using C=VideoCommon::NativeBankContents;
+    C cache;
+    std::vector<std::uint8_t> pages(65536,0);
+    auto invalidate=[]{};
+    REQUIRE(cache.RefreshIfChanged(4096,65536,pages,C::GpuHistory::Unwritten,invalidate));
+    REQUIRE_FALSE(cache.RefreshIfChanged(4096,65536,pages,C::GpuHistory::Unwritten,invalidate));
+    REQUIRE(cache.RefreshIfChanged(4096,65536,pages,C::GpuHistory::Written,invalidate));
+    cache.Reset(C::ResetReason::Create);
+    const auto& s=cache.Stats();
+    REQUIRE(s.calls==3);
+    REQUIRE(s.unchanged==1);
+    REQUIRE(s.gpu_written==1);
+    REQUIRE(s.compared==2);
+    REQUIRE(s.resets==1);
+    REQUIRE(s.nonempty==1);
+    REQUIRE(s.create==1);
+    REQUIRE(s.remove==0);
+    REQUIRE(cache.TrackedKeys()==0);
+}
+
+TEST_CASE("Native bank invalidation only forgets intersecting complete pages", "[native_bank_contents]") {
+    using C=VideoCommon::NativeBankContents;
+    using D=C::Decision;
+    C cache;
+    std::vector<std::uint8_t> pages(69632,0);
+    auto first=[&]{return cache.Check(4097,65536,pages);};
+    auto second=[&]{return cache.Check(131073,65536,pages);};
+    REQUIRE(first()==D::Refresh);
+    REQUIRE(second()==D::Refresh);
+    cache.InvalidateRange(400000,4096);
+    REQUIRE(first()==D::Unchanged);
+    REQUIRE(second()==D::Unchanged);
+    cache.InvalidateRange(73728,1);
+    REQUIRE(first()==D::Unchanged);
+    cache.InvalidateRange(4095,1);
+    REQUIRE(first()==D::Unchanged);
+    cache.InvalidateRange(4096,1,C::ResetReason::Clear);
+    REQUIRE(first()==D::Refresh);
+    REQUIRE(second()==D::Unchanged);
+    cache.InvalidateRange(73727,1);
+    REQUIRE(first()==D::Refresh);
+    REQUIRE(second()==D::Unchanged);
+    cache.InvalidateRange(5000,0);
+    REQUIRE(first()==D::Unchanged);
+    REQUIRE(cache.Stats().range_removed==2);
+    REQUIRE(cache.Stats().range_preserved>0);
+    cache.InvalidateRange(std::numeric_limits<std::uint64_t>::max()-1,4);
+    REQUIRE(first()==D::Refresh);
+    REQUIRE(second()==D::Refresh);
+}
