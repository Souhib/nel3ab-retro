+
+        /// <summary>
+        /// nel3ab: the size of the partially mapped set, at most one line a second,
+        /// when NEL3AB_CALL_PROBE=1.
+        /// </summary>
+        private static void Nel3abPartialGauge(int count)
+        {
+            if (!Ryujinx.Common.Nel3abCallProbe.Enabled)
+            {
+                return;
+            }
+
+            _nel3abGaugeMax = Math.Max(_nel3abGaugeMax, count);
+            long now = System.Diagnostics.Stopwatch.GetTimestamp();
+            if (now >= _nel3abGaugeAt)
+            {
+                _nel3abGaugeAt = now + System.Diagnostics.Stopwatch.Frequency;
+                Console.Error.WriteLine($"NEL3AB_PARTIAL t_ns={now} max={_nel3abGaugeMax}");
+                _nel3abGaugeMax = 0;
+            }
+        }
