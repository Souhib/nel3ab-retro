+struct ModeCase {
+    GpuFenceBehavior behavior;
+    GpuAccuracy accuracy;
+    bool immediate;
+};
+TEST_CASE("Payload query release obeys fence and accuracy guards", "[query_payload]") {
+    const auto mode = GENERATE(
+        ModeCase{GpuFenceBehavior::Default, GpuAccuracy::Low, true},
+        ModeCase{GpuFenceBehavior::Default, GpuAccuracy::High, false},
+        ModeCase{GpuFenceBehavior::Immediate, GpuAccuracy::Low, true},
+        ModeCase{GpuFenceBehavior::Immediate, GpuAccuracy::High, true},
+        ModeCase{GpuFenceBehavior::Balanced, GpuAccuracy::Low, false},
+        ModeCase{GpuFenceBehavior::Balanced, GpuAccuracy::High, false},
+        ModeCase{GpuFenceBehavior::Accurate, GpuAccuracy::Low, false},
+        ModeCase{GpuFenceBehavior::Accurate, GpuAccuracy::High, false});
+    CAPTURE(mode.behavior, mode.accuracy);
+    Fixture f;
+    Settings::values.gpu_fence_behavior.SetValue(mode.behavior);
+    Settings::values.current_gpu_accuracy = mode.accuracy;
+    f.Report();
+    REQUIRE(f.Read<u32>() == (mode.immediate ? 5 : 100));
+    REQUIRE(f.runtime.payload.FreeCount() == (mode.immediate ? 1 : 0));
+    REQUIRE(f.report_flags == std::vector<bool>{!mode.immediate});
+    f.Drain();
+    REQUIRE(f.Read<u32>() == 5);
+    REQUIRE(f.runtime.payload.FreeCount() == 1);
+}
