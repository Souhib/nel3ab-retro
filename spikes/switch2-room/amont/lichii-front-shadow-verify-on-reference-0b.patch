+TEST_CASE("Split verification counts genuine shadow and control faults after warning suppression",
+          "[.][front_shadow_diagnostics]") {
+    REQUIRE(std::getenv("EDEN_NX2_SPLIT_VERIFY") != nullptr);
+    Common::Log::Initialize();
+    Common::Log::SetColorConsoleBackendEnabled(false);
+    Common::Log::Filter filter{Common::Log::Level::Critical};
+    filter.SetClassLevel(Common::Log::Class::HW_GPU, Common::Log::Level::Info);
+    Common::Log::SetGlobalFilter(filter);
+    Common::Log::SetRingCapacity(4096);
+    SCOPE_EXIT {
+        Common::Log::SetRingCapacity(0);
+        Common::Log::Filter previous;
+        previous.ParseFilterString(Settings::values.log_filter.GetValue());
+        Common::Log::SetGlobalFilter(previous);
+        Common::Log::Stop();
+    };
+    using Control = Maxwell3D::Regs::ShadowRamControl;
+    Fixture f;
+    auto& engine = f.fast;
+    engine.SetNativeTuringMacroMode(true);
+    constexpr u32 state = 0x200;
+    constexpr u32 copy = MAXWELL3D_REG_INDEX(shadow_scratch) + 1;
+    REQUIRE_FALSE(engine.execution_mask[state]);
+    REQUIRE_FALSE(engine.execution_mask[copy]);
+    const u32 original_shadow = engine.shadow_state.reg_array[state];
+    const u32 wanted = original_shadow ^ 0x1234;
+    VideoCommon::GpuSplit split;
+    VideoCommon::GpuSplitTestAccess::Start(split, f.system);
+    SCOPE_EXIT { split.Stop(); };
+    const auto front = [&](u32 method, u32 value) {
+        engine.FrontCallMethod(f.system, split, method, value, true);
+    };
+    std::vector<u32> code;
+    const Mme read_state{.end = true, .op = {22, 0}, .src_a = {25, 24},
+                         .imm = {state, copy}, .out_method = {6, 0}, .out_emit = {1, 0}};
+    for (const auto instruction : {Encode(Mme{.end = true}), Encode(Mme{}),
+                                   Encode(read_state), Encode(Mme{})}) {
+        code.insert(code.end(), instruction.begin(), instruction.end());
+    }
+    front(MAXWELL3D_REG_INDEX(load_mme.instruction_ptr), 0);
+    engine.FrontCallMultiMethod(f.system, split, MAXWELL3D_REG_INDEX(load_mme.instruction),
+                                code.data(), code.size(), code.size());
+    front(MAXWELL3D_REG_INDEX(load_mme.start_address_ptr), 0);
+    front(MAXWELL3D_REG_INDEX(load_mme.start_address), 0);
+    front(MAXWELL3D_REG_INDEX(load_mme.start_address), 2);
+    front(ShadowControl, static_cast<u32>(Control::Track));
+    front(0xe00, 0); // Finish setup effects before leaving a later state write pending.
+    split.Drain();
+
+    u64 calls = 1;
+    const auto check = [&] {
+        const u64 next = (calls / 4096 + 1) * 4096;
+        while (calls < next) {
+            front(0xe00, 0);
+            ++calls;
+        }
+    };
+    struct Counts { unsigned long long checks{}, regular{}, shadow{}, control{}; };
+    const auto summary = [&] {
+        for (u32 i = 0; i < 64; ++i) check();
+        std::vector<std::string> summaries;
+        for (const auto& line : Common::Log::ReadRing(0)) {
+            const auto at = line.text.find("Split front register checks:");
+            if (at != std::string::npos) summaries.push_back(line.text.substr(at));
+        }
+        REQUIRE_FALSE(summaries.empty()); // Real FrontVerify ran, not just an inherited env flag.
+        Counts result;
+        REQUIRE(std::sscanf(summaries.back().c_str(),
+                            "Split front register checks: %llu done, %llu differences; "
+                            "%llu shadow differences, %llu control differences",
+                            &result.checks, &result.regular, &result.shadow, &result.control) == 4);
+        REQUIRE(result.checks > 0);
+        return result;
+    };
+    const auto before = summary();
+    bool owned = false;
+    const u32 shadow_value = wanted;
+    split.Run([&] {
+        owned = VideoCommon::GpuSplit::OnBackThread();
+        // Deliberately inconsistent back state, not entries owned by a legitimate back macro.
+        engine.regs.reg_array[0x300] ^= 1;
+        for (u32 i = 0; i < 20; ++i) engine.shadow_state.reg_array[state + i] ^= 0x1234;
+        engine.shadow_state.shadow_ram_control = Control::Passthrough;
+    });
+    REQUIRE(owned);
+    REQUIRE(engine.method_sink.empty());
+    check();
+    const auto after = summary();
+    REQUIRE(after.checks > before.checks);
+    REQUIRE(after.regular == before.regular + 1);
+    REQUIRE(after.shadow == before.shadow + 21); //20 words and the shadow-control register itself.
+    REQUIRE(after.control == before.control + 1);
+    u32 warnings = 0;
+    for (const auto& line : Common::Log::ReadRing(0)) {
+        warnings += line.text.find("Split front shadow register") != std::string::npos ||
+                    line.text.find("Split front shadow RAM control") != std::string::npos;
+    }
+    REQUIRE(warnings == 16); // Suppressed warnings must still contribute to the totals above.
+    front(ShadowControl, static_cast<u32>(Control::Replay));
+    front(state, 0xfeed);
+    front(ShadowControl, static_cast<u32>(Control::Passthrough));
+    front(0xe02, 0);
+    split.Drain();
+    REQUIRE(engine.regs.reg_array[copy] == shadow_value);
+}
