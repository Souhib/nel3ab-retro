+TEST_CASE("Inline state branch emits its activation only when actually selected",
+          "[.][state_write_activation]") {
+    Common::Log::Initialize();
+    Common::Log::SetColorConsoleBackendEnabled(false);
+    Common::Log::Filter filter{Common::Log::Level::Critical};
+    filter.SetClassLevel(Common::Log::Class::HW_GPU, Common::Log::Level::Info);
+    Common::Log::SetGlobalFilter(filter);
+    Common::Log::SetRingCapacity(4096);
+    SCOPE_EXIT {
+        Common::Log::SetRingCapacity(0);
+        Common::Log::Filter previous;
+        previous.ParseFilterString(Settings::values.log_filter.GetValue());
+        Common::Log::SetGlobalFilter(previous);
+        Common::Log::Stop();
+    };
+    const auto exact_one = [](const char* name) {
+        const char* value = std::getenv(name);
+        return value && value[0] == '1' && value[1] == '\0';
+    };
+    const bool force_slow = exact_one("NX2_STATE_TEST_SLOW");
+    Fixture f{!force_slow};
+    REQUIRE(f.fast.fast_maxwell3d == !force_slow);
+    REQUIRE_FALSE(f.fast.execution_mask[0x200]);
+    f.Call(0x200, 0x12345678, true);
+    f.Call(0x200, 0x12345679, true);
+    f.Compare();
+    REQUIRE(f.fast.regs.reg_array[0x200] == 0x12345679);
+    unsigned markers = 0;
+    for (const auto& line : Common::Log::ReadRing(0)) {
+        markers += line.text.find("Inline state register branch active (PR1095)") != std::string::npos;
+        REQUIRE(line.text.find("Nx2Perf method:") == std::string::npos);
+    }
+    const char* verify = std::getenv("EDEN_NX2_PERF_VERIFY");
+    const bool verifying = verify && verify[0] == '1';
+    REQUIRE(markers == (exact_one("EDEN_NX2_STATE_WRITE_TRACE") && !force_slow && !verifying ? 1 : 0));
+}
