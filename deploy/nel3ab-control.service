# The control plane: who is here, which game, which pad. Never a frame (ADR D12).
#
#   sudo cp deploy/nel3ab-control.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start nel3ab-control     # `enable` too, to survive a reboot
#   journalctl -u nel3ab-control -f
#
# It must be reachable at the SAME origin as the workers, because a worker
# refuses a WebSocket whose `Origin` is not its own `Host`, and because the page
# talks to both. One hostname, `nel3ab.app`, split on the path by Caddy
# (`deploy/Caddyfile`): `/r/<n>/` to room n, everything else to this service.
#
# The former `.ts.net:8443` door only redirects to `nel3ab.app` since
# 2026-11-21 (see the Caddyfile):
#
#   tailscale serve --bg --https=8443 http://127.0.0.1:8098
#   tailscale serve --bg --https=8444 http://127.0.0.1:8097
#
# Restarting this does not interrupt a game: the page keeps its picture, its
# sound and its pad, and loses only the names beside the seats until it comes
# back. That is the whole point of keeping it out of the media path.

[Unit]
Description=nel3ab control plane (rooms, names, seats)
After=network-online.target
Wants=network-online.target

[Service]
User=souhib
WorkingDirectory=/home/souhib/nel3ab-retro/control
# `--forwarded-allow-ips` dit à uvicorn de QUI il a le droit de croire
# `X-Forwarded-For`, et c'est la seule chose qui sépare « le proxy dit qui tu
# es » de « tu dis qui tu es ». C'est la valeur par défaut d'uvicorn, écrite ici
# parce qu'une règle d'identité qui repose sur un défaut implicite est une règle
# qui change le jour d'une mise à jour, sans que personne ne le lise.
ExecStart=/home/souhib/.local/bin/uv run uvicorn nel3ab_control.app:app --host 127.0.0.1 --port 8200 --forwarded-allow-ips 127.0.0.1
Environment=HOME=/home/souhib
# Un arrêt demandé n'est pas une panne.
#
# `SIGTERM` est ce que systemd envoie pour arrêter, et le programme sort alors
# en 143. Sans cette ligne, chaque `systemctl restart` laisse
# « Failed with result 'exit-code' » dans le journal: rien n'est cassé, mais une
# vraie panne y ressemble trait pour trait, et c'est le genre de bruit qui fait
# rater celle qui compte. Repéré le 29 août 2026 en cherchant pourquoi le salon
# avait « planté » le 26; il avait simplement redémarré.
SuccessExitStatus=143 SIGTERM
Restart=always
RestartSec=2

# L'identité vient du proxy, qui écrit `Tailscale-User-Login` sur chaque requête
# ET sur chaque montée en grade de WebSocket. Ça n'est une PREUVE que parce que
# ce service n'écoute que sur la boucle locale: un service joignable autrement
# accepterait l'en-tête de n'importe qui. Ne pas changer `--host` sans lire ça.
#
# Where the worker is, and what to call the room.
# La SALLE 1, et plus l'ancienne salle unique du port 8100.
#
# Depuis la bascule du 12 septembre 2026, les salles vivent sur 8110, 8120 et
# 8130. Le salon est resté pointé sur 8100 pendant une demi-heure: il rendait
# 503 sur toute la salle, donc la page n'avait ni places, ni noms, ni annonce de
# démarrage, et chaque préparation échouait par « la salle ne répond pas ».
#
# C'est un PANSEMENT: ce service ne connaît qu'une salle à la fois, et il en
# existe trois. La vraie réparation est qu'il sache de quelle salle chaque page
# lui parle.
Environment=NEL3AB_WORKER_URL=http://127.0.0.1:8110
# Le port de contrôle de la même salle. Son défaut, 8101, désignait lui aussi
# l'ancienne salle unique.
Environment=NEL3AB_WORKER_CONTROL=127.0.0.1:8111
Environment=NEL3AB_ROOM_NAME=lgf
# La seule adresse qui peut publier la configuration de référence de la salle.
#
# Ici et pas dans la salle, délibérément. La salle a déjà un propriétaire, et il
# ne convient pas: il change quand quelqu'un part, et depuis le 31 août 2026 il
# se donne tout seul quand celui qui le tient s'absente trois minutes. Une
# référence à laquelle on veut pouvoir revenir QUOI QU'IL ARRIVE ne peut pas
# dépendre d'un titre qui tourne.
#
# Vide veut dire personne, et c'est le défaut: une salle déployée ailleurs n'a
# pas de référence et se comporte comme avant.
Environment=NEL3AB_ADMIN=souhib.t@hotmail.fr
# Les origines admises au salon, en JSON. Jamais vide: vide veut dire « tout le
# monde » pour python-socketio, et n'importe quel site ouvert dans le navigateur
# d'un membre du tailnet parlait alors à la salle en son nom (5 septembre 2026).
# Une seule porte depuis le 21 novembre 2026: `nel3ab.app`. L'ancienne porte
# `.ts.net:8443` ne sert plus de page, elle renvoie vers ce nom; son origine
# n'a donc plus de raison d'écrire au salon, et elle est retirée. (Le
# 6 septembre 2026, quand elle servait encore la salle, l'oublier ici avait
# donné une manette sans nom à un ami.) Pour rouvrir cette porte en secours, la
# remettre ici en même temps.
# Guillemets simples autour de tout: systemd retire les guillemets doubles d'une
# valeur non protégée, et le JSON arrivait au service sans les siens.
Environment='NEL3AB_ORIGINS=["https://nel3ab.app"]'
# Les dossiers de jeux, la MÊME liste que `nel3ab-worker@.service`. Le dépôt
# de jeux (/importer) range un jeu dans le dossier qui porte le nom de sa
# console. Sans cette ligne, le salon ne connaîtrait que gc et wii, le défaut
# du worker, et la liste des deux services pourrait diverger sans bruit.
Environment="NEL3AB_ROM_DIR=/home/souhib/roms/gc:/home/souhib/roms/wii:/home/souhib/roms/switch:/home/souhib/roms/switch2"
# Le `prod.keys` privé du moteur Switch, le même que lit docker/switch-dlc.py.
# Le dépôt de jeux n'en lit que la ligne `header_key`, pour déchiffrer l'en-tête
# NCA d'un NSP ou d'un XCI et y lire son identifiant de titre: un jeu de base
# est alors rangé avec sa fiche, sans inscription à la main. Sans cette ligne,
# chaque jeu Switch déposé reste « à confirmer ». C'est un chemin, pas une clé:
# la clé ne quitte pas ce fichier, et le salon ne l'écrit nulle part.
Environment=NEL3AB_SWITCH_KEYS=/home/souhib/.local/share/nel3ab/switch/template/system/prod.keys
# Nothing about pads here on purpose: the worker reports how many the room has,
# in `/roms`, because it is what tells Dolphin which ports hold a controller.
# This file used to carry a second copy of that number, which had to agree with
# the worker and had nothing making it.

[Install]
WantedBy=multi-user.target
