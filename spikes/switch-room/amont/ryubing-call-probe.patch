+                Ryujinx.Common.Nel3abCallProbe.Stop("gmm.map.pte", probeStart);
 
+                probeStart = Ryujinx.Common.Nel3abCallProbe.Start();
                 RunRemapActions(e);
+                Ryujinx.Common.Nel3abCallProbe.Stop("gmm.map.remap", probeStart);
+            }
+        }
+
+        /// <summary>
+        /// nel3ab: the unmap handlers, each timed when NEL3AB_CALL_PROBE=1.
+        /// </summary>
+        private void InvokeUnmappedProbed(UnmapEventArgs e, string kind)
+        {
+            if (!Ryujinx.Common.Nel3abCallProbe.Enabled || MemoryUnmapped == null)
+            {
+                MemoryUnmapped?.Invoke(this, e);
+                return;
+            }
+
+            foreach (EventHandler<UnmapEventArgs> handler in MemoryUnmapped.GetInvocationList())
+            {
+                long probeStart = Ryujinx.Common.Nel3abCallProbe.Start();
+                handler(this, e);
+                Ryujinx.Common.Nel3abCallProbe.Stop($"gmm.{kind}.{handler.Method.DeclaringType?.Name}", probeStart);
             }
         }
 
