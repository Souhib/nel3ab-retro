+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <chrono>
+#include <cstdlib>
+#include <unordered_map>
+#include "common/common_types.h"
+#include "common/logging.h"
+
+namespace VideoCommon {
+// Opt-in diagnostics only. No guest bytes or addresses are logged.
+struct Nx2MmeReadStats {
+    static bool Enabled() {
+        static const bool enabled = [] {
+            const char* value = std::getenv("EDEN_NX2_MME_READ_STATS");
+            return value != nullptr && value[0] == '1';
+        }();
+        return enabled;
+    }
+    static Nx2MmeReadStats& Get() {
+        static thread_local Nx2MmeReadStats stats;
+        return stats;
+    }
+    static u64 Now() {
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(
+                   std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+    void Add(u64 source, u32 words, u64 hash, bool dirty, u64 gpu_pages,
+             u64 list_pages, u64 drain_ns, u64 flush_ns, u64 read_ns) {
+        const u64 now = Now();
+        if (start == 0) start = now;
+        ++calls;
+        bytes += u64{words} * 4;
+        dirty_calls += dirty;
+        written_pages += gpu_pages;
+        tracked_pages += list_pages;
+        drain_time += drain_ns;
+        flush_time += flush_ns;
+        read_time += read_ns;
+        const auto key = std::pair{source, words};
+        auto it = previous.find(key);
+        if (it != previous.end()) {
+            ++repeated;
+            if (it->second == hash) ++unchanged;
+            it->second = hash;
+        } else if (previous.size() < 4096) {
+            // Bounded diagnostic history, chosen 2026-11-08; overflow is counted, not reused.
+            previous.emplace(key, hash);
+        } else {
+            ++untracked;
+        }
+        if (now - start < 10'000'000'000ULL) return;
+        LOG_INFO(HW_GPU, "MME read stats: seconds={} calls={} bytes={} dirty={} repeated={} "
+                        "unchanged={} untracked={} gpu_pages={} list_pages={} drain_ms={} "
+                        "flush_ms={} read_ms={} snapshot_tries={} snapshot_hits={} "
+                        "snapshot_copied={} snapshot_synced={} snapshot_host={}",
+                 double(now-start)/1e9, calls, bytes, dirty_calls, repeated, unchanged, untracked,
+                 written_pages, tracked_pages, double(drain_time)/1e6,
+                 double(flush_time)/1e6, double(read_time)/1e6, snapshot_tries, snapshot_hits,
+                 snapshot_copied, snapshot_synced, snapshot_host);
+        start = now;
+        snapshot_tries = snapshot_hits = snapshot_copied = snapshot_synced = snapshot_host = 0;
+        calls = bytes = dirty_calls = repeated = unchanged = untracked = 0;
+        written_pages = tracked_pages = drain_time = flush_time = read_time = 0;
+    }
+    struct Hash {
+        size_t operator()(const std::pair<u64,u32>& key) const {
+            return std::hash<u64>{}(key.first) ^ (std::hash<u32>{}(key.second) << 1);
+        }
+    };
+    std::unordered_map<std::pair<u64,u32>,u64,Hash> previous;
+    u64 snapshot_tries{}, snapshot_hits{}, snapshot_copied{}, snapshot_synced{}, snapshot_host{};
+    u64 start{}, calls{}, bytes{}, dirty_calls{}, repeated{}, unchanged{}, untracked{};
+    u64 written_pages{}, tracked_pages{}, drain_time{}, flush_time{}, read_time{};
+};
+} // namespace VideoCommon
