diff --git a/src/tests/video_core/stream_ring_cursor.cpp b/src/tests/video_core/stream_ring_cursor.cpp
new file mode 100644
index 000000000..776575414
--- /dev/null
+++ b/src/tests/video_core/stream_ring_cursor.cpp
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <algorithm>
+#include <array>
+#include <random>
+#include <catch2/catch_test_macros.hpp>
+#include "video_core/renderer_vulkan/stream_ring_cursor.h"
+
+TEST_CASE("Stream ring rejects repeated busy wraps until the GPU completes", "[stream_ring]") {
+    Vulkan::StreamRingCursor<4> ring{4096};
+    for (std::size_t i=0; i<7; ++i) {
+        const auto offset=ring.Reserve(512,256,1,0);
+        REQUIRE(offset.has_value());
+        REQUIRE(*offset==i*512);
+    }
+    REQUIRE_FALSE(ring.Reserve(512,256,2,0).has_value());
+    REQUIRE_FALSE(ring.Reserve(512,256,2,0).has_value());
+    REQUIRE(ring.Wraps()==0);
+    const auto resumed=ring.Reserve(512,256,2,1);
+    REQUIRE(resumed.has_value());
+    REQUIRE(*resumed==0);
+    REQUIRE(ring.Wraps()==1);
+}
+
+TEST_CASE("Independent stream rings never overlap GPU work still in flight", "[stream_ring]") {
+    std::array<Vulkan::StreamRingCursor<4>,2> rings{
+        Vulkan::StreamRingCursor<4>{4096}, Vulkan::StreamRingCursor<4>{4096}};
+    std::array<std::array<std::uint64_t,4096>,2> writers{};
+    std::minstd_rand random{20261109};
+    unsigned accepted=0,rejected=0;
+    for (std::uint64_t tick=1; tick<=5000; ++tick) {
+        const std::size_t index=random()%2;
+        const std::size_t size=1+random()%1024;
+        const std::uint64_t completed=tick>20 ? tick-20 : 0;
+        const auto offset=rings[index].Reserve(size,256,tick,completed);
+        if (!offset) { ++rejected; continue; }
+        ++accepted;
+        REQUIRE(*offset%256==0);
+        REQUIRE(*offset+size<=writers[index].size());
+        for (std::size_t byte=*offset; byte<*offset+size; ++byte) {
+            REQUIRE(writers[index][byte]<=completed);
+            writers[index][byte]=tick;
+        }
+    }
+    REQUIRE(accepted>0);
+    REQUIRE(rejected>0);
+    REQUIRE(rings[0].Wraps()>0);
+    REQUIRE(rings[1].Wraps()>0);
+}
+
+TEST_CASE("Stream ring refuses invalid geometry before reserving memory", "[stream_ring]") {
+    REQUIRE_THROWS_AS((Vulkan::StreamRingCursor<4>{0}), std::invalid_argument);
+    REQUIRE_THROWS_AS((Vulkan::StreamRingCursor<4>{4097}), std::invalid_argument);
+    Vulkan::StreamRingCursor<4> ring{4096};
+    REQUIRE_FALSE(ring.Reserve(1025,256,1,0).has_value());
+    REQUIRE_FALSE(ring.Reserve(512,0,1,0).has_value());
+    const auto valid=ring.Reserve(512,256,1,0);
+    REQUIRE(valid.has_value());
+    REQUIRE(*valid==0);
+}
diff --git a/src/video_core/renderer_vulkan/stream_ring_cursor.h b/src/video_core/renderer_vulkan/stream_ring_cursor.h
new file mode 100644
index 000000000..1e7b88416
--- /dev/null
+++ b/src/video_core/renderer_vulkan/stream_ring_cursor.h
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <stdexcept>
+
+namespace Vulkan {
+// Allocation bookkeeping only. The caller owns the buffer and supplies completed GPU ticks.
+template <std::size_t Regions>
+class StreamRingCursor {
+public:
+    static_assert(Regions > 1, "A stream ring needs a current and a following region");
+    explicit StreamRingCursor(std::size_t capacity_) : capacity{capacity_}, region_size{capacity / Regions} {
+        if (capacity == 0 || capacity % Regions != 0) {
+            throw std::invalid_argument("Stream ring capacity must contain complete regions");
+        }
+    }
+
+    std::optional<std::size_t> Reserve(std::size_t size, std::size_t alignment,
+                                       std::uint64_t tick, std::uint64_t completed) {
+        if (alignment == 0 || alignment > region_size || size > region_size) {
+            return std::nullopt;
+        }
+        const auto region = [this](std::size_t offset) { return offset / region_size; };
+        const auto active = [&](std::size_t begin, std::size_t end) {
+            return std::any_of(ticks.begin() + begin, ticks.begin() + end,
+                               [completed](std::uint64_t used_tick) { return completed < used_tick; });
+        };
+        if (active(region(free_position) + 1, std::min(region(position + size) + 1, Regions))) {
+            return std::nullopt;
+        }
+        // Check before changing any cursor: a rejected wrap must remain rejected on retry.
+        if (position + size >= capacity && active(0, region(size) + 1)) {
+            return std::nullopt;
+        }
+        std::fill(ticks.begin() + region(used_position), ticks.begin() + region(position), tick);
+        used_position = position;
+        free_position = std::max(free_position, position + size);
+        if (position + size >= capacity) {
+            std::fill(ticks.begin() + region(used_position), ticks.end(), tick);
+            used_position = 0;
+            position = 0;
+            free_position = size;
+            ++wraps;
+        }
+        const std::size_t offset = position;
+        position = ((position + size + alignment - 1) / alignment) * alignment;
+        return offset;
+    }
+    unsigned Wraps() const { return wraps; }
+private:
+    std::size_t capacity;
+    std::size_t region_size;
+    std::size_t position{}, used_position{}, free_position{};
+    std::array<std::uint64_t, Regions> ticks{};
+    unsigned wraps{};
+};
+}
