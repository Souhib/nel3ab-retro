+TEST_CASE("PR1216 actual back macro sees queued words and front reads its owned condition",
+          "[video_core][gpu_split_dependencies][pr1216]") {
+    using Access = VideoCommon::GpuSplitTestAccess;
+    namespace FastDraw = VideoCommon::Nx2FastDraw;
+    Fixture f;
+    f.system.Initialize();
+    Kernel::KProcess process{f.system.Kernel()};
+    SCOPE_EXIT { f.system.Kernel().UnregisterKernelObject(&process); };
+    auto& table = process.GetPageTable().GetImpl();
+    table.Resize(20, 12);
+    constexpr VAddr cpu = 0x4000;
+    constexpr DAddr device = 0x10000;
+    constexpr GPUVAddr address = 0x100000;
+    auto* backing = f.physical.GetPointerFromRaw<u8>(0x10000);
+    table.entries.GetAndFault(cpu >> 12).Store(false, Common::PageType::Memory, 1,
+        reinterpret_cast<uintptr_t>(backing) - cpu);
+    process.GetMemory().SetCurrentPageTable(process);
+    const auto asid = f.device_memory.RegisterProcess(&process.GetMemory());
+    f.device_memory.BindInterface(&f.rasterizer);
+    f.device_memory.Map(device, cpu, 0x1000, asid);
+    SCOPE_EXIT { f.device_memory.Unmap(device, 0x1000); f.device_memory.UnregisterProcess(asid); };
+    f.memory.BindRasterizer(&f.rasterizer);
+    f.memory.Map(address, device, 0x1000, Tegra::PTEKind::PITCH, false);
+    std::memset(backing, 0, 0x1000);
+    auto& engine = f.fast;
+    engine.SetNativeTuringMacroMode(true);
+    VideoCommon::GpuSplit split;
+    Access::Start(split, f.system);
+    SCOPE_EXIT { split.Stop(); };
+    const bool previous = FastDraw::Enabled();
+    FastDraw::SetEnabledForTest(true);
+    SCOPE_EXIT { FastDraw::SetEnabledForTest(previous); FastDraw::g_delta = {}; };
+    const auto front = [&](u32 method, u32 value, bool last = true) {
+        engine.FrontCallMethod(f.system, split, method, value, last);
+    };
+    constexpr u32 condition = MAXWELL3D_REG_INDEX(render_enable.mode);
+    constexpr u32 copy = MAXWELL3D_REG_INDEX(vertex_id_base);
+    const Mme read_condition{.end = true, .op = {22, 0}, .src_a = {25, 24},
+                             .imm = {condition, copy}, .out_method = {6, 0},
+                             .out_emit = {1, 0}};
+    std::vector<u32> code;
+    for (const auto instruction : {FifoInstruction(0x154, false), FifoInstruction(0x155, false),
+          FifoInstruction(0x158, true), FifoInstruction(condition, false),
+          Encode(read_condition), Encode(Mme{})}) {
+        code.insert(code.end(), instruction.begin(), instruction.end());
+    }
+    front(MAXWELL3D_REG_INDEX(load_mme.instruction_ptr), 0);
+    engine.FrontCallMultiMethod(f.system, split, MAXWELL3D_REG_INDEX(load_mme.instruction),
+                               code.data(), static_cast<u32>(code.size()), static_cast<u32>(code.size()));
+    front(MAXWELL3D_REG_INDEX(load_mme.start_address_ptr), 0);
+    front(MAXWELL3D_REG_INDEX(load_mme.start_address), 0);
+    front(MAXWELL3D_REG_INDEX(load_mme.start_address), 4);
+    front(MAXWELL3D_REG_INDEX(render_enable_override), 0);
+    front(condition, 0);
+    split.Drain();
+    for (const u32 value : {1U, 0U}) {
+        const u64 serial = FastDraw::Serial();
+        split.Defer([memory = &f.memory, value] { memory->Write<u32>(address, value); },
+                    VideoCommon::GpuSplit::FastDrawNeutral);
+        front(0xe00, 0, false);
+        front(0xe01, static_cast<u32>(address), false);
+        front(0xe01, 1);
+        // This macro runs on the front. Its register read must take the condition
+        // from the back's queued macro, not the front's previous cached value.
+        front(0xe02, 0);
+        split.Drain();
+        CHECK(engine.ShouldExecute() == (value != 0));
+        CHECK(engine.regs.vertex_id_base == value);
+        CHECK(FastDraw::Serial() == serial);
+    }
