@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <catch2/catch_test_macros.hpp>
+#include <array>
+#include "video_core/single_list_batch.h"
+TEST_CASE("Single list copies defer only on their unsplit native owner inside the window", "[single_list]") {
+    using C = VideoCommon::ListCopyBatchConditions;
+    constexpr C good{true,true,false,2000,1999};
+    REQUIRE(VideoCommon::DeferSingleListCopy(good));
+    REQUIRE(VideoCommon::DeferSingleListCopy({true,true,false,2000,0}));
+    REQUIRE_FALSE(VideoCommon::DeferSingleListCopy({false,true,false,2000,1}));
+    REQUIRE_FALSE(VideoCommon::DeferSingleListCopy({true,false,false,2000,1}));
+    REQUIRE_FALSE(VideoCommon::DeferSingleListCopy({true,true,true,2000,1}));
+    REQUIRE_FALSE(VideoCommon::DeferSingleListCopy({true,true,false,0,0}));
+    REQUIRE_FALSE(VideoCommon::DeferSingleListCopy({true,true,false,2000,2000}));
+    REQUIRE_FALSE(VideoCommon::DeferSingleListCopy({true,true,false,2000,-1}));
+}
+TEST_CASE("A list-copy read submits queued writes before waiting on the owner", "[single_list]") {
+    int source=31, device=0, host=0, submits=0, waits=0;
+    auto submit=[&] { device=source;host=device;++submits; };
+    auto wait=[&] { ++waits; REQUIRE(host==source); };
+    VideoCommon::WaitForSingleListCopy(true,false,submit,wait);
+    REQUIRE(submits==1); REQUIRE(waits==1); REQUIRE(host==31);
+    source=47;device=47;host=47;
+    VideoCommon::WaitForSingleListCopy(true,true,submit,wait);
+    REQUIRE(submits==1); REQUIRE(waits==2); REQUIRE(host==47);
+    VideoCommon::WaitForSingleListCopy(false,true,submit,wait);
+    REQUIRE(submits==1); REQUIRE(waits==3);
+    bool external_waited=false;
+    VideoCommon::WaitForSingleListCopy(false,false,[&] { FAIL("non-owner must not submit"); },[&] { external_waited=true; });
+    REQUIRE(external_waited); REQUIRE(submits==1);
+}
+
+TEST_CASE("A list return submits pending copies once only on the enabled owner", "[single_list]") {
+    int calls=0;
+    auto pending=[&] { ++calls; return true; };
+    REQUIRE(VideoCommon::SubmitListCopiesAtReturn(true,true,pending));
+    REQUIRE(calls==1);
+    REQUIRE_FALSE(VideoCommon::SubmitListCopiesAtReturn(false,true,pending));
+    REQUIRE_FALSE(VideoCommon::SubmitListCopiesAtReturn(true,false,pending));
+    REQUIRE(calls==1);
+    REQUIRE_FALSE(VideoCommon::SubmitListCopiesAtReturn(true,true,[&] { ++calls; return false; }));
+    REQUIRE(calls==2);
+}
diff --git a/src/video_core/single_list_batch.h b/src/video_core/single_list_batch.h
new file mode 100644
index 000000000..d50ee49fc
--- /dev/null
+++ b/src/video_core/single_list_batch.h
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <utility>
+#include "common/common_types.h"
+namespace VideoCommon {
+struct ListCopyBatchConditions {
+    bool native_title;
+    bool scheduler_owner;
+    bool split_active;
+    s64 window_us;
+    s64 elapsed_us;
+};
+constexpr bool DeferSingleListCopy(ListCopyBatchConditions c) {
+    return c.native_title && c.scheduler_owner && !c.split_active && c.window_us > 0 &&
+           c.elapsed_us >= 0 && c.elapsed_us < c.window_us;
+}
+template <typename Flush>
+bool SubmitListCopiesAtReturn(bool enabled, bool owner, Flush&& flush) {
+    return enabled && owner && std::forward<Flush>(flush)();
+}
+
+// Only the scheduler owner may submit. Other threads keep the existing wait path.
+template <typename Submit, typename Wait>
+void WaitForSingleListCopy(bool owner, bool submitted, Submit&& submit, Wait&& wait) {
+    if (owner && !submitted) std::forward<Submit>(submit)();
+    std::forward<Wait>(wait)();
+}
+} // namespace VideoCommon
