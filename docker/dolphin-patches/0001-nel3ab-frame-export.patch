+// Copyright 2026 nel3ab-retro
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "VideoBackends/Vulkan/VKFrameExport.h"
+
+// <cerrno> for the EAGAIN check on the per-frame send, and CommonTypes for the
+// u32/u64 spellings Dolphin uses everywhere. Both are named explicitly rather
+// than relied on transitively: this file has not been compiled yet, and a
+// missing include is the cheapest kind of failure to pre-empt.
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include "Common/CommonTypes.h"
+#include "Common/Logging/Log.h"
+#include "Common/MathUtil.h"
+#include "VideoBackends/Vulkan/CommandBufferManager.h"
+#include "VideoBackends/Vulkan/VKGfx.h"
+#include "VideoBackends/Vulkan/VKTexture.h"
+#include "VideoBackends/Vulkan/VulkanContext.h"
+#include "VideoCommon/AbstractTexture.h"
+#include "VideoCommon/FrameDumper.h"
+
+namespace Vulkan::FrameExport
+{
+namespace
+{
+// fourcc_code('A','B','2','4'). Spelled out rather than pulled from
+// <drm_fourcc.h> so the patch adds no build dependency: VK_FORMAT_R8G8B8A8_UNORM
+// puts red in the lowest byte, which is DRM's ABGR8888.
+constexpr u32 DRM_FORMAT_ABGR8888 = 0x34324241;
+
+constexpr u32 HEADER_MAGIC = 0x3341424e;  // 'N3AB'
+constexpr u32 FRAME_MAGIC = 0x454d5246;   // 'FRME'
+constexpr u32 PROTOCOL_VERSION = 1;
+
+// Sent once, with the dma-buf fd attached, when the image is created — and
+// again if the frame size ever changes, since that reallocates it.
+#pragma pack(push, 1)
+struct Header
+{
+  u32 magic;
+  u32 version;
+  u32 width;
+  u32 height;
+  u32 drm_format;
+  u32 reserved;
+  u64 modifier;
+  u64 offset;
+  u64 pitch;
+  u64 size;
+};
+
+struct FrameReady
+{
+  u32 magic;
+  u32 reserved;
+  u64 frame_number;
+};
+#pragma pack(pop)
+
+struct State
+{
+  int socket = -1;
+  VkImage image = VK_NULL_HANDLE;
+  VkDeviceMemory memory = VK_NULL_HANDLE;
+  int dmabuf = -1;
+  u32 width = 0;
+  u32 height = 0;
+  u64 frame = 0;
+  // The image is created once and reused; every frame after the first has to
+  // acquire it back from the consumer rather than start from UNDEFINED.
+  bool ever_written = false;
+};
+
+State s_state;
+
+void ReleaseImage()
+{
+  const VkDevice device = g_vulkan_context ? g_vulkan_context->GetDevice() : VK_NULL_HANDLE;
+  if (device != VK_NULL_HANDLE)
+  {
+    if (s_state.image != VK_NULL_HANDLE)
+      vkDestroyImage(device, s_state.image, nullptr);
+    if (s_state.memory != VK_NULL_HANDLE)
+      vkFreeMemory(device, s_state.memory, nullptr);
+  }
+  if (s_state.dmabuf >= 0)
+    close(s_state.dmabuf);
+  s_state.image = VK_NULL_HANDLE;
+  s_state.memory = VK_NULL_HANDLE;
+  s_state.dmabuf = -1;
+  s_state.ever_written = false;
+}
+
+// Modifiers this GPU can hold an RGBA8 image in that we can blit INTO and the
+// consumer can sample FROM.
+//
+// planeCount == 1 is not a simplification, it is the DCC filter: the compressed
+// variants carry their metadata in extra planes, and the video engine cannot
+// read delta colour compression on anything before RDNA4.
+std::vector<u64> UsableModifiers()
+{
+  // Dolphin loads its own Vulkan entry points and its table has no
+  // vkGetPhysicalDeviceFormatProperties2, so it is fetched here rather than by
+  // extending the loader — one file touched instead of two, which is the whole
+  // argument for patching over the alternatives.
+  auto get_format_properties2 = reinterpret_cast<PFN_vkGetPhysicalDeviceFormatProperties2>(
+      vkGetInstanceProcAddr(g_vulkan_context->GetVulkanInstance(),
+                            "vkGetPhysicalDeviceFormatProperties2"));
+  if (get_format_properties2 == nullptr)
+    return {};
+
+  VkDrmFormatModifierPropertiesListEXT list = {};
+  list.sType = VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT;
+  VkFormatProperties2 props = {};
+  props.sType = VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2;
+  props.pNext = &list;
+
+  get_format_properties2(g_vulkan_context->GetPhysicalDevice(), VK_FORMAT_R8G8B8A8_UNORM, &props);
+  if (list.drmFormatModifierCount == 0)
+    return {};
+
+  std::vector<VkDrmFormatModifierPropertiesEXT> all(list.drmFormatModifierCount);
+  list.pDrmFormatModifierProperties = all.data();
+  get_format_properties2(g_vulkan_context->GetPhysicalDevice(), VK_FORMAT_R8G8B8A8_UNORM, &props);
+
+  constexpr VkFormatFeatureFlags needed =
+      VK_FORMAT_FEATURE_TRANSFER_DST_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+  std::vector<u64> usable;
+  for (const auto& m : all)
+  {
+    if (m.drmFormatModifierPlaneCount != 1)
+      continue;
+    if ((m.drmFormatModifierTilingFeatures & needed) != needed)
+      continue;
+    usable.push_back(m.drmFormatModifier);
+  }
+  return usable;
+}
+
+bool SendHeaderWithFd(const Header& header)
+{
+  iovec iov = {};
+  iov.iov_base = const_cast<Header*>(&header);
+  iov.iov_len = sizeof(header);
+
+  alignas(cmsghdr) char control[CMSG_SPACE(sizeof(int))] = {};
+  msghdr msg = {};
+  msg.msg_iov = &iov;
+  msg.msg_iovlen = 1;
+  msg.msg_control = control;
+  msg.msg_controllen = sizeof(control);
+
+  cmsghdr* cmsg = CMSG_FIRSTHDR(&msg);
+  cmsg->cmsg_level = SOL_SOCKET;
+  cmsg->cmsg_type = SCM_RIGHTS;
+  cmsg->cmsg_len = CMSG_LEN(sizeof(int));
+  std::memcpy(CMSG_DATA(cmsg), &s_state.dmabuf, sizeof(int));
+
+  // Blocking on purpose, and only here: this happens once per resolution, and a
+  // consumer that cannot take the descriptor has nothing to do anyway.
+  return sendmsg(s_state.socket, &msg, 0) == static_cast<ssize_t>(sizeof(header));
+}
+
+// Allocates the exportable image and hands its descriptor to the consumer.
+// Returns false and disables export on any failure — a worker that never gets a
+// frame is a broken stream, but a dead emulator is a dead game session.
+bool CreateImage(u32 width, u32 height)
+{
+  ReleaseImage();
+
+  const std::vector<u64> modifiers = UsableModifiers();
+  if (modifiers.empty())
+  {
+    ERROR_LOG_FMT(VIDEO, "nel3ab: no DRM format modifier can hold an exportable RGBA8 image");
+    return false;
+  }
+
+  const VkDevice device = g_vulkan_context->GetDevice();
+
+  VkImageDrmFormatModifierListCreateInfoEXT modifier_list = {};
+  modifier_list.sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_LIST_CREATE_INFO_EXT;
+  modifier_list.drmFormatModifierCount = static_cast<u32>(modifiers.size());
+  modifier_list.pDrmFormatModifiers = modifiers.data();
+
+  VkExternalMemoryImageCreateInfo external = {};
+  external.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO;
+  external.pNext = &modifier_list;
+  external.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+
+  VkImageCreateInfo image_info = {};
+  image_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+  image_info.pNext = &external;
+  image_info.imageType = VK_IMAGE_TYPE_2D;
+  image_info.format = VK_FORMAT_R8G8B8A8_UNORM;
+  image_info.extent = {width, height, 1};
+  image_info.mipLevels = 1;
+  image_info.arrayLayers = 1;
+  image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+  image_info.tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT;
+  image_info.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+  image_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  image_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+
+  if (vkCreateImage(device, &image_info, nullptr, &s_state.image) != VK_SUCCESS)
+  {
+    ERROR_LOG_FMT(VIDEO, "nel3ab: vkCreateImage for the export image failed");
+    return false;
+  }
+
+  VkMemoryRequirements requirements = {};
+  vkGetImageMemoryRequirements(device, s_state.image, &requirements);
+
+  VkPhysicalDeviceMemoryProperties memory_properties = {};
+  vkGetPhysicalDeviceMemoryProperties(g_vulkan_context->GetPhysicalDevice(), &memory_properties);
+  u32 memory_type = UINT32_MAX;
+  for (u32 i = 0; i < memory_properties.memoryTypeCount; i++)
+  {
+    if (!(requirements.memoryTypeBits & (1u << i)))
+      continue;
+    if (memory_properties.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)
+    {
+      memory_type = i;
+      break;
+    }
+  }
+  if (memory_type == UINT32_MAX)
+  {
+    ERROR_LOG_FMT(VIDEO, "nel3ab: no device-local memory type for the export image");
+    ReleaseImage();
+    return false;
+  }
+
+  // Allocated by hand rather than through VMA. Dolphin routes every other
+  // texture through the allocator, which has nowhere to attach
+  // VkExportMemoryAllocateInfo — and a single hand-allocated image touches
+  // nothing else, which is what keeps this patch small.
+  VkExportMemoryAllocateInfo export_info = {};
+  export_info.sType = VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO;
+  export_info.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+
+  VkMemoryDedicatedAllocateInfo dedicated = {};
+  dedicated.sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO;
+  dedicated.pNext = &export_info;
+  dedicated.image = s_state.image;
+
+  VkMemoryAllocateInfo allocate_info = {};
+  allocate_info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+  allocate_info.pNext = &dedicated;
+  allocate_info.allocationSize = requirements.size;
+  allocate_info.memoryTypeIndex = memory_type;
+
+  if (vkAllocateMemory(device, &allocate_info, nullptr, &s_state.memory) != VK_SUCCESS ||
+      vkBindImageMemory(device, s_state.image, s_state.memory, 0) != VK_SUCCESS)
+  {
+    ERROR_LOG_FMT(VIDEO, "nel3ab: could not allocate or bind exportable memory");
+    ReleaseImage();
+    return false;
+  }
+
+  VkImageDrmFormatModifierPropertiesEXT chosen = {};
+  chosen.sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_PROPERTIES_EXT;
+  auto get_modifier = reinterpret_cast<PFN_vkGetImageDrmFormatModifierPropertiesEXT>(
+      vkGetDeviceProcAddr(device, "vkGetImageDrmFormatModifierPropertiesEXT"));
+  auto get_fd =
+      reinterpret_cast<PFN_vkGetMemoryFdKHR>(vkGetDeviceProcAddr(device, "vkGetMemoryFdKHR"));
+  if (!get_modifier || !get_fd || get_modifier(device, s_state.image, &chosen) != VK_SUCCESS)
+  {
+    ERROR_LOG_FMT(VIDEO, "nel3ab: the dma-buf export entry points are missing");
+    ReleaseImage();
+    return false;
+  }
+
+  VkImageSubresource subresource = {};
+  subresource.aspectMask = VK_IMAGE_ASPECT_MEMORY_PLANE_0_BIT_EXT;
+  VkSubresourceLayout layout = {};
+  vkGetImageSubresourceLayout(device, s_state.image, &subresource, &layout);
+
+  VkMemoryGetFdInfoKHR fd_info = {};
+  fd_info.sType = VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR;
+  fd_info.memory = s_state.memory;
+  fd_info.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+  if (get_fd(device, &fd_info, &s_state.dmabuf) != VK_SUCCESS)
+  {
+    ERROR_LOG_FMT(VIDEO, "nel3ab: vkGetMemoryFdKHR failed");
+    ReleaseImage();
+    return false;
+  }
+
+  Header header = {};
+  header.magic = HEADER_MAGIC;
+  header.version = PROTOCOL_VERSION;
+  header.width = width;
+  header.height = height;
+  header.drm_format = DRM_FORMAT_ABGR8888;
+  header.modifier = chosen.drmFormatModifier;
+  header.offset = layout.offset;
+  header.pitch = layout.rowPitch;
+  header.size = requirements.size;
+  if (!SendHeaderWithFd(header))
+  {
+    ERROR_LOG_FMT(VIDEO, "nel3ab: could not send the frame descriptor to the worker");
+    ReleaseImage();
+    return false;
+  }
+
+  s_state.width = width;
+  s_state.height = height;
+  INFO_LOG_FMT(VIDEO,
+               "nel3ab: exporting {}x{} frames, modifier {:#018x}, pitch {}, {} bytes", width,
+               height, chosen.drmFormatModifier, layout.rowPitch, requirements.size);
+  return true;
+}
+
+void Barrier(VkCommandBuffer command_buffer, VkImageLayout old_layout, VkImageLayout new_layout,
+             VkAccessFlags src_access, VkAccessFlags dst_access, u32 src_queue, u32 dst_queue,
+             VkPipelineStageFlags src_stage, VkPipelineStageFlags dst_stage)
+{
+  VkImageMemoryBarrier barrier = {};
+  barrier.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+  barrier.srcAccessMask = src_access;
+  barrier.dstAccessMask = dst_access;
+  barrier.oldLayout = old_layout;
+  barrier.newLayout = new_layout;
+  barrier.srcQueueFamilyIndex = src_queue;
+  barrier.dstQueueFamilyIndex = dst_queue;
+  barrier.image = s_state.image;
+  barrier.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+  vkCmdPipelineBarrier(command_buffer, src_stage, dst_stage, 0, 0, nullptr, 0, nullptr, 1,
+                       &barrier);
+}
+
+void OnFrame(const AbstractTexture* texture, const MathUtil::Rectangle<int>& rect)
+{
+  if (s_state.socket < 0 || texture == nullptr)
+    return;
+
+  const u32 width = static_cast<u32>(rect.GetWidth());
+  const u32 height = static_cast<u32>(rect.GetHeight());
+  if (width == 0 || height == 0)
+    return;
+
+  if (s_state.image == VK_NULL_HANDLE || width != s_state.width || height != s_state.height)
+  {
+    if (!CreateImage(width, height))
+    {
+      // Stop trying. Retrying every frame would flood the log and change
+      // nothing.
+      close(s_state.socket);
+      s_state.socket = -1;
+      return;
+    }
+  }
+
+  const VKTexture* source = static_cast<const VKTexture*>(texture);
+  const VkCommandBuffer command_buffer = g_command_buffer_mgr->GetCurrentCommandBuffer();
+  const u32 queue = g_vulkan_context->GetGraphicsQueueFamilyIndex();
+
+  source->TransitionToLayout(command_buffer, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+
+  if (s_state.ever_written)
+  {
+    // Acquire back from the consumer. Without the ownership transfer the
+    // contents are formally undefined on either side of the handover.
+    Barrier(command_buffer, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 0,
+            VK_ACCESS_TRANSFER_WRITE_BIT, VK_QUEUE_FAMILY_FOREIGN_EXT, queue,
+            VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+  }
+  else
+  {
+    Barrier(command_buffer, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 0,
+            VK_ACCESS_TRANSFER_WRITE_BIT, VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED,
+            VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+  }
+
+  VkImageBlit blit = {};
+  blit.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  blit.srcOffsets[0] = {rect.left, rect.top, 0};
+  blit.srcOffsets[1] = {rect.left + static_cast<s32>(width), rect.top + static_cast<s32>(height),
+                        1};
+  blit.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  blit.dstOffsets[0] = {0, 0, 0};
+  blit.dstOffsets[1] = {static_cast<s32>(width), static_cast<s32>(height), 1};
+  vkCmdBlitImage(command_buffer, source->GetImage(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                 s_state.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit,
+                 VK_FILTER_NEAREST);
+
+  Barrier(command_buffer, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_GENERAL,
+          VK_ACCESS_TRANSFER_WRITE_BIT, 0, queue, VK_QUEUE_FAMILY_FOREIGN_EXT,
+          VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT);
+  s_state.ever_written = true;
+
+  source->TransitionToLayout(command_buffer, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+  // Submit it. Nothing else will.
+  //
+  // Recording the blit is not the same as running it, and in headless there is no
+  // presentation to end the frame — Dolphin only submits when something forces it
+  // to. Without this the export silently depended on Dolphin's own frame dumper
+  // being enabled, because its readback is what flushed the queue. That is the
+  // very readback this patch exists to remove, so the dependency made the whole
+  // thing circular: it appeared to work, and only while it was pointless.
+  //
+  // Measured 2026-08-10: without this line the consumer reads an all-zero image;
+  // with it, the game's picture.
+  static_cast<VKGfx*>(g_gfx.get())->ExecuteCommandBuffer(false, false);
+
+  FrameReady ready = {};
+  ready.magic = FRAME_MAGIC;
+  ready.frame_number = ++s_state.frame;
+  // Non-blocking, and a short write is deliberately ignored: a consumer that has
+  // fallen behind must never stall emulation, and the pixels are in the shared
+  // buffer regardless of whether it hears about this particular frame.
+  const ssize_t sent = send(s_state.socket, &ready, sizeof(ready), MSG_DONTWAIT | MSG_NOSIGNAL);
+  if (sent < 0 && errno != EAGAIN && errno != EWOULDBLOCK)
+  {
+    WARN_LOG_FMT(VIDEO, "nel3ab: the worker went away; frame export stops");
+    close(s_state.socket);
+    s_state.socket = -1;
+  }
+}
+}  // namespace
+
+void Initialize()
+{
+  const char* path = std::getenv("NEL3AB_FRAME_SOCKET");
+  if (path == nullptr || *path == '\0')
+    return;
+
+  // Checked HERE, at startup, and not at the first frame. These entry points are
+  // null unless VulkanContext enabled the matching device extensions, and that
+  // is by far the most likely reason for this patch to sit there doing nothing.
+  // Discovering it at frame one means discovering it inside a running game, in a
+  // log nobody is reading.
+  if (g_vulkan_context == nullptr)
+    return;
+  const VkDevice device = g_vulkan_context->GetDevice();
+  if (vkGetDeviceProcAddr(device, "vkGetMemoryFdKHR") == nullptr ||
+      vkGetDeviceProcAddr(device, "vkGetImageDrmFormatModifierPropertiesEXT") == nullptr)
+  {
+    ERROR_LOG_FMT(VIDEO,
+                  "nel3ab: this Vulkan device exposes no dma-buf export entry points. "
+                  "VulkanContext must enable VK_KHR_external_memory_fd, "
+                  "VK_EXT_external_memory_dma_buf, VK_EXT_image_drm_format_modifier and "
+                  "VK_EXT_queue_family_foreign. Frame export stays off.");
+    return;
+  }
+
+  sockaddr_un address = {};
+  address.sun_family = AF_UNIX;
+  if (std::strlen(path) >= sizeof(address.sun_path))
+  {
+    ERROR_LOG_FMT(VIDEO, "nel3ab: NEL3AB_FRAME_SOCKET is too long for sun_path");
+    return;
+  }
+  std::strncpy(address.sun_path, path, sizeof(address.sun_path) - 1);
+
+  const int socket_fd = socket(AF_UNIX, SOCK_STREAM, 0);
+  if (socket_fd < 0)
+    return;
+  if (connect(socket_fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0)
+  {
+    WARN_LOG_FMT(VIDEO, "nel3ab: nothing is listening on {}; frame export stays off", path);
+    close(socket_fd);
+    return;
+  }
+
+  s_state.socket = socket_fd;
+  s_state.frame = 0;
+  g_frame_export_hook = &OnFrame;
+  INFO_LOG_FMT(VIDEO, "nel3ab: frame export connected to {}", path);
+}
+
+void Shutdown()
+{
+  g_frame_export_hook = nullptr;
+  ReleaseImage();
+  if (s_state.socket >= 0)
+    close(s_state.socket);
+  s_state.socket = -1;
+}
+}  // namespace Vulkan::FrameExport
diff --git a/Source/Core/VideoBackends/Vulkan/VKFrameExport.h b/Source/Core/VideoBackends/Vulkan/VKFrameExport.h
