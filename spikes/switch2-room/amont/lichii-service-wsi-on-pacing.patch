+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <catch2/catch_test_macros.hpp>
+// X11 headers used by the real Vulkan translation unit define this macro.
+#define Success 0
+#include "video_core/wsi_present_stats.h"
+static_assert(Success == 0, "The diagnostic helper must preserve the X11 macro");
+#include "core/hle/service/nx2_vi2_trace.h"
+
+namespace {
+using Stats = VideoCommon::WsiPresentStats;
+auto At(std::int64_t ns) {
+    return Stats::Clock::time_point{std::chrono::nanoseconds{ns}};
+}
+}
+TEST_CASE("Presentation diagnostic startup flags require exact one", "[wsi_present_stats][vi2_service_trace]") {
+    REQUIRE(VideoCommon::WsiPresentStatsSwitch("1"));
+    REQUIRE(Service::Nx2Vi2TraceSwitch("1"));
+    const char* rejected[] = {nullptr, "", "0", "10", "true"};
+    for (const char* value : rejected) {
+        REQUIRE_FALSE(VideoCommon::WsiPresentStatsSwitch(value));
+        REQUIRE_FALSE(Service::Nx2Vi2TraceSwitch(value));
+    }
+}
+TEST_CASE("WSI returns anchor first interval and preserve contiguous windows", "[wsi_present_stats]") {
+    Stats s;
+    s.Recreated();
+    REQUIRE_FALSE(s.TakeWindow());
+    for (int n = 0; n < 600; ++n) {
+        REQUIRE_FALSE(s.Record(Stats::Result::AcceptedSuccess, At(n * 1000)));
+    }
+    REQUIRE_FALSE(s.TakeWindow());
+    REQUIRE(s.Record(Stats::Result::Suboptimal, At(600000)));
+    const auto first = s.TakeWindow();
+    REQUIRE(first.has_value());
+    REQUIRE(first->count == 600);
+    REQUIRE(first->sum_ns == 600000);
+    REQUIRE(first->end_ns - first->begin_ns == first->sum_ns);
+    REQUIRE(first->success == 600);
+    REQUIRE(first->suboptimal == 1);
+    for (int n = 601; n <= 1200; ++n) {
+        s.Record(Stats::Result::AcceptedSuccess, At(n * 1000));
+    }
+    const auto second = s.TakeWindow();
+    REQUIRE(second.has_value());
+    REQUIRE(second->begin_ns == first->end_ns);
+    REQUIRE(second->sum_ns == 600000);
+}
+TEST_CASE("WSI failure and recreation break different segments", "[wsi_present_stats]") {
+    Stats s;
+    s.Recreated();
+    s.Record(Stats::Result::AcceptedSuccess, At(0));
+    s.Record(Stats::Result::AcceptedSuccess, At(1000));
+    s.Record(Stats::Result::Rejected, At(2000));
+    REQUIRE(s.rejected == 1);
+    REQUIRE(s.generation == 1);
+    REQUIRE(s.segment == 2);
+    REQUIRE_FALSE(s.TakeWindow());
+    s.Recreated();
+    REQUIRE(s.generation == 2);
+    REQUIRE(s.segment == 3);
+    for (int n = 0; n < 601; ++n) {
+        s.Record(Stats::Result::AcceptedSuccess, At(1000000 + n * 1000));
+    }
+    const auto w = s.TakeWindow();
+    REQUIRE(w.has_value());
+    REQUIRE(w->begin_ns == 1000000);
+    REQUIRE(w->sum_ns == 600000);
+    REQUIRE(w->rejected == 1);
+    s.Record(Stats::Result::AcceptedSuccess, At(1));
+    REQUIRE(s.segment == 4);
+    REQUIRE_FALSE(s.TakeWindow());
+}
+TEST_CASE("WSI nearest rank quantiles include tails and exact budget edges", "[wsi_present_stats]") {
+    Stats s;
+    std::int64_t t = 0;
+    s.Record(Stats::Result::AcceptedSuccess, At(t));
+    for (int n = 600; n > 0; --n) {
+        t += n * 1000;
+        s.Record(Stats::Result::AcceptedSuccess, At(t));
+    }
+    auto w = s.TakeWindow();
+    REQUIRE(w.has_value());
+    REQUIRE(w->p50_ns == 300000);
+    REQUIRE(w->p95_ns == 570000);
+    REQUIRE(w->p99_ns == 594000);
+    REQUIRE(w->max_ns == 600000);
+    s.Recreated();
+    t = 0;
+    s.Record(Stats::Result::AcceptedSuccess, At(t));
+    for (int n = 0; n < 600; ++n) {
+        const std::int64_t interval = n == 0 ? 33333333 : n == 1 ? 33333334 :
+                                      n == 2 ? 100000000 : n == 3 ? 100000001 : 30000000;
+        t += interval;
+        s.Record(Stats::Result::AcceptedSuccess, At(t));
+    }
+    w = s.TakeWindow();
+    REQUIRE(w.has_value());
+    REQUIRE(w->over30 == 3);
+    REQUIRE(w->over100 == 1);
+    REQUIRE(w->max_ns == 100000001);
+    REQUIRE(w->p99_ns == 30000000);
+}
