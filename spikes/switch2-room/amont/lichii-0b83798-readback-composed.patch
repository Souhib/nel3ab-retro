+// A final counter result whose fence has not run. Payload uses the production GuestStreamer.
+class CounterStreamer final : public VideoCommon::StreamerInterface {
+public:
+    CounterStreamer() : StreamerInterface{static_cast<size_t>(QueryType::ZPassPixelCount64)} {}
+    VideoCommon::QueryBase* GetQuery(size_t id) override { return &queries.at(id); }
+    size_t WriteCounter(VAddr address, bool timestamp, u32,
+                        std::optional<u32> = std::nullopt) override {
+        const size_t id = queries.size();
+        queries.emplace_back(timestamp, address, 73);
+        freed.push_back(false);
+        pending = true;
+        return id;
+    }
+    bool HasUnsyncedQueries() const override { return pending; }
+    void PushUnsyncedQueries() override { pending = false; }
+    void Free(size_t id) override {
+        REQUIRE_FALSE(freed.at(id));
+        freed[id] = true;
+        ++frees;
+    }
+    std::deque<VideoCommon::GuestQuery> queries;
+    std::vector<bool> freed;
+    bool pending{};
+    u32 frees{};
+};
+
+struct QueryRuntime {
+    QueryRuntime(Cache& cache_, Runtime& runtime_, VideoCommon::BufferId id_);
+    ~QueryRuntime();
+    VideoCommon::StreamerInterface* GetStreamerInterface(QueryType type);
+    void Bind3DEngine(Tegra::Engines::Maxwell3D*) {}
+    void Barriers(bool) {}
+    template <class T> void SyncValues(std::span<T> values) {
+        // As Vulkan::QueryCacheRuntime::SyncValues: invalidate the earlier read copies, then
+        // record the host-buffer writes. The fixture runtime executes them at their GPU tick.
+        for (const auto& value : values) {
+            cache.OutdateReadDownloads(value.address, value.size);
+            REQUIRE(value.address >= 0x20000);
+            REQUIRE(value.address + value.size <= 0x30000);
+            auto* buffer = &Access::Get(cache, id);
+            runtime.pending.push_back([buffer, value] {
+                std::memcpy(buffer->bytes.data() + value.address - 0x20000,
+                            &value.value, value.size);
+            });
+            ++copies;
+        }
+    }
+    Cache& cache;
+    Runtime& runtime;
+    VideoCommon::BufferId id;
+    std::unique_ptr<PayloadStreamer> payload;
+    CounterStreamer counter;
+    u32 copies{};
+};
+class PayloadStreamer final : public VideoCommon::GuestStreamer<QueryTraits> {
+public:
+    explicit PayloadStreamer(QueryRuntime& runtime)
+        : GuestStreamer{static_cast<size_t>(QueryType::Payload), runtime} {}
+    void Free(size_t id) override {
+        ++frees;
+        GuestStreamer::Free(id);
+    }
+    u32 frees{};
+};
+QueryRuntime::QueryRuntime(Cache& cache_, Runtime& runtime_, VideoCommon::BufferId id_)
+    : cache{cache_}, runtime{runtime_}, id{id_}, payload{std::make_unique<PayloadStreamer>(*this)} {}
+QueryRuntime::~QueryRuntime() = default;
+VideoCommon::StreamerInterface* QueryRuntime::GetStreamerInterface(QueryType type) {
+    if (type == QueryType::Payload) return payload.get();
+    if (type == QueryType::ZPassPixelCount64) return &counter;
+    return nullptr;
+}
+class Queries final : public VideoCommon::QueryCacheBase<QueryTraits> {
+public:
+    using QueryCacheBase::QueryCacheBase;
