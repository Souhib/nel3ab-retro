+TEST_CASE("PR1216 neutral DeferWords copies payload but preserves emitted method invalidations",
+          "[video_core][gpu_split_dependencies][pr1216]") {
+    using Access = VideoCommon::GpuSplitTestAccess;
+    namespace FastDraw = VideoCommon::Nx2FastDraw;
+    Fixture f;
+    VideoCommon::GpuSplit split;
+    Access::Initialize(split, f.system);
+    const bool was_enabled = FastDraw::Enabled();
+    FastDraw::SetEnabledForTest(true);
+    SCOPE_EXIT { FastDraw::SetEnabledForTest(was_enabled); FastDraw::g_delta = {}; };
+    std::vector<u32> observed;
+    std::vector<u32> payload{0x1234, 0x5678};
+    split.DeferWords([&observed](std::span<const u32> words) {
+        observed.assign(words.begin(), words.end());
+    }, payload, VideoCommon::GpuSplit::Writes::Anywhere, VideoCommon::GpuSplit::FastDrawNeutral);
+    const u64 end = Access::End(split);
+    CHECK(Access::WritesTarget(split, f.memory, 0x8000, 4) == end);
+    payload.assign(2, 0xbad); // The real ring must contain a submit-time copy.
+    REQUIRE(observed.empty());
+    const u64 before = FastDraw::Serial();
+    u64 position = Access::Execute(split, 0, end);
+    REQUIRE(position == end);
+    CHECK((observed == std::vector<u32>{0x1234, 0x5678}));
+    CHECK(FastDraw::Serial() == before);
+    const std::array<u32, 1> change{f.fast.regs.reg_array[MAXWELL3D_REG_INDEX(viewport_transform)] + 1};
+    split.DeferWords([engine = &f.fast, system = &f.system](std::span<const u32> words) {
+        engine->CallMethod(*system, MAXWELL3D_REG_INDEX(viewport_transform), words[0], true);
+    }, change, VideoCommon::GpuSplit::Writes::Anywhere, VideoCommon::GpuSplit::FastDrawNeutral);
+    position = Access::Execute(split, position, Access::End(split));
+    REQUIRE(position == Access::End(split));
+    CHECK(FastDraw::Serial() != before); // Neutral call does not suppress its methods.
+    const u64 changed = FastDraw::Serial();
+    split.DeferWords([](std::span<const u32>) {}, change); // Unguarded calls still break.
+    position = Access::Execute(split, position, Access::End(split));
+    CHECK(position == Access::End(split));
+    CHECK(FastDraw::Serial() != changed);
+}
