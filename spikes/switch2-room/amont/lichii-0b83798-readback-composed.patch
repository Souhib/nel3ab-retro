+class Rasterizer final : public ReadRasterizer {
+public:
+    Rasterizer(Cache& buffers_, Runtime& runtime_) : ReadRasterizer{buffers_}, buffers{buffers_},
+                                                    runtime{runtime_} {}
+    void SignalFence(std::function<void()>&& operation) override { signal(std::move(operation)); }
+    void SyncOperation(std::function<void()>&& operation) override { sync(std::move(operation)); }
+    void FlushCommands() override { runtime.SubmitForHostRead(); }
+    bool NoteReportPending(DAddr address, u64 size) override {
+        std::scoped_lock lock{buffers.mutex};
+        const bool kept = buffers.NoteReportPending(address, size);
+        notes.push_back(kept);
+        return kept;
+    }
+    void FinishReport(DAddr address, u64 size) override {
+        std::scoped_lock lock{buffers.mutex};
+        buffers.FinishReport(address, size);
+        ++finishes;
+    }
+    void FinishRead(DAddr address, u64 size) override {
+        ++read_finishes;
+        ReadRasterizer::FinishRead(address, size);
+    }
+    Cache& buffers;
+    Runtime& runtime;
+    std::function<void(std::function<void()>&&)> signal, sync;
+    std::vector<bool> notes;
+    u32 finishes{}, read_finishes{};
+};
+struct TextureCache {
+    std::mutex mutex;
+    bool flush{};
+    bool HasUncommittedFlushes() const { return flush; }
+    bool HasAsyncFlushWork() const { return flush; }
+    bool ShouldWaitAsyncFlushes() const { return false; }
+    void CommitAsyncFlushes() {}
+    void PopAsyncFlushes() {}
+};
+struct Fence : VideoCommon::FenceBase {
+    Fence(bool stubbed, u64 tick_) : FenceBase{stubbed}, tick{tick_} {}
+    u64 tick;
+};
+struct FenceTraits {
+    using FenceType = std::shared_ptr<Fence>;
+    using TextureCacheType = TextureCache;
+    using BufferCacheType = Cache;
+    using QueryCacheType = Queries;
+    static constexpr bool HAS_ASYNC_CHECK = false;
+};
+class Fences final : public VideoCommon::FenceManager<FenceTraits> {
+public:
+    Fences(Rasterizer& rasterizer, Tegra::GPU& gpu, TextureCache& texture,
+           Cache& buffers, Queries& queries, Runtime& runtime_)
+        : VideoCommon::FenceManager<FenceTraits>{rasterizer, gpu, texture, buffers, queries},
+          runtime{runtime_} {}
+    ~Fences() override = default;
+    Runtime& runtime;
+    u64 last_tick{};
+    void Complete() {
+        runtime.Finish();
+        WaitPendingFences(false);
+    }
+protected:
+    std::shared_ptr<Fence> CreateFence(bool stubbed) override {
+        return std::make_shared<Fence>(stubbed, runtime.CurrentTick());
+    }
+    void QueueFence(std::shared_ptr<Fence>& fence) override { last_tick = fence->tick; }
+    bool IsFenceSignaled(std::shared_ptr<Fence>& fence) const override {
+        return runtime.IsFree(fence->tick);
+    }
+    void WaitFence(std::shared_ptr<Fence>& fence) override {
+        REQUIRE(runtime.IsFree(fence->tick));
+    }
+    void SubmitDeferredWork() override { runtime.SubmitForHostRead(); }
+};
+struct SettingsScope {
+    SettingsScope() {
+        Settings::values.current_gpu_accuracy = Settings::GpuAccuracy::Low;
+        Settings::values.gpu_fence_behavior.SetValue(Settings::GpuFenceBehavior::Default);
+        VideoCore::g_signaling_query_report_fence = false;
+    }
+    ~SettingsScope() {
+        Settings::values.current_gpu_accuracy = accuracy;
+        Settings::values.gpu_fence_behavior.SetValue(behavior);
+        VideoCore::g_signaling_query_report_fence = report;
+    }
+    Settings::GpuAccuracy accuracy = Settings::values.current_gpu_accuracy;
+    Settings::GpuFenceBehavior behavior = Settings::values.gpu_fence_behavior.GetValue();
+    bool report = VideoCore::g_signaling_query_report_fence;
+};
