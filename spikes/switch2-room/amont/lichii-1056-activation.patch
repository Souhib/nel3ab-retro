 bool GpuSplit::WaitForSyncedWriters() {
+    static const bool trace = [] {
+        const char* value = std::getenv("EDEN_NX2_SYNCED_WRITERS_TRACE");
+        return value && value[0] == '1' && value[1] == '\0';
+    }();
+    if (trace) {
+        static const bool logged = [] {
+            LOG_INFO(HW_GPU, "Synced-writer list fetch active (PR1056)");
