+#include "video_core/vulkan_common/vulkan_wrapper.h"
+namespace Vulkan {
+class Device;
+class Scheduler;
+class CoarseGpuTrace {
+public:
+    static constexpr u32 InvalidId = ~u32{0};
+    CoarseGpuTrace(const Device& device, Scheduler& scheduler);
+    void Tick();
+    // The following methods run only on the scheduler worker.
+    void BeginSubmit(vk::CommandBuffer execution, vk::CommandBuffer upload);
+    void EndSubmit(vk::CommandBuffer execution, vk::CommandBuffer upload);
+    u32 BeginCompute(vk::CommandBuffer command, VideoCommon::CoarseProgram program);
+    void EndCompute(vk::CommandBuffer command, u32 id);
+private:
+    // 2026-11-08: the old probe measured about3100 intervals/frame. This bounds
+    // the new probe to2048 queries; exhaustion invalidates data, never game commands.
+    static constexpr u32 MaxIntervals = 1024;
+    static constexpr u32 MaxPrograms = 256;
+    struct Event { const char* category; VideoCommon::CoarseProgram program; };
+    struct ProgramCount { VideoCommon::CoarseProgram program; u64 count{}; };
+    u32 Begin(vk::CommandBuffer command, const char* category,
+              VideoCommon::CoarseProgram program = {});
+    void End(vk::CommandBuffer command, u32 id);
+    void WriteResults();
+    const Device& device;
+    Scheduler& scheduler;
+    vk::QueryPool pool;
+    std::filesystem::path directory;
+    VideoCommon::CoarseGpuBudget<MaxIntervals> budget;
+    std::vector<Event> events;
+    std::vector<ProgramCount> programs;
+    std::vector<VideoCommon::CoarseProgram> previous_programs;
+    std::optional<VideoCommon::CoarseProgram> target;
+    std::optional<u64> forced_native;
+    std::atomic<bool> recording_done{true};
+    double period_ns{}, capture_start_unix{}, capture_end_unix{};
+    u32 valid_bits{}, period_frames{60}, sequence{}, execution_id{InvalidId}, upload_id{InvalidId};
+    u64 frame{}, capture_frame{}, end_tick{};
+    bool supported{}, recording{}, pending{}, worker_active{}, program_overflow{}, armed{true};
+};
+} // namespace Vulkan
