+TEST_CASE("Uniform span allocation takes the slot snapshot before guest mutation",
+          "[video_core][uniform_span][uniform_span_snapshot]") {
+    Memory memory;
+    Runtime runtime;
+    VideoCommon::ResetUniformStreamReuse<Runtime>();
+    memory.bytes.fill(1);
+    REQUIRE(VideoCommon::BindSmallUniformReusing(runtime, memory, 0, 0, 0, 32, 64));
+    u8 snapshot = 1;
+    SECTION("changed bytes") {
+        memory.bytes.fill(2);
+        snapshot = 2;
+    }
+    SECTION("same bytes in a new tick") {
+        runtime.NextTick();
+    }
+    u32 mutations = 0;
+    runtime.on_allocate = [&] {
+        ++mutations;
+        memory.bytes.fill(3);
+    };
+    REQUIRE(VideoCommon::BindSmallUniformReusing(runtime, memory, 0, 0, 0, 32, 64));
+    REQUIRE(mutations == 1);
+    REQUIRE(memory.in_place == 2);
+    const auto& slot = VideoCommon::UniformStreamReuseState<Runtime::StreamUniformRef>().slots[0][0];
+    REQUIRE(slot.size == 64);
+    const auto& bound = runtime.allocations.at(runtime.bound.allocation);
+    REQUIRE(std::all_of(bound.begin(), bound.end(), [snapshot](u8 b) { return b == snapshot; }));
+    REQUIRE(std::memcmp(bound.data(), slot.bytes.data(), 64) == 0);
+    REQUIRE(memory.bytes[32] == 3);
+    runtime.on_allocate = {};
+    const auto allocations = runtime.allocations.size();
+    REQUIRE(VideoCommon::BindSmallUniformReusing(runtime, memory, 0, 0, 0, 32, 64));
+    REQUIRE(runtime.allocations.size() == allocations + 1);
+    CheckBound(runtime, memory, 32, 64);
+}
+
+namespace {
+struct GatherOnlyMemory {
+    std::array<u8, 8192> bytes{};
+    std::array<bool, 2> mapped{true, true};
+    u32 gathered{};
+    void ReadBlockUnsafe(u64 address, void* destination, u32 size) {
+        REQUIRE(address + size <= bytes.size());
+        ++gathered;
+        auto* output = static_cast<u8*>(destination);
+        for (u32 i = 0; i < size; ++i) {
+            output[i] = mapped[(address + i) / 4096] ? bytes[address + i] : 0;
+        }
+    }
+};
+struct SparseMemory : GatherOnlyMemory {
+    u32 direct{}, refused{};
+    u8* GetSpan(u64 address, size_t size) {
+        REQUIRE(size != 0);
+        REQUIRE(address + size <= bytes.size());
+        if (!mapped[address / 4096] || address / 4096 != (address + size - 1) / 4096) {
+            ++refused;
+            return nullptr;
+        }
+        ++direct;
+        return bytes.data() + address;
+    }
+};
+} // namespace
+
+TEST_CASE("Uniform span preserves gather-only and unmapped zero fill fallbacks",
+          "[video_core][uniform_span]") {
+    Runtime runtime;
+    VideoCommon::ResetUniformStreamReuse<Runtime>();
+    GatherOnlyMemory gather;
+    gather.bytes.fill(4);
+    REQUIRE(VideoCommon::BindSmallUniformReusing(runtime, gather, 0, 0, 0, 0, 64));
+    REQUIRE(gather.gathered == 1);
+    REQUIRE(runtime.allocations.at(runtime.bound.allocation) == std::vector<u8>(64, 4));
+    SparseMemory sparse;
+    sparse.bytes.fill(5);
+    sparse.mapped[1] = false;
+    REQUIRE(VideoCommon::BindSmallUniformReusing(runtime, sparse, 0, 0, 0, 4096, 64));
+    REQUIRE(sparse.refused == 1);
+    REQUIRE(sparse.direct == 0);
+    REQUIRE(sparse.gathered == 1);
+    REQUIRE(runtime.allocations.at(runtime.bound.allocation) == std::vector<u8>(64, 0));
+    REQUIRE(VideoCommon::BindSmallUniformReusing(runtime, sparse, 0, 0, 0, 4090, 12));
+    REQUIRE(sparse.refused == 2);
+    REQUIRE(sparse.gathered == 2);
+    std::vector<u8> expected(12, 0);
+    std::fill_n(expected.begin(), 6, u8{5});
+    REQUIRE(runtime.allocations.at(runtime.bound.allocation) == expected);
+}
