+TEST_CASE("Immediate payload does not retire an older rewritten readback report",
+          "[buffer_ports][query_readback][query_readback_red]") {
+    PayloadReadback::Fixture f;
+    const bool rewritten = GENERATE(true, false);
+    // The negative twin moves the same GPU write before R1: both reports then have the same
+    // rewritten state, so a count-only check could not distinguish their identities.
+    if (!rewritten) f.Draw();
+    f.Counter();
+    if (rewritten) f.Draw();
+    REQUIRE(Access::PendingReportStates(*f.buffers.cache) == std::vector<bool>{rewritten});
+    f.Payload();
+    const auto remaining = Access::PendingReportStates(*f.buffers.cache);
+    REQUIRE(remaining.size() == 1);
+    REQUIRE(Access::ReadDownloads(*f.buffers.cache) == 0);
+    // A later dispatch ends the render pass without writing these words. It records the
+    // pending draw's early copy. No guest read or later write repairs the report's state.
+    f.buffers.cache->NoteWorkRecorded(true);
+    REQUIRE(Access::ReadDownloads(*f.buffers.cache) == 1);
+    f.buffers.runtime.Complete(f.buffers.runtime.submitted_tick);
+    f.buffers.cache->NoteWorkRecorded(true);
+    REQUIRE(Access::ReadDownloads(*f.buffers.cache) == 0);
+    REQUIRE(f.Word() == 5); // The GPU also received the real Payload stream's copy.
+    REQUIRE(f.runtime.counter.frees == 0);
+    f.Retire();
+    REQUIRE(f.Word() == 73); // The older R1 callback really wrote after the early download.
+    const auto area = ReadWord(f.buffers, PayloadReadback::Fixture::Device);
+    REQUIRE(f.Word() == (rewritten ? 5 : 73));
+    REQUIRE(area.preemtive == !rewritten);
+    REQUIRE(remaining == std::vector<bool>{rewritten});
+    REQUIRE(f.rasterizer.notes.size() == 1);
+    REQUIRE(f.rasterizer.finishes == 1);
+    REQUIRE(VideoCore::g_read_downloads == 0);
+}
