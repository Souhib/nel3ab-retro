         /// <summary>
         /// Queue updating texture mappings on the pool. Happens from another thread.
         /// </summary>
+        /// <summary>
+        /// nel3ab: whether remapping [address, address + size) in GPU virtual memory can
+        /// change this texture's mapping: its creation address or one of its pool
+        /// references lies in that range. A texture outside it keeps the same pages.
+        /// </summary>
+        public bool OverlapsGpuRange(ulong address, ulong size)
+        {
+            ulong end = address + size;
+            ulong length = Size;
+
+            if (Info.GpuAddress < end && address < Info.GpuAddress + length)
+            {
+                return true;
+            }
+
+            lock (_poolOwners)
+            {
+                foreach (TexturePoolOwner owner in _poolOwners)
+                {
+                    if (owner.GpuAddress < end && address < owner.GpuAddress + length)
+                    {
+                        return true;
+                    }
+                }
+            }
+
+            return false;
+        }
+
         public void UpdatePoolMappings()
         {
             ChangedMapping = true;
