+        // nel3ab, 2026-09-10: connect only the players whose seat is taken in
+        // the room. The worker writes the seat numbers to NEL3AB_SEATS_FILE.
+        // Every connected controller counts as a player: Mario Tennis asked the
+        // controller applet for exactly 2, was told 4, and forced doubles. A
+        // console lets people unplug the extra controllers; the room does it
+        // for them. No variable, or no file yet: every configured player.
+        private static readonly string _seatsFile = Environment.GetEnvironmentVariable("NEL3AB_SEATS_FILE");
+        private long _seatsCheckedAt;
+        private string _seatsText;
+        private HashSet<Ryujinx.Common.Configuration.Hid.PlayerIndex> _seats;
+
+        private void RefreshSeats()
+        {
+            if (_seatsFile == null || Environment.TickCount64 - _seatsCheckedAt < 250)
+            {
+                return;
+            }
+
+            _seatsCheckedAt = Environment.TickCount64;
+
+            string text;
+            try
+            {
+                text = File.Exists(_seatsFile) ? File.ReadAllText(_seatsFile) : null;
+            }
+            catch (IOException)
+            {
+                return;
+            }
+
+            if (text == null || text == _seatsText)
+            {
+                return;
+            }
+
+            _seatsText = text;
+
+            HashSet<Ryujinx.Common.Configuration.Hid.PlayerIndex> seats = [];
+            foreach (string token in text.Split((char[])null, StringSplitOptions.RemoveEmptyEntries))
+            {
+                if (int.TryParse(token, out int seat) && seat is >= 1 and <= 8)
+                {
+                    seats.Add((Ryujinx.Common.Configuration.Hid.PlayerIndex)(seat - 1));
+                }
+            }
+
+            lock (_lock)
+            {
+                _seats = seats;
+                ReloadConfiguration(_requestedInputConfig, _playerInputAssignments, _enableKeyboard, _enableMouse);
+            }
+
+            Logger.Info?.Print(LogClass.Hid, $"nel3ab seats: players {string.Join(" ", seats.Select(player => (int)player + 1))} connected");
+        }
+
