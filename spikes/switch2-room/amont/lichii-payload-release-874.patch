+// The unrelated rasterizer operations delegate to Null. Fence callbacks delegate to the real
+// FenceManager below; Null::SignalFence would execute them all immediately and hide the bug.
+class QueryRasterizer final : public VideoCore::RasterizerInterface {
+public:
+    explicit QueryRasterizer(Tegra::GPU& gpu) : base{gpu} {}
+    std::function<void(std::function<void()>&&)> signal;
+    std::function<void(std::function<void()>&&)> sync;
+    void Draw(bool is_indexed, u32 instance_count) override { return base.Draw(is_indexed, instance_count); }
+    void DrawTexture() override { return base.DrawTexture(); }
+    void Clear(u32 layer_count) override { return base.Clear(layer_count); }
+    void DispatchCompute() override { return base.DispatchCompute(); }
+    void ResetCounter(VideoCommon::QueryType type) override { return base.ResetCounter(type); }
+    void Query(GPUVAddr gpu_addr, VideoCommon::QueryType type,
+               VideoCommon::QueryPropertiesFlags flags, u32 payload, u32 subreport) override { return base.Query(gpu_addr, type, flags, payload, subreport); }
+    void BindGraphicsUniformBuffer(size_t stage, u32 index, GPUVAddr gpu_addr, u32 size) override { return base.BindGraphicsUniformBuffer(stage, index, gpu_addr, size); }
+    void DisableGraphicsUniformBuffer(size_t stage, u32 index) override { return base.DisableGraphicsUniformBuffer(stage, index); }
+    void FlushAll() override { return base.FlushAll(); }
+    void FlushRegion(DAddr addr, u64 size,
+                     VideoCommon::CacheType which) override { return base.FlushRegion(addr, size, which); }
+    bool MustFlushRegion(DAddr addr, u64 size,
+                         VideoCommon::CacheType which) override { return base.MustFlushRegion(addr, size, which); }
+    void InvalidateRegion(DAddr addr, u64 size,
+                          VideoCommon::CacheType which) override { return base.InvalidateRegion(addr, size, which); }
+    void OnCacheInvalidation(DAddr addr, u64 size) override { return base.OnCacheInvalidation(addr, size); }
+    bool OnCPUWrite(DAddr addr, u64 size) override { return base.OnCPUWrite(addr, size); }
+    VideoCore::RasterizerDownloadArea GetFlushArea(DAddr addr, u64 size) override { return base.GetFlushArea(addr, size); }
+    void InvalidateGPUCache() override { return base.InvalidateGPUCache(); }
+    void UnmapMemory(DAddr addr, u64 size) override { return base.UnmapMemory(addr, size); }
+    void ModifyGPUMemory(size_t as_id, GPUVAddr addr, u64 size) override { return base.ModifyGPUMemory(as_id, addr, size); }
+    void SignalFence(std::function<void()>&& func) override { signal(std::move(func)); }
+    void SyncOperation(std::function<void()>&& func) override { sync(std::move(func)); }
+    void SignalSyncPoint(u32 value) override { return base.SignalSyncPoint(value); }
+    void SignalReference() override { return base.SignalReference(); }
+    void ReleaseFences(bool force) override { return base.ReleaseFences(force); }
+    void FlushAndInvalidateRegion(
+        DAddr addr, u64 size, VideoCommon::CacheType which) override { return base.FlushAndInvalidateRegion(addr, size, which); }
+    void WaitForIdle() override { return base.WaitForIdle(); }
+    void FragmentBarrier() override { return base.FragmentBarrier(); }
+    void TiledCacheBarrier() override { return base.TiledCacheBarrier(); }
+    void FlushCommands() override { return base.FlushCommands(); }
+    void TickFrame() override { return base.TickFrame(); }
+    bool AccelerateSurfaceCopy(const Tegra::Engines::Fermi2D::Surface& src,
+                               const Tegra::Engines::Fermi2D::Surface& dst,
+                               const Tegra::Engines::Fermi2D::Config& copy_config) override { return base.AccelerateSurfaceCopy(src, dst, copy_config); }
