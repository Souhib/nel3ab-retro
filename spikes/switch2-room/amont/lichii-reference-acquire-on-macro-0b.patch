+namespace PayloadReadback {
+struct AcquireSession {
+    explicit AcquireSession(bool trained) : f{trained}, channel{0},
+        pusher{f.buffers.system, *f.buffers.memory, channel} {
+        const char* value = std::getenv("EDEN_NX2_REFERENCE_ACQUIRE");
+        reference = value && value[0] == '1' && value[1] == '\0';
+        Tegra::Nx2ClearSemaphoreRegions();
+        Tegra::Nx2AddSemaphoreRegion(0x200000);
+        f.buffers.memory->BindRasterizer(&f.rasterizer);
+        f.buffers.device.BindInterface(&f.rasterizer);
+        f.buffers.memory->Map(Alias, Fixture::Device & ~u64{0xfff}, 0x1000,
+                              Tegra::PTEKind::PITCH, false);
+        pusher.BindRasterizer(&f.rasterizer);
+        REQUIRE(f.buffers.memory->GpuToCpuAddress(Fixture::Address) == Fixture::Device);
+        REQUIRE(f.buffers.memory->GpuToCpuAddress(Alias + 0x40) == Fixture::Device);
+        REQUIRE(Tegra::Nx2SemaphoreMirror(Fixture::Address + 0x1000) == Fixture::Address);
+        VideoCommon::ReferenceAcquireTest::Start(f.buffers.system);
+        REQUIRE(split.Active());
+        REQUIRE(split.FrontMacros());
+        REQUIRE(Tegra::g_nx2_ampere.load());
+        REQUIRE_FALSE(Settings::IsGPULevelHigh());
+        REQUIRE(Settings::IsGPUFenceBehaviorDefault());
+        Run([] {}); // Actual back execution, before the test queues any reports.
+    }
+    ~AcquireSession() {
+        // Complete the synthetic host ticks before waiting for or destroying the real back.
+        // This also runs after a failed assertion, while queries and caches are still alive.
+        Run([&] { f.fences.Complete(); });
+        split.Stop();
+        Tegra::Nx2SemaphoreWaiters::Get().Remove(&puller);
+        Tegra::Nx2ClearSemaphoreRegions();
+        f.buffers.memory->BindRasterizer(&f.buffers.rasterizer);
+        f.buffers.device.BindInterface(&f.buffers.rasterizer);
+    }
+    void Run(const std::function<void()>& function) {
+        std::exception_ptr failure;
+        bool owned = false;
+        split.Run([&] {
+            owned = VideoCommon::GpuSplit::OwnsScheduler();
+            try { function(); } catch (...) { failure = std::current_exception(); }
+        });
+        if (failure) std::rethrow_exception(failure);
+        REQUIRE(owned);
+    }
+    void Semaphore(GPUVAddr address, u32 value, u32 operation) {
+        using Call = Tegra::Engines::Puller::MethodCall;
+        puller.CallPullerMethod(pusher, Call{4, static_cast<u32>(address >> 32)});
+        puller.CallPullerMethod(pusher, Call{5, static_cast<u32>(address)});
+        puller.CallPullerMethod(pusher, Call{6, value});
+        puller.CallPullerMethod(pusher, Call{7, operation});
+    }
+    void Release(GPUVAddr address, u32 value) { Semaphore(address, value, 2 | (1U << 24)); }
+    void Acquire(GPUVAddr address, u32 value) { Semaphore(address, value, 4); }
+    static constexpr GPUVAddr Alias = 0x300000;
+    Fixture f;
+    Tegra::Control::ChannelState channel;
+    Tegra::DmaPusher pusher;
+    Tegra::Engines::Puller puller;
+    VideoCommon::GpuSplit& split = VideoCommon::GpuSplit::Get();
+    bool reference{};
+};
