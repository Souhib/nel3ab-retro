+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <catch2/catch_test_macros.hpp>
+#include <array>
+#include <limits>
+#include "video_core/submission_gpu_budget.h"
+#include "video_core/gpu_timestamp_sample.h"
+TEST_CASE("Submission GPU budget rejects incomplete and exhausted captures", "[submission_gpu]") {
+    VideoCommon::SubmissionGpuBudget<2> budget;
+    REQUIRE_FALSE(budget.Complete());
+    const auto first=budget.Begin(); REQUIRE(first); REQUIRE(*first==0);
+    REQUIRE_FALSE(budget.Complete()); REQUIRE(budget.End(*first)); REQUIRE(budget.Complete());
+    const auto second=budget.Begin(); REQUIRE(second); REQUIRE(*second==1);
+    REQUIRE_FALSE(budget.Complete()); REQUIRE(budget.End(*second)); REQUIRE(budget.Complete());
+    REQUIRE_FALSE(budget.Begin()); REQUIRE(budget.Overflow()); REQUIRE(budget.Count()==2);
+    REQUIRE_FALSE(budget.Complete());
+    budget={}; REQUIRE_FALSE(budget.Overflow()); REQUIRE(budget.Count()==0);
+    const auto again=budget.Begin(); REQUIRE(again); REQUIRE(budget.End(*again));
+    REQUIRE_FALSE(budget.End(*again)); REQUIRE_FALSE(budget.Complete());
+    budget={}; REQUIRE_FALSE(budget.End(0)); REQUIRE_FALSE(budget.Complete());
+}
+TEST_CASE("Submission timestamps require available results and valid counter parameters", "[submission_gpu]") {
+    using VideoCommon::GpuTimestampNanoseconds;
+    REQUIRE(GpuTimestampNanoseconds(10,30,true,true,64,10)==200.0);
+    REQUIRE(GpuTimestampNanoseconds(0xfffffffe,1,true,true,32,1)==3.0);
+    REQUIRE(GpuTimestampNanoseconds(~u64{0}-1,1,true,true,64,1)==3.0);
+    REQUIRE_FALSE(GpuTimestampNanoseconds(10,30,false,true,64,1));
+    REQUIRE_FALSE(GpuTimestampNanoseconds(10,30,true,false,64,1));
+    REQUIRE_FALSE(GpuTimestampNanoseconds(10,30,true,true,0,1));
+    REQUIRE_FALSE(GpuTimestampNanoseconds(10,30,true,true,65,1));
+    REQUIRE_FALSE(GpuTimestampNanoseconds(10,30,true,true,64,0));
+    REQUIRE_FALSE(GpuTimestampNanoseconds(10,30,true,true,64,-1));
+    REQUIRE_FALSE(GpuTimestampNanoseconds(10,30,true,true,64,std::numeric_limits<double>::infinity()));
+    REQUIRE_FALSE(GpuTimestampNanoseconds(10,30,true,true,64,std::numeric_limits<double>::quiet_NaN()));
+}
