#version 450

// RGBA -> NV12, BT.709 limited range.
//
// One invocation per CHROMA sample, so each handles a 2x2 block: four luma
// writes and one interleaved chroma write. That is the shape NV12 wants, and it
// means the 2x2 average for chroma is free — the four samples are already in
// registers.
//
// BT.709 and limited range because that is what an H.264 stream is expected to
// carry. Getting either wrong produces a picture that looks *almost* right —
// slightly washed out, or with the greens off — which is far harder to notice
// than a broken one.

layout(local_size_x = 8, local_size_y = 8) in;

// Sampled, not storage: Dolphin's exported frame is created with SAMPLED usage,
// and the spike matches what the encoder will actually be handed.
layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 1, r8) uniform writeonly image2D luma;
layout(set = 0, binding = 2, rg8) uniform writeonly image2D chroma;

layout(push_constant) uniform Push
{
    ivec2 chroma_size;  // TARGET size / 2
}
push;

// Combien de pixels de la source, sur un côté, font un pixel de la sortie.
//
// Une constante de spécialisation, pas une variable: elle est fixée à la
// création du pipeline, donc le compilateur déroule la boucle et efface la
// division. À 1 ce fichier produit exactement ce qu'il produisait avant — une
// seule lecture par pixel, divisée par un — et c'est la propriété qui compte:
// le flux pleine taille ne doit rien payer pour que le demi-format existe.
//
// À 2, un pixel de sortie est la MOYENNE d'un bloc de 2x2. Une moyenne et pas
// un pixel sur deux: prendre un pixel sur deux fait scintiller les damiers et
// les grilles, dont un jeu GameCube est plein.
layout(constant_id = 0) const int SCALE = 1;

// Un pixel de la sortie, lu dans la source.
//
// Le nombre total de lectures ne change pas avec l'échelle: à 2, chaque
// invocation lit quatre fois plus, mais il y a quatre fois moins d'invocations.
// C'est pour ça que le demi-format coûte du temps d'encodage et presque pas de
// temps de conversion.
vec3 source_at(ivec2 target_pixel)
{
    const ivec2 base = target_pixel * SCALE;
    vec3 sum = vec3(0.0);
    for (int y = 0; y < SCALE; ++y)
        for (int x = 0; x < SCALE; ++x)
            sum += texelFetch(source, base + ivec2(x, y), 0).rgb;
    return sum / float(SCALE * SCALE);
}

const vec3 K = vec3(0.2126, 0.7152, 0.0722);  // BT.709 luma weights

float luma_of(vec3 rgb)
{
    // 16..235 rather than 0..255: limited range.
    return (16.0 + 219.0 * dot(rgb, K)) / 255.0;
}

void main()
{
    const ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x >= push.chroma_size.x || c.y >= push.chroma_size.y)
        return;

    const ivec2 p = c * 2;
    const vec3 s00 = source_at(p + ivec2(0, 0));
    const vec3 s10 = source_at(p + ivec2(1, 0));
    const vec3 s01 = source_at(p + ivec2(0, 1));
    const vec3 s11 = source_at(p + ivec2(1, 1));

    imageStore(luma, p + ivec2(0, 0), vec4(luma_of(s00)));
    imageStore(luma, p + ivec2(1, 0), vec4(luma_of(s10)));
    imageStore(luma, p + ivec2(0, 1), vec4(luma_of(s01)));
    imageStore(luma, p + ivec2(1, 1), vec4(luma_of(s11)));

    // Average the block in LINEAR RGB before converting, which is what the
    // 4:2:0 subsampling actually means. Averaging the chroma values afterwards
    // gives a different, slightly wrong answer.
    const vec3 avg = (s00 + s10 + s01 + s11) * 0.25;
    const float y = dot(avg, K);
    const float cb = (128.0 + 224.0 * ((avg.b - y) / 1.8556)) / 255.0;
    const float cr = (128.0 + 224.0 * ((avg.r - y) / 1.5748)) / 255.0;

    imageStore(chroma, c, vec4(cb, cr, 0.0, 0.0));
}
