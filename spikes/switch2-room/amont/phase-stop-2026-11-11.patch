+"""Private phase teardown. Linux pidfds are required; never fall back to kill(pid)."""
+from contextlib import ExitStack, contextmanager
+from pathlib import Path
+import fcntl
+import json
+import os
+import select
+import signal
+import sys
+import time
+
+
+def stamp():
+    return time.monotonic_ns()
+
+
+def save(path, data):
+    temporary = path.with_name(path.name + f'.{os.getpid()}.tmp')
+    temporary.write_text(json.dumps(data, indent=2) + '\n')
+    temporary.replace(path)
+
+
+def identity(pid):
+    try:
+        raw = Path(f'/proc/{int(pid)}/stat').read_text()
+    except FileNotFoundError:
+        return None
+    fields = raw[raw.rfind(')') + 2:].split()
+    return {'pid': int(pid), 'start_ticks': fields[19], 'state': fields[0],
+            'ppid': int(fields[1])}
+
+
+def key(value):
+    return (int(value['pid']), str(value['start_ticks']))
+
+
+def valid_meta(meta):
+    root = Path(meta['root'])
+    if (root.parent != Path.home() / '.local/state/nel3ab'
+            or not root.name.startswith('test-switch2-') or root.is_symlink()
+            or root.resolve() != root):
+        raise ValueError('Not an owned disposable root')
+    if meta['session'] != str(root / 'session') or meta['state'] != str(root / 'state'):
+        raise ValueError('Room paths do not match root')
+    if int(meta['driver_pid']) <= 1 or not str(meta['driver_start_ticks']).isdigit():
+        raise ValueError('Invalid driver identity')
+    return root
+
+
+@contextmanager
+def phase_lock(root):
+    with (root / 'phase-stop.lock').open('a') as handle:
+        fcntl.flock(handle, fcntl.LOCK_EX)
+        yield
+
+
+class Process:
+    """Bind a verified start time to one kernel process before any signal."""
+    def __init__(self, expected):
+        if not hasattr(os, 'pidfd_open') or not hasattr(signal, 'pidfd_send_signal'):
+            raise RuntimeError('pidfds unavailable; refuse PID-based signals')
+        self.expected = expected
+        self.fd = None
+        before = identity(expected['pid'])
+        if before is None:
+            return
+        if key(before) != key(expected):
+            raise ValueError('PID identity changed; no signal sent')
+        try:
+            self.fd = os.pidfd_open(expected['pid'])
+            after = identity(expected['pid'])
+            if after is not None and key(after) != key(expected):
+                raise ValueError('PID reused while opening pidfd; no signal sent')
+        except ProcessLookupError:
+            self.close()
+        except BaseException:
+            self.close()
+            raise
+
+    def close(self):
+        if self.fd is not None:
+            os.close(self.fd)
+            self.fd = None
+
+    def exited(self):
+        if self.fd is None:
+            return True
+        poll = select.poll()
+        poll.register(self.fd, select.POLLIN)
+        return bool(poll.poll(0))
+
+    def send(self, number):
+        if not self.exited():
+            try:
+                signal.pidfd_send_signal(self.fd, number)
+            except ProcessLookupError:
+                pass  # This pinned process exited between poll and send; its PID is never used.
+
+    def wait(self, seconds):
+        if self.fd is None:
+            return True
+        poll = select.poll()
+        poll.register(self.fd, select.POLLIN)
+        return bool(poll.poll(max(0, int(seconds * 1000))))
+
+
+def _read(path):
+    return json.loads(path.read_text())
+
+
+def owned_pad_inventory(meta, names=None):
+    """Remember adapter tokens under this session before its tempdirs disappear."""
+    root = valid_meta(meta)
+    target = root / 'owned-pad-inventory.json'
+    previous = _read(target) if target.exists() else {'tokens': [], 'names_seen': []}
+    tokens = set(previous['tokens'])
+    for directory in Path(meta['session']).glob('room-switch-*'):
+        if directory.is_dir() and not directory.is_symlink():
+            tokens.add(directory.name)
+    if names is None:
+        names = [p.read_text().strip() for p in Path('/sys/class/input').glob('event*/device/name')]
+    expected = {f'nel3ab {token} P{slot}' for token in tokens for slot in range(1, 5)}
+    result = {'tokens': sorted(tokens), 'names_seen': sorted(set(previous['names_seen']) | (set(names) & expected)),
+              'expected_names': sorted(expected), 'current_owned': sorted(set(names) & expected),
+              'observed_monotonic_ns': stamp()}
+    save(target, result)
+    return result
+
+
+def _stop_phase(meta, root, supervisor_script, grace):
+    """Called with the lifecycle lock held. Validate the whole pair before signaling."""
+    sup_path, child_path = root / 'phase-supervisor.json', root / 'phase-process.json'
+    if (root / 'phase-launch-once').exists():
+        deadline = time.monotonic() + grace
+        while not (sup_path.exists() and child_path.exists()):
+            if time.monotonic() >= deadline:
+                raise RuntimeError('Phase launch incomplete; no driver-close permission')
+            time.sleep(0.01)
+    if not sup_path.exists() and not child_path.exists():
+        save(root / 'phase-stop-intent.json', {'at_ns': stamp(), 'phase': 'not_launched'})
+        result = {'phase': 'not_launched', 'ordered': True, 'forced': False, 'at_ns': stamp()}
+        save(root / 'phase-stop-complete.json', result)
+        return result
+    sup, child = _read(sup_path), _read(child_path)
+    driver_key = (int(meta['driver_pid']), str(meta['driver_start_ticks']))
+    if (key(sup['identity']) != key(child['supervisor_identity'])
+            or sup['pid'] != sup['identity']['pid']
+            or child['supervisor_pid'] != sup['pid'] or child['pid'] != child['identity']['pid']
+            or child.get('supervisor_script') != str(supervisor_script)
+            or child.get('owner_root') != str(root)
+            or key(child['owner_driver_identity']) != driver_key):
+        raise ValueError('Foreign or inconsistent phase ownership; no signal sent')
+    with ExitStack() as stack:
+        supervisor, controller = Process(sup['identity']), None
+        stack.callback(supervisor.close)
+        controller = Process(child['identity'])
+        stack.callback(controller.close)
+        if not controller.exited():
+            current = identity(child['pid'])
+            if current is None or current['ppid'] != sup['pid'] or supervisor.exited():
+                raise ValueError('Controller is not the actual supervisor child; no signal sent')
+        # No finish marker or signal precedes validation of both pinned processes.
+        owned_pad_inventory(meta)
+        save(root / 'phase-stop-intent.json', {'at_ns': stamp(), 'supervisor': sup['identity'], 'controller': child['identity']})
+        supervisor.send(signal.SIGTERM)
+        forced = False
+        if not controller.wait(grace):
+            forced = True
+            controller.send(signal.SIGKILL)
+            if not controller.wait(3):
+                raise RuntimeError('Controller survived forced stop; driver remains open')
+        child_exit_observed = stamp()
+        if not supervisor.wait(grace):
+            forced = True
+            supervisor.send(signal.SIGKILL)
+            if not supervisor.wait(3):
+                raise RuntimeError('Supervisor survived forced stop; driver remains open')
+        receipt_path = root / 'phase-exit.json'
+        receipt = _read(receipt_path) if receipt_path.exists() else None
+        reaped = bool(receipt and key(receipt['child_identity']) == key(child['identity'])
+                      and key(receipt['supervisor_identity']) == key(sup['identity']))
+        result_path = root / 'browser-phase-result.json'
+        phase_result = _read(result_path) if result_path.exists() else None
+        neutral = bool(phase_result and (int(phase_result['pid']), str(phase_result['start_ticks'])) == key(child['identity'])
+                       and phase_result.get('neutral_delivered'))
+        result = {'phase': 'exited', 'ordered': reaped and not forced, 'forced': forced,
+                  'child_exit_observed_ns': child_exit_observed, 'supervisor_exit_observed_ns': stamp(),
+                  'child_reaped_receipt': reaped, 'neutral_reported': neutral,
+                  'controller': child['identity'], 'supervisor': sup['identity']}
+        save(root / 'phase-stop-complete.json', result)
+        return result
+
+
+def stop(meta, *, supervisor_script=None, close_driver=True, grace=6):
+    root = valid_meta(meta)
+    supervisor_script = Path(supervisor_script or Path(__file__).with_name('launch-phase.py')).resolve()
+    driver = Process({'pid': int(meta['driver_pid']), 'start_ticks': str(meta['driver_start_ticks'])})
+    try:
+        with phase_lock(root):
+            prior = root / 'driver-close-request.json'
+            if close_driver and prior.exists():
+                recorded = _read(prior)
+                if key(recorded['driver']) != key(driver.expected):
+                    raise ValueError('Existing close receipt belongs to a different driver')
+                return recorded['phase_stop']
+            result = _stop_phase(meta, root, supervisor_script, grace)
+            if close_driver:
+                save(root / 'driver-close-request.json', {'at_ns': stamp(), 'driver': driver.expected,
+                                                          'phase_stop': result})
+                (root / 'finish').write_text('Owned phase is stopped; close private driver\n')
+                driver.send(signal.SIGTERM)
+            return result
+    finally:
+        driver.close()
+
+
+def audit(meta, identities, names=None):
+    """Observe only recorded identities; an exited zombie is not a running process."""
+    survivors = []
+    for expected in identities:
+        with ExitStack() as stack:
+            # Reused numeric PIDs are foreign and must never be signaled or called owned.
+            actual = identity(expected['pid'])
+            if actual is None or key(actual) != key(expected):
+                continue
+            process = Process(expected)
+            stack.callback(process.close)
+            if not process.exited():
+                survivors.append(actual)
+    pads = owned_pad_inventory(meta, names)
+    return {'surviving_owned_processes': survivors, 'surviving_owned_pads': pads['current_owned'],
+            'pad_tokens': pads['tokens'], 'unrelated_processes_and_pads_not_required_absent': True}
+
+
+if __name__ == '__main__':
+    if len(sys.argv) != 3 or sys.argv[1] != '--phase-only':
+        raise SystemExit('usage: phase_stop.py --phase-only active-room.json')
+    print(json.dumps(stop(_read(Path(sys.argv[2])), close_driver=False,
+                          supervisor_script=Path(sys.argv[2]).resolve().parent / 'launch-phase.py')))
