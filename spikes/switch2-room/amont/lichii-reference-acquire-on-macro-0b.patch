+TEST_CASE("Reference acquire composes real immediate queries and semaphore mirrors",
+          "[buffer_ports][reference_composition][reference_mirror]") {
+    PayloadReadback::AcquireSession session{false};
+    auto& f = session.f;
+    REQUIRE(Access::ReadBackPages(*f.buffers.cache) == 0);
+    REQUIRE_FALSE(Tegra::Nx2MayBeGpuWritten(PayloadReadback::Fixture::Device, 4));
+    session.Release(PayloadReadback::Fixture::Address, 100);
+    const u64 direct_position = session.split.Position();
+    session.split.Drain();
+    REQUIRE(VideoCommon::ReferenceAcquireTest::Consumed() >= direct_position);
+    REQUIRE(f.Word() == 100);
+    REQUIRE(f.rasterizer.query_calls == 1);
+    REQUIRE(f.runtime.payload->frees == 1);
+    auto& shadow = Tegra::Nx2MirrorShadow::Get();
+    REQUIRE(shadow.Diverts(PayloadReadback::Fixture::Device));
+    session.Release(PayloadReadback::Fixture::Address + 0x1000, 5);
+    session.split.Drain();
+    REQUIRE(f.rasterizer.query_calls == 3); // Original second-page release plus its real mirror.
+    REQUIRE(f.runtime.payload->frees == 3);
+    REQUIRE(f.Word() == 100);
+    REQUIRE(shadow.Read(PayloadReadback::Fixture::Device, f.Word()) == 5);
+    REQUIRE(f.rasterizer.notes.empty());
+    REQUIRE(f.rasterizer.finishes == 0);
+    session.Run([&] { f.fences.Complete(); });
+    REQUIRE_FALSE(Tegra::Nx2MayBeGpuWritten(PayloadReadback::Fixture::Device, 4));
+    session.Acquire(PayloadReadback::AcquireSession::Alias + 0x40, 10);
+    REQUIRE(session.puller.HasPendingAcquire() == session.reference);
+    session.Release(PayloadReadback::Fixture::Address + 0x1000, 20);
+    session.split.Drain();
+    REQUIRE(shadow.Read(PayloadReadback::Fixture::Device, f.Word()) == 20);
+    REQUIRE(session.puller.ResumeAcquire(session.pusher));
+    REQUIRE_FALSE(session.puller.HasPendingAcquire());
+    REQUIRE(f.runtime.payload->frees == 5);
+}
